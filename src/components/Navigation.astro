---
// Primary navigation. Small screens: collapses behind a Menu button.
// Items with children render as a native <details> disclosure (works without
// JavaScript). Without JS the list is simply always visible. The website phone
// number is the last item, as on the live site. On desktop the website number
// shows as two right-aligned lines ("Speak with a licensed agent" over a phone
// icon and the number; Randy, V2.0). Pages with their own number (/roku/)
// and the mobile menu keep the plain number.
import { site } from '@/config/site';
import { PAGE_PHONES, type PagePhoneKey } from '@/config/phones';

const { phone = 'default' } = Astro.props as { phone?: PagePhoneKey };
const pagePhone = PAGE_PHONES[phone];

const current = Astro.url.pathname;
const items = site.primaryNav;
const isCurrent = (href: string) => href !== '#' && (href === current || (href !== '/' && current.startsWith(href)));
---

{
  items.length > 0 && (
    <nav class="nav" aria-label="Primary">
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="primary-nav-list" hidden>
        <span class="nav__toggle-bar" aria-hidden="true" />
        <span>Menu</span>
      </button>
      <ul id="primary-nav-list" class="nav__list">
        {items.map((item) => (
          <li>
            {item.children?.length ? (
              <details class="nav__group">
                <summary>{item.label}</summary>
                <ul class="nav__sub">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
        {site.phoneDisplay && (
          <li class="nav__phone">
            {phone === 'default' ? (
              <a href={pagePhone.href} class="nav__phone-link">
                <span class="nav__phone-intro">Speak with a licensed agent</span>{" "}
                <span class="nav__phone-number">
                  <svg class="nav__phone-icon" aria-hidden="true" width="10" height="10" viewBox="1.5 1.5 21 21" fill="currentColor">
                    <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" />
                  </svg>
                  <span class="nav__phone-digits">{pagePhone.display}</span>
                </span>
              </a>
            ) : (
              <a href={pagePhone.href}>{pagePhone.display}</a>
            )}
          </li>
        )}
      </ul>
    </nav>
  )
}

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const list = document.getElementById('primary-nav-list');
  if (toggle && list) {
    toggle.hidden = false;
    list.dataset.collapsible = 'true';
    toggle.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLDetailsElement>('.nav__group[open]').forEach((d) => (d.open = false));
      if (toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
    // Close an open dropdown when clicking elsewhere.
    document.addEventListener('click', (e) => {
      document.querySelectorAll<HTMLDetailsElement>('.nav__group[open]').forEach((d) => {
        if (!d.contains(e.target as Node)) d.open = false;
      });
    });
  }
</script>

<style>
  .nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-3);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font: inherit;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
  }
  .nav__toggle[hidden] {
    display: none;
  }
  /* With JavaScript the menu starts collapsed (set before first paint via the
     .js class on <html>), so the page doesn't jump when this script runs. */
  :global(.js) .nav__toggle[hidden] {
    display: inline-flex;
  }
  :global(.js) .nav__list {
    display: none;
  }
  .nav__toggle-bar,
  .nav__toggle-bar::before,
  .nav__toggle-bar::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .nav__toggle-bar::before,
  .nav__toggle-bar::after {
    content: '';
    position: absolute;
  }
  .nav__toggle-bar::before {
    top: -6px;
  }
  .nav__toggle-bar::after {
    top: 6px;
  }

  .nav__list,
  .nav__sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__list[data-collapsible] {
    display: none;
  }
  .nav__toggle[aria-expanded='true'] + .nav__list {
    display: block;
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-4) var(--space-4);
  }
  .nav__list a,
  .nav__group summary {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .nav__group summary::after {
    content: '▾';
    margin-left: var(--space-1);
    font-size: 0.8em;
  }
  .nav__sub {
    padding-left: var(--space-4);
  }
  .nav__sub a {
    font-weight: 400;
  }
  .nav__list .nav__phone a {
    color: var(--color-accent);
    font-weight: 700;
  }
  /* Mobile menu: the plain number, as before. */
  .nav__phone-intro,
  .nav__phone-icon {
    display: none;
  }
  .nav__list a:hover,
  .nav__list a[aria-current='page'] {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Desktop nav from 64rem: GET A QUOTE, RESOURCES, REVIEWS, ABOUT and the
     phone fit on one line beside the logo from there; narrower screens use
     the Menu button. */
  @media (min-width: 64rem) {
    .nav__toggle,
    .nav__toggle:not([hidden]),
    :global(.js) .nav__toggle[hidden] {
      display: none;
    }
    .nav__list,
    .nav__list[data-collapsible],
    :global(.js) .nav__list {
      display: flex;
      align-items: center;
      gap: var(--space-6);
      position: static;
      padding: 0;
      border: 0;
    }
    .nav__group {
      position: relative;
    }
    /* Two-line phone block: the icon and number centered under the intro
       line, about 2px apart, the block centered in the unchanged header. */
    .nav__list .nav__phone-link {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0;
      text-align: center;
      line-height: 1.15;
      color: #173f35;
    }
    .nav__phone-intro {
      display: block;
      font-size: 0.75rem;
      font-weight: 400;
      color: var(--color-text-muted);
    }
    .nav__phone-number {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.1;
      white-space: nowrap;
    }
    /* Small filled handset, smaller than the digits. */
    .nav__phone-icon {
      display: block;
      flex: none;
      color: #173f35;
    }
    /* Trim the number's line box to the digits (cap height to baseline) so
       the handset centers on the digits themselves in every font. */
    .nav__phone-digits {
      text-box: trim-both cap alphabetic;
    }
    .nav__group .nav__sub {
      position: absolute;
      right: 0;
      top: 100%;
      z-index: 50;
      /* As wide as the longest label (one line each), never over 22rem. */
      width: max-content;
      max-width: 22rem;
      padding: var(--space-2) var(--space-4);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
    }
  }
</style>
