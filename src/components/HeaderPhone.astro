---
// The upper-right header phone contact of the standalone landing pages
// (/facebook/, /free-quote/, /help/; Randy, V14.0): "Speak With a Licensed
// Agent" over the approved filled handset and the page's own number, right-
// aligned. The look is the approved /help/ header (V3.1/V3.2). The site
// header (Navigation.astro) uses the same label and icon in its own
// two-line nav block. `npm run verify` checks every built header.
import { HEADER_PHONE_ICON_PATH, HEADER_PHONE_LABEL, type PagePhone } from '@/config/phones';

// showLabel={false}: only the dedicated quote funnel (Randy, v3.6), whose
// header shows Secure Form above the number instead.
const { phone, showLabel = true } = Astro.props as { phone: PagePhone; showLabel?: boolean };
---

<a class="header-phone" href={phone.href} data-header-phone>
  {showLabel && <span class="header-phone__label">{HEADER_PHONE_LABEL}</span>}
  <span class="header-phone__number">
    <svg class="header-phone__icon" aria-hidden="true" width="10" height="10" viewBox="1.5 1.5 21 21" fill="currentColor">
      <path fill-rule="evenodd" d={HEADER_PHONE_ICON_PATH} clip-rule="evenodd" />
    </svg>
    <span class="header-phone__digits">{phone.display}</span>
  </span>
</a>

<style>
  .header-phone {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    min-height: var(--tap-target);
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-primary);
    text-decoration: none;
  }
  /* Wraps onto two balanced, right-aligned lines on narrow phones; one line
     from about 390px. */
  .header-phone__label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-align: right;
    text-wrap: balance;
  }
  /* The handset beside the number, at the site header's 10:16 icon-to-digits
     ratio, centered on the digits by trimming their line box to cap height
     and baseline. */
  .header-phone__number {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }
  .header-phone__icon {
    display: block;
    flex: none;
    width: 0.625em;
    height: 0.625em;
    color: #173f35;
  }
  .header-phone__digits {
    text-box: trim-both cap alphabetic;
  }
  @media (min-width: 48rem) {
    .header-phone {
      font-size: 1.5rem;
    }
  }
</style>
