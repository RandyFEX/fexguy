---
// The Male and Female choices of the quote funnel (Randy, Quote System v5.8):
// one source for the funnel's first screen (/free-quote/, buttons) and the
// article sidebar's Get Prices module (links to /free-quote/ that carry the
// choice). The illustrations are the funnel's inline drawings, updated
// (Randy, November 2026) to adults of about 60-65: gray hair, simple eyes and a
// gentle smile, same flat style, circles and proportions.
interface Props {
  /** 'button': the funnel's own step buttons; 'link': links into the funnel. */
  as: 'button' | 'link';
}
const { as } = Astro.props;
const people = [
  { value: 'male', label: 'Male' },
  { value: 'female', label: 'Female' },
] as const;
---

<div class="qf-people">
  {
    people.map((p) => {
      const art =
        p.value === 'male' ? (
          <svg viewBox="0 0 120 120" aria-hidden="true" class="qf-person__art">
            <circle cx="60" cy="60" r="58" fill="#e6ece9"/>
            <path d="M22 112c4-24 20-36 38-36s34 12 38 36" fill="#173f35"/><path d="M50 74h20l-10 14z" fill="#fff"/>
            <circle cx="60" cy="48" r="20" fill="#e5bf9e"/>
            <path d="M40.5 45c-0.5-13 8.5-20.5 19.5-20.5s20 7.5 19.5 20.5c-2-5.5-5-8.5-8.5-10c-3 2.2-7 3-11 3s-8-0.8-11-3c-3.5 1.5-6.5 4.5-8.5 10z" fill="#aeb2b5"/>
            <path d="M41 44.5c0.3-4 1.6-7.4 3.8-10.2c0.6 3.2 0.3 6.4-1.2 9.6z M79 44.5c-0.3-4-1.6-7.4-3.8-10.2c-0.6 3.2-0.3 6.4 1.2 9.6z" fill="#8f9498"/>
            <path d="M47 29.6c3.6-2.4 8.2-3.6 13-3.6c5 0 9.6 1.3 13.2 3.8c-3.8 0.8-8.4 1.2-13.2 1.2s-9.4-0.5-13-1.4z" fill="#c8cbcd"/>
            <path d="M50.5 44.2h5.5 M64 44.2h5.5" stroke="#9a9fa3" stroke-width="1.7" stroke-linecap="round"/>
            <circle cx="53.3" cy="48.3" r="1.5" fill="#3d3a36"/><circle cx="66.7" cy="48.3" r="1.5" fill="#3d3a36"/>
            <path d="M54.5 57c3.4 2.4 7.6 2.4 11 0" stroke="#a8664a" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            <path d="M48.6 53.4c0.8 1.4 1.8 2.4 3 3 M71.4 53.4c-0.8 1.4-1.8 2.4-3 3" stroke="#d0a283" stroke-width="1.1" fill="none" stroke-linecap="round"/>
          </svg>
        ) : (
          <svg viewBox="0 0 120 120" aria-hidden="true" class="qf-person__art">
            <circle cx="60" cy="60" r="58" fill="#e6ece9"/>
            <path d="M37 64c-5-9-5-22 0-31c5.5-9 14.5-13 23-13s17.5 4 23 13c5 9 5 22 0 31c-2 2.2-5 3-8 3H45c-3 0-6-0.8-8-3z" fill="#b7b2ab"/>
            <path d="M22 112c4-24 20-36 38-36s34 12 38 36" fill="#2f6b5a"/>
            <circle cx="60" cy="50" r="19" fill="#ecc8aa"/>
            <path d="M41 49c0.5-13 8.5-20.5 19-20.5s18.5 6.5 19 18.5c-5-6-10.5-9.5-18-10c-6.5 2.5-12.5 6.5-20 12z" fill="#c7c2bb"/>
            <path d="M77.6 33.4c3.6 4.6 5.6 10.6 5.8 17.6c0.2 5.2-0.8 9.8-2.6 13.6c-1.6-6.4-2.2-13-1.8-19.6c0.2-4.2-0.4-8-1.4-11.6z" fill="#9f988e"/><path d="M45 34.6c4.2-3.6 9.6-5.4 15.6-5.2c-4.6 1.6-9 4-12.6 7.4c-1.2-1-2.2-1.8-3-2.2z" fill="#dcd8d2"/>
            <path d="M50.5 45.6c1.6-0.9 3.6-1 5.2-0.2 M64.3 45.4c1.6-0.8 3.6-0.7 5.2 0.2" stroke="#8d847a" stroke-width="1.4" fill="none" stroke-linecap="round"/>
            <circle cx="53.3" cy="49.6" r="1.45" fill="#3d3a36"/><circle cx="66.7" cy="49.6" r="1.45" fill="#3d3a36"/>
            <path d="M55 57.6c3.1 2.2 6.9 2.2 10 0" stroke="#b5604f" stroke-width="1.6" fill="none" stroke-linecap="round"/>
            <path d="M49.6 54.6c0.7 1.2 1.6 2.1 2.7 2.6 M70.4 54.6c-0.7 1.2-1.6 2.1-2.7 2.6" stroke="#d6a98b" stroke-width="1" fill="none" stroke-linecap="round"/>
          </svg>
        );
      return as === 'button' ? (
        <button class="qf-person" type="button" data-pick="gender" data-value={p.value}>
          {art}
          <span class="qf-person__label">{p.label}</span>
        </button>
      ) : (
        <a class="qf-person" href={`/free-quote/?gender=${p.value}`} data-gp-gender={p.value}>
          {art}
          <span class="qf-person__label">{p.label}</span>
        </a>
      );
    })
  }
</div>

<style is:global>
  /* Moved unchanged from the funnel page (v5.8) so the sidebar shares them. */
  .qf-people { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); max-width: 30rem; margin-inline: auto; }
  .qf-person {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
    padding: var(--space-4) var(--space-2); border: 3px solid var(--color-border); border-radius: 0.75rem;
    background: #fff; cursor: pointer;
  }
  .qf-person[aria-pressed='true'] { border-color: var(--color-primary); background: #f3f7f5; }
  @media (hover: hover) { .qf-person:hover { border-color: var(--color-primary); background: #f3f7f5; } }
  .qf-person__art { width: min(8rem, 100%); height: auto; }
  .qf-person__label { font-size: 1.375rem; font-weight: 800; color: var(--color-primary); }
</style>
