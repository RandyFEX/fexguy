---
// The Male and Female choices of the quote funnel (Randy, Quote System v5.8):
// one source for the funnel's first screen (/free-quote/, buttons) and the
// article sidebar's Get Prices module (links to /free-quote/ that carry the
// choice). The illustrations follow the original modern flat icons (light
// circle, simple shapes; Randy, November 2026): larger heads, dark hair with
// subtle gray accents (about 55-65), warm skin, minimal eyes and smile, the
// original dark green and complementary green clothing.
interface Props {
  /** 'button': the funnel's own step buttons; 'link': links into the funnel. */
  as: 'button' | 'link';
}
const { as } = Astro.props;
const people = [
  { value: 'male', label: 'Male' },
  { value: 'female', label: 'Female' },
] as const;
---

<div class="qf-people">
  {
    people.map((p) => {
      const art =
        p.value === 'male' ? (
          <svg viewBox="0 0 120 120" aria-hidden="true" class="qf-person__art">
            <circle cx="60" cy="60" r="58" fill="#e6ece9"/>
            <path d="M20 114c4-25 20-38 40-38s36 13 40 38z" fill="#173f35"/>
            <path d="M49 76h22l-11 15z" fill="#fff"/>
            <circle cx="60" cy="47" r="23" fill="#e2ab83"/>
            <path d="M37 45c0-16 10-26 23-26s23 9 23 24c-6-7.5-14-10-23-10s-17 4-23 12z" fill="#3b3430"/>
            <path d="M37.2 44.5c0.3-5.2 1.9-9.8 4.7-13.2c1.1 4 0.9 8.4-0.9 13.2z M82.8 44.5c-0.3-5.2-1.9-9.8-4.7-13.2c-1.1 4-0.9 8.4 0.9 13.2z" fill="#a9a9a7"/>
            <path d="M50 23.6c3-1.4 6.4-2.2 10-2.2c-2.6 1-5 2.4-7 4z" fill="#8f8d8a"/>
            <circle cx="52.4" cy="48.5" r="2" fill="#2b2420"/><circle cx="67.6" cy="48.5" r="2" fill="#2b2420"/>
            <path d="M55 57q5 3.4 10 0" stroke="#9a4a36" stroke-width="2" fill="none" stroke-linecap="round"/>
          </svg>
        ) : (
          <svg viewBox="0 0 120 120" aria-hidden="true" class="qf-person__art">
            <circle cx="60" cy="60" r="58" fill="#e6ece9"/>
            <path d="M35 72c-6.5-11-6.5-28 0-39c6.5-11 17-15.5 25-15.5s18.5 4.5 25 15.5c6.5 11 6.5 28 0 39z" fill="#4a362b"/>
            <path d="M76.5 30.5c4 4.6 6.8 10.8 7.6 18.4c0.6 6.6-0.2 12.6-2.4 17.8c-1.4-7.2-2-14.6-1.8-22c0.2-5-1.2-9.8-3.4-14.2z" fill="#9d9890"/>
            <path d="M20 114c4-25 20-38 40-38s36 13 40 38z" fill="#2f6b5a"/>
            <circle cx="60" cy="49" r="22" fill="#e6b089"/>
            <path d="M38 47c1-15.5 10.5-24.5 22-24.5s21 7.5 22 22c-7.5-6.4-12.6-10.6-22-10.6c-8.4 0-15.6 4.2-22 13.1z" fill="#4a362b"/>
            <path d="M66 23.6c5 1.4 9 4.4 12 8.6c-3.6-2.4-7.4-4-11.4-4.8z" fill="#a8a39b"/>
            <circle cx="52.6" cy="50.2" r="1.9" fill="#2b2420"/><circle cx="67.4" cy="50.2" r="1.9" fill="#2b2420"/>
            <path d="M55.4 58.4q4.6 3.2 9.2 0" stroke="#a8473c" stroke-width="1.9" fill="none" stroke-linecap="round"/>
          </svg>
        );
      return as === 'button' ? (
        <button class="qf-person" type="button" data-pick="gender" data-value={p.value}>
          {art}
          <span class="qf-person__label">{p.label}</span>
        </button>
      ) : (
        <a class="qf-person" href={`/free-quote/?gender=${p.value}`} data-gp-gender={p.value}>
          {art}
          <span class="qf-person__label">{p.label}</span>
        </a>
      );
    })
  }
</div>

<style is:global>
  /* Moved unchanged from the funnel page (v5.8) so the sidebar shares them. */
  .qf-people { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); max-width: 30rem; margin-inline: auto; }
  .qf-person {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
    padding: var(--space-4) var(--space-2); border: 3px solid var(--color-border); border-radius: 0.75rem;
    background: #fff; cursor: pointer;
  }
  .qf-person[aria-pressed='true'] { border-color: var(--color-primary); background: #f3f7f5; }
  @media (hover: hover) { .qf-person:hover { border-color: var(--color-primary); background: #f3f7f5; } }
  .qf-person__art { width: min(8rem, 100%); height: auto; }
  .qf-person__label { font-size: 1.375rem; font-weight: 800; color: var(--color-primary); }
</style>
