---
// The Male and Female choices of the quote funnel (Randy, Quote System v5.8):
// one source for the funnel's first screen (/free-quote/, buttons) and the
// article sidebar's Get Prices module (links to /free-quote/ that carry the
// choice). The illustrations are the funnel's inline drawings of adults of
// about 60-65 (Randy, November 2026): the person fills most of the circle
// (hair near the top, shoulders to the bottom edge), warm skin, gray hair with
// contrast, a visible neck and collar, and features bold enough for 110px.
interface Props {
  /** 'button': the funnel's own step buttons; 'link': links into the funnel. */
  as: 'button' | 'link';
}
const { as } = Astro.props;
const people = [
  { value: 'male', label: 'Male' },
  { value: 'female', label: 'Female' },
] as const;
---

<div class="qf-people">
  {
    people.map((p) => {
      const art =
        p.value === 'male' ? (
          <svg viewBox="0 0 120 120" aria-hidden="true" class="qf-person__art">
            <circle cx="60" cy="60" r="58" fill="#e6ece9"/>
            <path d="M8 120c2-22 20-36 52-36s50 14 52 36z" fill="#173f35"/>
            <path d="M50 60h20v20c-4 5-16 5-20 0z" fill="#c4865f"/>
            <path d="M46 82l14 15 14-15-5-4-9 8-9-8z" fill="#fff"/>
            <circle cx="35.5" cy="45" r="5.5" fill="#d39a73"/><circle cx="84.5" cy="45" r="5.5" fill="#d39a73"/>
            <ellipse cx="60" cy="43" rx="24.5" ry="27" fill="#dca57d"/>
            <path d="M35.5 41c-2-17 9-29 24.5-29s26.5 12 24.5 29c-2.6-7.4-7.6-12-14-13.6c-6.2 2.6-14.8 2.6-21 0c-6.4 1.6-11.4 6.2-14 13.6z" fill="#7e8388"/>
            <path d="M44 21.5c4.6-4 10-6 16-6s11.6 2 16 6c-5 1.2-10.4 1.8-16 1.8s-11-0.6-16-1.8z" fill="#aeb3b7"/>
            <path d="M36 41c0.4-4.6 1.8-8.6 4.2-11.8c0.6 4 0.2 8-1.4 11.8z M84 41c-0.4-4.6-1.8-8.6-4.2-11.8c-0.6 4-0.2 8 1.4 11.8z" fill="#b9bec1"/>
            <path d="M45.5 36.2q5.5-3.4 11 0 M63.5 36.2q5.5-3.4 11 0" stroke="#5c6166" stroke-width="2.8" fill="none" stroke-linecap="round"/>
            <circle cx="51" cy="43.5" r="2.7" fill="#2b2420"/><circle cx="69" cy="43.5" r="2.7" fill="#2b2420"/>
            <path d="M60.5 46.5c-1.6 4-1.8 6.4 1.6 7.4" stroke="#a8694a" stroke-width="2.2" fill="none" stroke-linecap="round"/>
            <path d="M52 57.4q8 6 16 0" stroke="#8a3b2b" stroke-width="2.6" fill="none" stroke-linecap="round"/>
            <path d="M43.6 52.6q0.8 4.4 4.4 6.6 M76.4 52.6q-0.8 4.4-4.4 6.6" stroke="#b97f5c" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          </svg>
        ) : (
          <svg viewBox="0 0 120 120" aria-hidden="true" class="qf-person__art">
            <circle cx="60" cy="60" r="58" fill="#e6ece9"/>
            <path d="M30 47c-2-22 11.5-37 30-37s32 15 30 37c-0.4 9-2.4 17-6 23H36c-3.6-6-5.6-14-6-23z" fill="#8f897f"/>
            <path d="M51 61h18v27q-9 6-18 0z" fill="#c78a64"/>
            <path d="M8 120c2-22 18-35 38-36q14 13 28 0c20 1 36 14 38 36z" fill="#2f6b5a"/>
            <ellipse cx="60" cy="44" rx="23" ry="26" fill="#e0a982"/>
            <path d="M37.2 46c-1.6-19 8.8-31 22.8-31s24 11.4 23 29c-5-10-13.6-16.4-25.6-16.6c-8 3.6-14.6 9.6-20.2 18.6z" fill="#aaa49b"/>
            <path d="M45.6 22.8c4.4-3.4 9.6-5 15.2-4.8c-5 1.8-9.6 4.6-13.2 8.6c-0.6-1.6-1.2-2.8-2-3.8z" fill="#cdc8c0"/>
            <path d="M46.2 37.6q5-3.2 10 0 M63.8 37.6q5-3.2 10 0" stroke="#6a625a" stroke-width="2.6" fill="none" stroke-linecap="round"/>
            <circle cx="51.4" cy="44.5" r="2.6" fill="#2b2420"/><circle cx="68.6" cy="44.5" r="2.6" fill="#2b2420"/>
            <path d="M60.4 47.4c-1.4 3.6-1.6 5.8 1.4 6.8" stroke="#ad6d4e" stroke-width="2.1" fill="none" stroke-linecap="round"/>
            <path d="M53 58q7 5.6 14 0" stroke="#9a3b33" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <path d="M45 53.4q0.8 4 4 6 M75 53.4q-0.8 4-4 6" stroke="#bd8461" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          </svg>
        );
      return as === 'button' ? (
        <button class="qf-person" type="button" data-pick="gender" data-value={p.value}>
          {art}
          <span class="qf-person__label">{p.label}</span>
        </button>
      ) : (
        <a class="qf-person" href={`/free-quote/?gender=${p.value}`} data-gp-gender={p.value}>
          {art}
          <span class="qf-person__label">{p.label}</span>
        </a>
      );
    })
  }
</div>

<style is:global>
  /* Moved unchanged from the funnel page (v5.8) so the sidebar shares them. */
  .qf-people { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); max-width: 30rem; margin-inline: auto; }
  .qf-person {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-2);
    padding: var(--space-4) var(--space-2); border: 3px solid var(--color-border); border-radius: 0.75rem;
    background: #fff; cursor: pointer;
  }
  .qf-person[aria-pressed='true'] { border-color: var(--color-primary); background: #f3f7f5; }
  @media (hover: hover) { .qf-person:hover { border-color: var(--color-primary); background: #f3f7f5; } }
  .qf-person__art { width: min(8rem, 100%); height: auto; }
  .qf-person__label { font-size: 1.375rem; font-weight: 800; color: var(--color-primary); }
</style>
