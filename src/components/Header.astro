---
// Site header: logo and primary navigation (copied from the live site).
// The live header's phone link and "GET RATES & INFO HERE" quote button are
// lead-generation elements and are intentionally not built yet.
import { site } from '@/config/site';
import Navigation from './Navigation.astro';
import type { PagePhoneKey } from '@/config/phones';

const { phone = 'default' } = Astro.props as { phone?: PagePhoneKey };

// The header shows the name-only Funeral Funds wordmark at every width (Randy,
// V5.2): sized copies from scripts/build-brand-assets.mjs, lossless WebP so
// the green stays exactly #173F35. The full two-line logo (site.logo) is
// still used by structured data and the landing pages.
const wordmark = '/images/logo/funeral-funds-wordmark';
const WORDMARK = { width: 1987, height: 285 };
const srcset = (base: string, widths: number[]) => widths.map((w) => `${base}-${w}.webp ${w}w`).join(', ');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${site.name} home`}>
      <picture>
        <img
          src={`${wordmark}-800.webp`}
          srcset={srcset(wordmark, [400, 800, 1200])}
          sizes="307px"
          alt={site.logo.alt}
          width={WORDMARK.width}
          height={WORDMARK.height}
          fetchpriority="high"
        />
      </picture>
    </a>
    <Navigation phone={phone} />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4rem;
    padding-block: var(--space-2);
  }
  /* The wordmark is sized by width: 44px tall (307px wide) wherever it fits,
     the largest that leaves breathing room inside the unchanged header
     height. It shrinks beside the Menu button on narrow phones; height
     follows the width so it keeps its proportions (1987 x 285). */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: var(--tap-target);
  }
  .site-header__brand picture {
    display: block;
    min-width: 0;
  }
  .site-header__brand img {
    width: calc(2.75rem * 1987 / 285);
    max-width: 100%;
    height: auto;
  }
</style>
