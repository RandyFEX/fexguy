---
// Site header: logo and primary navigation (copied from the live site).
// The live header's phone link and "GET RATES & INFO HERE" quote button are
// lead-generation elements and are intentionally not built yet.
import { site } from '@/config/site';
import Navigation from './Navigation.astro';
import type { PagePhoneKey } from '@/config/phones';

const { phone = 'default' } = Astro.props as { phone?: PagePhoneKey };

// Sized copies of the logos (scripts/build-brand-assets.mjs, lossless WebP so
// the green stays exactly #173F35). From 40rem the full two-line logo
// (site.logo, 44px tall, so the tagline stays legible); on phones the
// name-only wordmark (36px tall, narrower beside the Menu button). The
// <picture> media switch downloads only the one that is shown.
const full = '/images/logo/funeral-funds-logo';
const wordmark = '/images/logo/funeral-funds-wordmark';
const WORDMARK = { width: 1987, height: 285 };
const srcset = (base: string, widths: number[]) => widths.map((w) => `${base}-${w}.webp ${w}w`).join(', ');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${site.name} home`}>
      <picture>
        <source
          media="(min-width: 40rem)"
          srcset={srcset(full, [400, 800, 1200])}
          sizes="202px"
          width={site.logo.width}
          height={site.logo.height}
        />
        <img
          src={`${wordmark}-400.webp`}
          srcset={srcset(wordmark, [400, 800])}
          sizes="251px"
          alt={site.logo.alt}
          width={WORDMARK.width}
          height={WORDMARK.height}
          fetchpriority="high"
        />
      </picture>
    </a>
    <Navigation phone={phone} />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4rem;
    padding-block: var(--space-2);
  }
  /* The logo is sized by width (the wordmark 36px tall on phones; the full
     logo 44px tall from 40rem, inside the unchanged header height) and may
     shrink beside the Menu button on narrow phones; height follows the
     width so the logo keeps its proportions (wordmark 1987 x 285, full logo
     1986 x 433) instead of being squeezed. */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: var(--tap-target);
  }
  .site-header__brand picture {
    display: block;
    min-width: 0;
  }
  .site-header__brand img {
    width: calc(2.25rem * 1987 / 285);
    max-width: 100%;
    height: auto;
  }
  @media (min-width: 40rem) {
    .site-header__brand img {
      width: calc(2.75rem * 1986 / 433);
    }
  }
</style>
