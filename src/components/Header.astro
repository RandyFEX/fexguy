---
// Site header: logo and primary navigation (copied from the live site).
// The live header's phone link and "GET RATES & INFO HERE" quote button are
// lead-generation elements and are intentionally not built yet.
import { site } from '@/config/site';
import Navigation from './Navigation.astro';

// Optimized copies of site.logo (generated by scripts/optimize-logo.mjs):
// same image, resized to what the header displays (36–44px tall).
const optimized = '/images/logo/final-expense-guy-logo';
const widths = [400, 800, 1200];
const srcset = (ext: string) => widths.map((w) => `${optimized}-${w}.${ext} ${w}w`).join(', ');
const sizes = '(min-width: 56rem) 358px, 293px';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${site.name} home`}>
      <picture>
        <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
        <img
          src={`${optimized}-800.webp`}
          srcset={srcset('webp')}
          sizes={sizes}
          alt={site.logo.alt}
          width={site.logo.width}
          height={site.logo.height}
          fetchpriority="high"
        />
      </picture>
    </a>
    <Navigation />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4rem;
    padding-block: var(--space-2);
  }
  /* The logo is sized by width (36px tall, 44px from 56rem) and may shrink
     beside the Menu button on narrow phones; height follows the width so the
     wordmark keeps its proportions (2034 x 250) instead of being squeezed. */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: var(--tap-target);
  }
  .site-header__brand picture {
    display: block;
    min-width: 0;
  }
  .site-header__brand img {
    width: calc(2.25rem * 2034 / 250);
    max-width: 100%;
    height: auto;
  }
  @media (min-width: 56rem) {
    .site-header__brand img {
      width: calc(2.75rem * 2034 / 250);
    }
  }
</style>
