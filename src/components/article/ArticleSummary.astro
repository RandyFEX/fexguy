---
// The article's opening summary, one block in two parts with two jobs:
//  - Quick Answer: a short narrative answer (heritage green, the strongest
//    landmark on the page);
//  - Key Points: the article's own "Here's the Bottom Line" points,
//    unchanged (this heading is fixed here), as a scannable list.
// Both labels share one treatment (the Quick Answer label: gold accent,
// uppercase cream text, no colon); each point gets a white circle with a
// green check.
// The A–Z hubs answer no single question, so instead of a Quick Answer they
// get a guide summary (src/config/hub-nav.ts) in the same green treatment.
// Every key point gets the same typography; only the labels are uppercased.
interface Props {
  quickAnswer?: string;
  guide?: { label: string; text: string };
  takeaways?: { label: string; items: string[] };
}
import '@/styles/article-summary.css';

const { quickAnswer, guide, takeaways } = Astro.props;
---

{
  (quickAnswer || guide || takeaways) && (
    <div class="summary">
      {quickAnswer && (
        <section class="summary__answer" aria-labelledby="quick-answer-title">
          <h2 class="summary__label" id="quick-answer-title">
            Quick Answer
          </h2>
          <p class="summary__text">{quickAnswer}</p>
        </section>
      )}
      {guide && (
        <section class="summary__answer" aria-labelledby="guide-summary-title">
          <h2 class="summary__label" id="guide-summary-title">
            {guide.label}
          </h2>
          <p class="summary__text">{guide.text}</p>
        </section>
      )}
      {takeaways && (
        <section class="summary__points" aria-labelledby="bottom-line-title">
          <h2 class="summary__label" id="bottom-line-title">
            Key Points
          </h2>
          <ul class="summary__list" role="list">
            {takeaways.items.map((item) => (
              <li class="summary__item">
                <span class="summary__icon" aria-hidden="true"><svg focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
                <span set:html={item} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )
}
