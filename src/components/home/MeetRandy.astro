---
// "Meet Randy": an editorial split — the portrait (500 x 500 source, shown
// at up to 300px inside a thin stone ring) beside a short explanation of how Randy works. Copy uses
// only approved facts: independent broker, licensed in most states, compares
// multiple companies, no call center, you deal directly with Randy.
---

<section class="randy" aria-labelledby="meet-randy-title">
  <div class="container randy__grid">
    <div class="randy__photo-wrap">
      <img
        class="randy__photo"
        src="/wp-content/uploads/2025/11/RANDY-CIRCLE-IMAGE-SMALL.png"
        alt="Randy VanderVaate, the Final Expense Guy"
        width="500"
        height="500"
        loading="lazy"
        decoding="async"
      />
    </div>
    <h2 class="randy__title" id="meet-randy-title">Meet Randy</h2>
    <div class="randy__body">
      <p class="randy__lead">Final Expense Guy isn’t a call center. When you call, you deal directly with Randy.</p>
      <p>
        Randy is an independent life insurance broker, licensed in most states. Because he isn’t tied to one insurance
        company, he can compare options from multiple companies to help you find the right fit.
      </p>
      <p>You won’t be handed off from one representative to the next. You’ll talk with Randy.</p>
      <p class="randy__action">
        <a class="btn btn--secondary" href="/about/">ABOUT RANDY</a>
      </p>
    </div>
  </div>
</section>

<style>
  .randy {
    padding-block: var(--space-12);
    background: var(--color-bg);
  }
  /* Phones: a compact identity row (portrait beside the heading), then the
     copy and the button full width. */
  .randy__grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'photo title'
      'body body';
    column-gap: var(--space-4);
    row-gap: var(--space-6);
    align-items: center;
  }
  .randy__photo-wrap {
    grid-area: photo;
    width: 7.5rem;
    padding: 0.375rem;
    border-radius: 50%;
    background: var(--home-stone);
  }
  /* The portrait is clipped to its circle (the source has white corners and a
     soft white edge); the even stone ring around it defines the circle. */
  .randy__photo {
    width: 100%;
    height: auto;
    border-radius: 50%;
  }
  .randy__title {
    grid-area: title;
    margin: 0;
    font-size: clamp(1.625rem, 1.2rem + 1.5vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  /* Gold rule above the heading, left-aligned in this editorial section. */
  .randy__title::before {
    content: '';
    display: block;
    width: 3.5rem;
    height: 3px;
    margin-bottom: var(--space-4);
    background: var(--home-gold);
  }
  .randy__body {
    grid-area: body;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .randy__lead {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-primary);
    font-size: 1.3125rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-primary);
  }
  .randy__body p:not(.randy__lead) {
    color: var(--color-text);
    text-wrap: pretty;
  }
  .randy__action {
    margin: var(--space-6) 0 0;
  }

  /* Desktop: portrait in the first column of the 3-column grid used above,
     heading and copy across the other two. */
  @media (min-width: 64rem) {
    .randy {
      padding-block: 4.5rem;
    }
    .randy__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas:
        'photo title title'
        'photo body body';
      column-gap: var(--space-6);
      row-gap: var(--space-6);
      align-items: start;
    }
    .randy__photo-wrap {
      width: 20rem;
      padding: 0.625rem;
      align-self: center;
    }
    .randy__title {
      align-self: end;
    }
    .randy__body {
      max-width: 42rem;
      font-size: 1.1875rem;
    }
    .randy__lead {
      margin-bottom: var(--space-6);
      padding-left: var(--space-6);
      font-size: 1.625rem;
      line-height: 1.35;
    }
  }
</style>
