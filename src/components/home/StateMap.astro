---
// Homepage state map (V4.4-V4.10; moved below Meet Randy's ABOUT RANDY button
// in V4.11, Randy, November 2026): "Expected Final Expense Cost & Life
// Expectancy by State" and a simplified state map. Each state is a plain link
// that opens /funeral-cost-map/?state=XX in a new tab.
import paths from '@/data/funeral-map/state-paths.json';
import { ABBR_BY_FIPS } from '@/lib/funeral-map/state-abbr';
import labels from '@/data/funeral-map/state-labels.json';

// V4.5: postal abbreviations. Most sit inside their state; small states get an
// exterior label (lx, ly) with a thin leader line to a point inside the state.
// The viewBox is 25 units wider than the map paths (975) to fit the exterior
// column of small Northeastern states at phone label size.
type Label = { x: number; y: number; lx?: number; ly?: number };
const LABELS = labels as Record<string, Label>;
---

<section class="home-map" aria-labelledby="cover-map-title">
  <div class="container">
    <h2 class="home-map__title" id="cover-map-title">Research Costs By State &amp; Life Expectancy</h2>
    <div class="cover-map" data-home-map>
      <p class="home-map__hint">
        <span class="home-map__bubble"><span class="home-map__hover">Hover Over Any State for Information</span><span class="home-map__tap">Tap Any State for Information</span></span>
      </p>
      <svg viewBox="0 0 1000 610" role="group" aria-labelledby="cover-map-title">
        {paths.states.map((s) => (
          <a
            href={`/funeral-cost-map/?state=${ABBR_BY_FIPS[s.fips]}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${s.name}: funeral costs and mortality details (opens in a new tab)`}
            data-name={s.name}
          >
            <path d={s.d} />
          </a>
        ))}
        <g class="cover-map__labels" aria-hidden="true">
          {Object.entries(LABELS).map(([code, l]) =>
            l.lx != null && l.ly != null ? (
              <g>
                <line x1={l.x} y1={l.y} x2={l.lx < l.x ? l.lx + 4 : l.lx - 4} y2={l.ly} />
                <circle cx={l.x} cy={l.y} r="1.6" />
                <text x={l.lx} y={l.ly} text-anchor={l.lx > l.x + 20 ? 'start' : 'middle'} class="is-ext">{code}</text>
              </g>
            ) : (
              <text x={l.x} y={l.y}>{code}</text>
            ),
          )}
        </g>
      </svg>
      <p class="cover-map__tip" data-home-map-tip hidden></p>
    </div>
  </div>
</section>

<script>
  import '@/scripts/home-state-map';
</script>

<style>
  /* V4.13: about half of Meet Randy's bottom padding (2.5rem; 3.5rem from
     64rem) is taken back, halving the gap below ABOUT RANDY. */
  .home-map {
    padding-block: 0 var(--space-12);
    margin-top: -1.25rem;
  }
  @media (min-width: 64rem) {
    .home-map {
      margin-top: -1.75rem;
    }
  }
  /* Same heading style as the homepage section headings (CoverageNote). */
  .home-map__title {
    max-width: none;
    margin: 0 auto var(--space-4);
    text-align: center;
    font-size: clamp(1.625rem, 1.2rem + 1.5vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  /* V4.14/V4.15: the instruction bubble is anchored to the map container
     (.cover-map, which holds the SVG): centered, its bottom at 9.2% of the
     map's height, just above the northern border of North Dakota and
     Minnesota, so it moves and scales with the map. It never takes the
     pointer. Devices that can hover read "Hover Over Any State for
     Information"; touch devices read "Tap Any State for Information". */
  .home-map__hint {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 9.2%;
    margin: 0;
    transform: translate(-50%, calc(-100% - 8px));
    pointer-events: none;
  }
  /* Narrow phones: the bubble is wide relative to the map, so it sits a
     little higher to stay clear of Washington and Montana. */
  @media (max-width: 23.99rem) {
    .home-map__hint {
      top: 6%;
      /* No extra 8px lift here: it would touch the heading's last line. */
      transform: translate(-50%, -100%);
    }
  }
  .home-map__bubble {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--color-cta);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }
  .home-map__hover {
    display: none;
  }
  @media (hover: hover) {
    .home-map__hover {
      display: inline;
    }
    .home-map__tap {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    .home-map__bubble {
      padding: 0.1875rem 0.625rem;
      font-size: 0.8125rem;
    }
  }
  .cover-map {
    position: relative;
    max-width: 52rem;
    margin: 0 auto;
  }
  .cover-map svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .cover-map path {
    fill: #cfe0d7;
    stroke: #2b302d;
    stroke-width: 0.6;
    stroke-linejoin: round;
  }
  /* Hover/focus: the site's orange accent with a dark outline, clearly
     different from the light green fill of every state. */
  .cover-map a:hover path,
  .cover-map a:focus-visible path,
  .cover-map a.is-active path {
    fill: var(--color-cta);
    stroke: var(--color-cta);
    stroke-width: 2;
  }
  /* Labels never take the pointer, so hovering or clicking them reaches the state. */
  .cover-map__labels {
    pointer-events: none;
  }
  .cover-map__labels text {
    fill: #202522;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .cover-map__labels text.is-ext {
    font-size: 12px;
  }
  .cover-map__labels text[text-anchor='start'] {
    text-anchor: start;
  }
  .cover-map__labels line {
    stroke: #2b302d;
    stroke-width: 0.6;
  }
  .cover-map__labels circle {
    fill: #2b302d;
  }
  /* Phones: the map is about a third of its desktop size, so the labels are
     larger in map units to stay readable (about 8px). */
  @media (max-width: 47.99rem) {
    .cover-map__labels text,
    .cover-map__labels text.is-ext {
      font-size: 22px;
    }
  }
  .cover-map a:focus {
    outline: none;
  }
  .cover-map__tip {
    position: absolute;
    z-index: 1;
    margin: 0;
    padding: var(--space-1) var(--space-2);
    max-width: 14rem;
    background: var(--color-text);
    color: #ffffff;
    border-radius: var(--radius);
    font-size: 0.9375rem;
    line-height: 1.35;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 12px));
    white-space: nowrap;
  }
  .cover-map__tip :global(strong) {
    display: block;
  }
</style>
