---
// "What Does Final Expense Life Insurance Cover?": a short explanation on the
// white background between Why FEXGuy and the reviews (the "What I Help
// People With" section was removed in the V1.0 homepage cleanup, Randy,
// November 2026). Same heading scale as the other sections, no gold rule.
// V4.4 (Randy, November 2026): the same white section ends with the
// "Funeral Cost and Mortality Map by State" heading (same style as the first
// heading) and a simplified state map. Each state is a plain link that opens
// /funeral-cost-map/?state=XX in a new tab.
import { coverage } from '@/lib/home/content';
import paths from '@/data/funeral-map/state-paths.json';
import { ABBR_BY_FIPS } from '@/lib/funeral-map/state-abbr';
---

<section class="cover" aria-labelledby="cover-title">
  <div class="container">
    <h2 class="cover__title" id="cover-title">{coverage.title}</h2>
    <p class="cover__text">{coverage.text}</p>
    <h2 class="cover__title cover__title--map" id="cover-map-title">Funeral Cost and Mortality Map by State</h2>
    <div class="cover-map" data-home-map>
      <svg viewBox={paths.viewBox} role="group" aria-labelledby="cover-map-title">
        {paths.states.map((s) => (
          <a
            href={`/funeral-cost-map/?state=${ABBR_BY_FIPS[s.fips]}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${s.name}: funeral costs and mortality details (opens in a new tab)`}
            data-name={s.name}
          >
            <path d={s.d} />
          </a>
        ))}
      </svg>
      <p class="cover-map__tip" data-home-map-tip hidden></p>
    </div>
  </div>
</section>

<script>
  import '@/scripts/home-state-map';
</script>

<style>
  .cover {
    padding-block: var(--space-12);
  }
  .cover__title {
    max-width: none;
    margin: 0 auto var(--space-4);
    text-align: center;
    font-size: clamp(1.625rem, 1.2rem + 1.5vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .cover__title--map {
    margin-top: var(--space-12);
  }
  /* Phones: left-aligned, easier to read over several lines; centered under
     the heading once the line is long enough. */
  .cover__text {
    max-width: 46rem;
    margin: 0 auto;
    text-wrap: pretty;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  @media (min-width: 40rem) {
    .cover__text {
      text-align: center;
    }
  }
  .cover-map {
    position: relative;
    max-width: 52rem;
    margin: 0 auto;
  }
  .cover-map svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .cover-map path {
    fill: #cfe0d7;
    stroke: #ffffff;
    stroke-width: 1;
    stroke-linejoin: round;
  }
  /* Hover/focus: the site's orange accent with a dark outline, clearly
     different from the light green fill of every state. */
  .cover-map a:hover path,
  .cover-map a:focus-visible path,
  .cover-map a.is-active path {
    fill: var(--color-cta);
    stroke: var(--color-text);
    stroke-width: 1.5;
  }
  .cover-map a:focus {
    outline: none;
  }
  .cover-map__tip {
    position: absolute;
    z-index: 1;
    margin: 0;
    padding: var(--space-1) var(--space-2);
    max-width: 14rem;
    background: var(--color-text);
    color: #ffffff;
    border-radius: var(--radius);
    font-size: 0.9375rem;
    line-height: 1.35;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 12px));
    white-space: nowrap;
  }
  .cover-map__tip :global(strong) {
    display: block;
  }
</style>
