---
// Hero rate examples: one example at a time, shown like part of the ad —
// a person (photo slot; a neutral placeholder until real photos are chosen),
// the product, the coverage amount, the monthly premium and the insurance
// company. Not testimonials: no names, ages, genders or stories. The data are
// mockup placeholders (see rateExamples in src/lib/home/content.ts).
//
// Every example is in the HTML and they share one grid cell, so the card
// keeps the height of the tallest and nothing shifts when they change.
// Without JavaScript the first example simply stays visible. With it, the
// examples change every 7 seconds, pausing while the pointer or keyboard
// focus is on the card or the tab is hidden. One small Pause/Play button is
// the visible control: WCAG 2.2.2 requires a way to pause content that changes
// on its own, and hover/focus pausing alone doesn't cover touch screens. With
// prefers-reduced-motion nothing changes until the visitor presses Play.
import HomeIcon from './HomeIcon.astro';
import { rateExamples } from '@/lib/home/content';
---

<div class="rate" data-rate data-interval="7000" role="group" aria-label="Rate examples" data-pagefind-ignore>
  {/* Automatic changes are not announced (aria-live off); only the shown
     example is exposed to screen readers. */}
  <ul class="rate__list" role="list" aria-live="off">
    {
      rateExamples.map((r, i) => (
        <li class:list={['rate__item', { 'is-active': i === 0 }]}>
          <div class="rate__photo">
            {r.image ? (
              <img src={r.image.src} alt={r.image.alt} width="240" height="320" loading="lazy" decoding="async" />
            ) : (
              <span class="rate__placeholder" aria-hidden="true">
                <HomeIcon name="person" size={44} />
              </span>
            )}
          </div>
          <div class="rate__body">
            <p class="rate__label">Rate example</p>
            <p class="rate__product">{r.product}</p>
            <p class="rate__coverage">{r.coverage} Coverage</p>
            <p class="rate__premium">
              {r.premium}
              <wbr /><span class="rate__per">/month</span>
            </p>
            <p class="rate__company">{r.company}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <button class="rate__toggle" type="button" data-rate-toggle aria-label="Pause rate examples" hidden>
    <svg class="rate__icon-pause" aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4h4v16H6zM14 4h4v16h-4z" /></svg>
    <svg class="rate__icon-play" aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4v16l13-8z" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rate]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.rate__item'));
    const toggle = root.querySelector<HTMLButtonElement>('[data-rate-toggle]');
    if (items.length < 2 || !toggle) return;

    const interval = Number(root.dataset.interval) || 7000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let playing = !reduced.matches;
    let held = false; // pointer or keyboard focus on the card
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (i: number) => {
      items[index].classList.remove('is-active');
      index = (i + items.length) % items.length;
      items[index].classList.add('is-active');
    };
    const run = () => {
      clearInterval(timer);
      timer = undefined;
      if (playing && !held && !document.hidden) timer = setInterval(() => show(index + 1), interval);
    };
    const setPlaying = (on: boolean) => {
      playing = on;
      root.classList.toggle('is-paused', !on);
      toggle.setAttribute('aria-label', on ? 'Pause rate examples' : 'Play rate examples');
      run();
    };

    toggle.hidden = false;
    setPlaying(playing);

    toggle.addEventListener('click', () => setPlaying(!playing));
    root.addEventListener('pointerenter', () => ((held = true), run()));
    root.addEventListener('pointerleave', () => ((held = false), run()));
    root.addEventListener('focusin', () => ((held = true), run()));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) (held = false), run();
    });
    document.addEventListener('visibilitychange', run);
    reduced.addEventListener('change', () => setPlaying(!reduced.matches && playing));
  });
</script>

<style>
  .rate {
    --color-focus: var(--color-text);
    --color-focus-inner: #ffffff;
    position: relative;
    width: 100%;
    background: #ffffff;
    border-radius: var(--home-radius);
    color: var(--color-text);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  /* All examples share one grid cell; only the active one is shown. */
  .rate__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .rate__item {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    transition:
      opacity 0.5s ease,
      visibility 0.5s;
  }
  .rate__item:not(.is-active) {
    visibility: hidden;
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .rate__item {
      transition: none;
    }
  }

  /* Person photo: a full-height portrait panel on the card's left edge
     (real photos: about 240 x 320, cropped to fill). */
  .rate__photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--home-radius) 0 0 var(--home-radius);
    background: var(--home-stone);
  }
  .rate__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rate__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }

  /* Room for the corner Pause button is kept beside the label only. */
  .rate__body {
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-4);
  }
  .rate__body p {
    margin: 0;
  }
  .rate__label {
    padding-right: var(--space-8);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .rate__product {
    margin-top: var(--space-1) !important;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .rate__coverage {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
  }
  .rate__premium {
    margin-top: var(--space-1) !important;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .rate__per {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }
  .rate__company {
    margin-top: var(--space-1) !important;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  /* The one control: a small, quiet Pause/Play button in the corner (a full
     44px target; the visible icon is small). */
  .rate__toggle {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-target);
    height: var(--tap-target);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .rate__toggle[hidden] {
    display: none;
  }
  .rate__toggle:hover {
    background: var(--home-cream);
    color: var(--color-primary);
  }
  .rate__icon-play,
  .rate.is-paused .rate__icon-pause {
    display: none;
  }
  .rate.is-paused .rate__icon-play {
    display: block;
  }

  /* Narrow phones: a slimmer photo and less padding. */
  @media (max-width: 24.99rem) {
    .rate__item {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
    .rate__body {
      padding-right: var(--space-3);
    }
  }
  /* Very narrow phones (320px): a smaller photo and premium. */
  @media (max-width: 22rem) {
    .rate__item {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }
    .rate__product {
      letter-spacing: 0.01em;
    }
    .rate__premium {
      font-size: 1.75rem;
    }
  }
  @media (min-width: 48rem) {
    .rate__item {
      grid-template-columns: 8rem minmax(0, 1fr);
    }
    .rate__body {
      padding: var(--space-6);
    }
    .rate__premium {
      font-size: 2.25rem;
    }
  }
</style>
