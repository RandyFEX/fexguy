---
// "Check Out Our Regret-Free Pricing Program" (Randy, November 2026, V9):
// four numbered steps with icons; replaces Meet Randy on the homepage only
// (/facebook/ keeps Meet Randy). Four columns from 64rem, two from 40rem,
// one on phones. White background and the same padding as Meet Randy, so the
// state map that follows keeps its spacing.
import HomeIcon from './HomeIcon.astro';
import { regretFree } from '@/lib/home/content';
---

<section class="rf" aria-labelledby="rf-title">
  <div class="container">
    <h2 class="rf__title" id="rf-title">{regretFree.title}</h2>
    <ol class="rf__list" role="list">
      {
        regretFree.steps.map((s, i) => (
          <li class="rf__item">
            <span class="rf__icon">
              <HomeIcon name={s.icon} size={32} />
            </span>
            <h3 class="rf__name">
              <span class="rf__num">{i + 1}</span>
              <span>{s.title}</span>
            </h3>
            <p class="rf__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .rf {
    padding-block: 2.5rem;
    background: var(--color-bg);
  }
  .rf__title {
    max-width: none;
    margin: 0 auto var(--space-8);
    text-align: center;
    font-size: clamp(1.625rem, 1.2rem + 1.5vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .rf__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }
  .rf__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .rf__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    background: var(--color-primary);
    color: #ffffff;
  }
  /* The number sits inline before the first word, so it stays with the
     heading when the heading wraps. */
  .rf__name {
    min-height: 2.5em;
    text-wrap: balance;
    margin: 0 0 var(--space-2);
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .rf__num {
    display: inline-flex;
    vertical-align: 0.125em;
    margin-right: var(--space-2);
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--home-gold, #b68a35);
    color: #000000;
    font-size: 0.9375rem;
    line-height: 1;
  }
  .rf__text {
    max-width: 24rem;
    margin: 0;
    text-wrap: pretty;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  @media (min-width: 40rem) {
    .rf__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-6);
    }
    .rf__icon {
      width: 4rem;
      height: 4rem;
    }
  }
  @media (min-width: 64rem) {
    .rf {
      padding-block: 3.5rem;
    }
    .rf__title {
      margin-bottom: var(--space-12);
    }
    .rf__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .rf__name {
      font-size: 1.25rem;
    }
    .rf__text {
      font-size: 1.0625rem;
    }
  }
</style>
