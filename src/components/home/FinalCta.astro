---
// Closing call to action (heritage-green band) just above the footer: the
// headline, copy and CALL button in one centered column (Randy, homepage
// v1.5: the old lead form on the right was removed and the band shortened;
// the hero's GET PRICING HERE opens the /free-quote/ funnel).
import { lead } from '@/config/lead';
---

<section class="final-cta" aria-labelledby="final-cta-title" data-pagefind-ignore>
  <div class="container final-cta__inner">
    <h2 class="final-cta__title" id="final-cta-title">Not Sure What Type of Life Insurance You Need?</h2>
    <p class="final-cta__text">Randy can help you compare your options.</p>
    <a class="btn final-cta__btn final-cta__btn--cta" href={lead.phone.href}>CALL {lead.phone.display}</a>
  </div>
</section>

<style>
  .final-cta {
    /* The two-tone focus ring flips on the dark band so it stays visible. */
    --color-focus: #ffffff;
    --color-focus-inner: var(--color-text);
    padding-block: var(--space-8);
    background: var(--color-primary);
    color: #ffffff;
  }
  /* One centered column at every size; the CALL button is full width on
     phones and its natural width from 30rem. */
  .final-cta__inner {
    max-width: 44rem;
    text-align: center;
  }
  .final-cta__title {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    color: #ffffff;
    text-wrap: balance;
  }
  .final-cta__text {
    margin: 0 auto var(--space-6);
    text-wrap: balance;
    max-width: 36rem;
    font-size: 1.125rem;
  }
  .final-cta__btn {
    width: 100%;
  }
  .final-cta__btn--cta {
    background: var(--color-cta);
    color: var(--color-on-cta);
  }
  .final-cta__btn--cta:hover {
    background: var(--color-cta);
    color: var(--color-on-cta);
    filter: brightness(0.9);
  }
  @media (min-width: 30rem) {
    .final-cta__btn {
      width: auto;
      white-space: nowrap;
    }
  }
</style>
