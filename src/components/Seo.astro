---
// Emits <title>, meta description, robots, canonical, social meta and JSON-LD.
//
// Migrated pages pass their exact live values (headMeta, jsonLd). Pages
// without them get generated Open Graph/Twitter tags. Robots is always
// "noindex, nofollow" unless PUBLIC_ALLOW_INDEXING=true (see .env.example).
import { site, allowIndexing } from '@/config/site';

export interface HeadMeta {
  property?: string;
  name?: string;
  content: string;
}

export interface Props {
  title: string;
  description?: string;
  /** Exact robots directive for when indexing is enabled. */
  robots?: string;
  noindex?: boolean;
  /** Canonical path or absolute URL; defaults to the current URL. */
  canonical?: string;
  /** Social meta tags emitted as-is (replaces generated OG/Twitter tags). */
  headMeta?: HeadMeta[];
  /** Raw JSON-LD strings emitted verbatim. */
  jsonLd?: string[];
}

const { title, description, robots, noindex = false, canonical, headMeta = [], jsonLd = [] } = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).toString();
const robotsContent = !allowIndexing ? 'noindex, nofollow' : robots || (noindex ? 'noindex, nofollow' : 'index, follow');
const ogImage = site.defaultOgImage ? new URL(site.defaultOgImage, Astro.site).toString() : undefined;
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={robotsContent} />
{!noindex && <link rel="canonical" href={canonicalUrl} />}

{
  headMeta.length > 0 ? (
    headMeta.map((m) => (m.property ? <meta property={m.property} content={m.content} /> : <meta name={m.name} content={m.content} />))
  ) : (
    <>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content={site.name} />
      <meta property="og:locale" content={site.locale} />
      <meta property="og:title" content={title} />
      {description && <meta property="og:description" content={description} />}
      <meta property="og:url" content={canonicalUrl} />
      {ogImage && <meta property="og:image" content={ogImage} />}
      <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
      <meta name="twitter:title" content={title} />
      {description && <meta name="twitter:description" content={description} />}
    </>
  )
}

{jsonLd.map((block) => <script type="application/ld+json" is:inline set:html={block} />)}
