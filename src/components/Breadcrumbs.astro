---
// Visible breadcrumb trail plus matching BreadcrumbList structured data.
import { breadcrumbSchema, type Crumb } from '@/lib/seo/schema';

export interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const schema = breadcrumbSchema(crumbs);
---

{
  crumbs.length > 1 && (
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol>
        {crumbs.map((crumb, i) => (
          <li>{i === crumbs.length - 1 ? <span aria-current="page">{crumb.name}</span> : <a href={crumb.path}>{crumb.name}</a>}</li>
        ))}
      </ol>
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    </nav>
  )
}

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: var(--space-2);
    color: var(--color-border);
  }
  .breadcrumbs a {
    color: inherit;
  }
</style>
