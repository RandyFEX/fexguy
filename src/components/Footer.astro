---
// Site footer: contact details, legal links, social links, and disclaimers,
// copied from the live site (see site.footer in src/config/site.ts).
import { site } from '@/config/site';
const { columns, social, notes } = site.footer;
---

<footer class="site-footer">
  <div class="container">
    {
      columns.length > 0 && (
        <div class="site-footer__cols">
          {columns.map((html) => (
            <div class="site-footer__col" set:html={html} />
          ))}
        </div>
      )
    }
    {
      social.length > 0 && (
        <ul class="site-footer__social" aria-label="Social media">
          {social.map((s) => (
            <li>
              <a href={s.href} rel="noopener nofollow" target="_blank">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {notes.length > 0 && <div class="site-footer__notes">{notes.map((html) => <p set:html={html} />)}</div>}
    {/* Site search (as on the live site, the footer's last element). Plain
       HTML: submits to /search/?q=… with no JavaScript on this page. */}
    <form class="site-footer__search" role="search" action="/search/" method="get">
      <label for="footer-search">Search</label>
      <div class="site-footer__search-row">
        <input id="footer-search" type="search" name="q" required autocomplete="off" />
        <button class="btn btn--primary" type="submit">Search</button>
      </div>
    </form>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: var(--space-8);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .site-footer__cols {
    display: grid;
    gap: var(--space-4) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .site-footer__cols :global(p) {
    margin: 0;
  }
  .site-footer :global(a) {
    color: inherit;
  }
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }
  .site-footer__search {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    max-width: 32rem;
  }
  .site-footer__search label {
    display: block;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }
  .site-footer__search-row {
    display: flex;
    gap: var(--space-2);
  }
  .site-footer__search input {
    flex: 1;
    min-width: 0;
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius);
    background: var(--color-bg);
    font: inherit;
    color: var(--color-text);
  }
  .site-footer__notes {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    font-size: 0.875rem;
  }
</style>
