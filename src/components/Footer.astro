---
// Site footer: contact details, legal links, social links, and disclaimers,
// copied from the live site (see site.footer in src/config/site.ts).
import { site } from '@/config/site';
const { columns, social, notes } = site.footer;
---

<footer class="site-footer">
  <div class="container">
    {
      columns.length > 0 && (
        <div class="site-footer__cols">
          {columns.map((html) => (
            <div class="site-footer__col" set:html={html} />
          ))}
        </div>
      )
    }
    {
      social.length > 0 && (
        <ul class="site-footer__social" aria-label="Social media">
          {social.map((s) => (
            <li>
              <a href={s.href} rel="noopener nofollow" target="_blank">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {notes.length > 0 && <div class="site-footer__notes">{notes.map((html) => <p set:html={html} />)}</div>}
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: var(--space-8);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .site-footer__cols {
    display: grid;
    gap: var(--space-4) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .site-footer__cols :global(p) {
    margin: 0;
  }
  .site-footer :global(a) {
    color: inherit;
  }
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }
  .site-footer__notes {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    font-size: 0.875rem;
  }
</style>
