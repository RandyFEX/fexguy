const established = operators.filter((o) => o.status !== 'unverified');
const unverified = operators.filter((o) => o.status === 'unverified');
const quickAnswer =
  'Yes, on many major cruise lines, but only with the line’s permission and on its terms. Carnival, Royal Caribbean, Princess, MSC, Virgin Voyages, P&O Cruises, Cunard, Fred. Olsen and Marella publish a written process. Ambassador says it may be possible case by case, and Crystal does not offer it from the ship. Norwegian, Celebrity, Holland America, Disney, Viking and most smaller lines publish no policy we could find, so ask them in writing before you book. Plan on a biodegradable urn, copies of the death and cremation certificates, permission arranged before or at the start of the cruise, and a ceremony at least 12 nautical miles offshore.';
