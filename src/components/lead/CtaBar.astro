---
// Static call-to-action bar under the site header (replaces the live site's
// header CTA, which opened a pop-up form). Copy is from the live site.
import { lead } from '@/config/lead';
---

<section class="cta-bar" aria-labelledby="cta-bar-title">
  <div class="container cta-bar__inner">
    <p class="cta-bar__title" id="cta-bar-title">UNBEATABLE PROTECTION!</p>
    <div class="cta-bar__actions">
      <a class="btn btn--primary" href="/free-quote/">GET RATES &amp; INFO HERE</a>
      <a class="btn btn--secondary cta-bar__phone" href={lead.phone.href}>{lead.phone.display}</a>
    </div>
  </div>
</section>

<style>
  .cta-bar {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-2);
  }
  .cta-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    text-align: center;
  }
  .cta-bar__title {
    margin: 0;
    font-weight: 800;
  }
  .cta-bar__actions {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .cta-bar .btn {
    padding-inline: var(--space-3);
    font-size: 0.8125rem;
  }
  /* Never split the phone number across lines. */
  .cta-bar__phone {
    white-space: nowrap;
  }
  @media (min-width: 30rem) {
    .cta-bar .btn {
      padding-inline: var(--space-4);
      font-size: 0.9375rem;
    }
  }
</style>
