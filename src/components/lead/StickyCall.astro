---
// Mobile-only call button pinned to the bottom of the screen (replaces the
// "Call Now Button" plugin; same text as on the live site). Landing pages
// whose content already contains that button (#callnowbutton) get the same
// styling from global.css instead, so this isn't rendered twice.
import { PAGE_PHONES, type PagePhoneKey } from '@/config/phones';

const { phone = 'default' } = Astro.props as { phone?: PagePhoneKey };
const pagePhone = PAGE_PHONES[phone];
---

<a class="call-sticky" href={pagePhone.href}>GET RATES NOW {pagePhone.paren}</a>
