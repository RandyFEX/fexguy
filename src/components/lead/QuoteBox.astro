---
// Article "Get Pricing" module (Randy, Quote System v5.8, v5.9): replaced the
// old sidebar lead form. The funnel's own Male and Female choices
// (GenderChoice.astro) link to /free-quote/, which opens at the age question
// with that choice already made. The click records where the visitor came
// from (this article's title and URL, the sidebar, the choice and the time)
// for the lead record and Randy's notification (src/scripts/quote-entry.ts).
// Without JavaScript the links still open the funnel with the choice made.
//
// Placements (v5.9):
//  - 'aside' (default; ContentLayout sidebar pages): in the sidebar, after
//    the content on phones; id="quote".
//  - 'article-aside' (ArticleLayout): the desktop sidebar only (64rem+).
//  - 'inline' (ArticleLayout): inside the article body, phones and tablets
//    only (under 64rem), between two complete sections
//    (src/lib/article/inline-pricing.ts); id="quote", so the GET MY QUOTE
//    button (shown under 64rem only) lands on it. One copy shows at a time.
// In the sidebar (64rem+) Male and Female are stacked and the module stays in
// view while the reader scrolls, within its sidebar column; when the screen is
// too short for it, it scrolls inside itself instead of being cut off.
import GenderChoice from '@/components/quote/GenderChoice.astro';
import { HEADER_PHONE_ICON_PATH, PAGE_PHONES } from '@/config/phones';

interface Props {
  placement?: 'aside' | 'article-aside' | 'inline';
}
const { placement = 'aside' } = Astro.props;
const id = placement === 'article-aside' ? 'quote-aside' : 'quote';
const titleId = `${id}-title`;
const phone = PAGE_PHONES.default;
---

<div
  class:list={['quote-box quote-box--sidebar gp', `gp--${placement}`]}
  id={id}
  data-get-prices={placement}
  data-pagefind-ignore
  role="region"
  aria-labelledby={titleId}
>
  <p class="quote-box__title gp__title" id={titleId}><span class="gp__title-text" data-gp-title>GET PRICING HERE</span></p>
  <div class="gp__body">
    <p class="gp__q">I need pricing for a...</p>
    <GenderChoice as="link" />
    <p class="gp__note">Your Burial Insurance Quote Starts Here. No Agent Required. Less Than 60 Seconds.</p>
    {/* v5.9 (Randy): a direct call option under the choices; a tap is recorded, never a completed call. */}
    <a class="btn gp__call" href={phone.href} data-gp-call>
      <svg aria-hidden="true" width="22" height="22" viewBox="1.5 1.5 21 21" fill="currentColor"><path fill-rule="evenodd" d={HEADER_PHONE_ICON_PATH} clip-rule="evenodd" /></svg>
      <span class="gp__call-text"><span class="gp__call-label">CALL NOW</span> <span class="gp__call-number">{phone.display}</span></span>
    </a>
  </div>
</div>

<style is:global>
  /* Header (Randy, November 2026): GET PRICING HERE in yellow, weight 900, as
     large as fits on one line with about 8px each side (26px minimum, 40px
     cap for the wide tablet copy). CSS
     sizes it from the bar's width (safe without JavaScript); the script
     below then sets the exact largest size for the visitor's actual font. */
  .gp .gp__title { padding: var(--space-3) 8px; container-type: inline-size; letter-spacing: 0; line-height: 1.1; }
  .gp .gp__title-text {
    display: block; white-space: nowrap; color: #ffeb3b; font-weight: 900;
    font-size: clamp(26px, calc(100cqi / 10.4), 40px); line-height: 1.1;
  }
  .gp__body { padding: var(--space-4) var(--space-3); background: var(--color-bg); }
  .gp__q { margin: 0 0 var(--space-3); text-align: center; font-weight: 800; font-size: 1.125rem; line-height: 1.3; color: var(--color-primary); }
  .gp .qf-people { gap: var(--space-3); }
  .gp .qf-person { padding: var(--space-3) var(--space-1); text-decoration: none; min-height: var(--tap-target, 44px); }
  .gp .qf-person__art { width: min(6rem, 100%); }
  .gp .qf-person__label { font-size: 1.125rem; }
  /* Cards (Randy, November 2026): the illustrations about 30% larger in the
     same card size (less padding and space above the label), labels MALE /
     FEMALE at 18px, weight 900; a subtle hover on desktop. The whole card
     stays the link; the site's focus ring is unchanged. */
  .gp .qf-person { gap: 2px; padding-block: 5px; min-height: 163px; justify-content: center; }
  /* Layout (Randy, November 2026): cards and CALL NOW at 91% of the module's
     inner width, centered; illustrations about 22% larger (up to the card
     width on phones); one even 12px gap between every element and the same
     padding above and below; CALL NOW 888-862-9456 on one line, its type a
     little smaller only where the button is narrow. */
  .gp .gp__body { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; container-type: inline-size; }
  .gp .gp__q { margin: 0; font-weight: 800; }
  .gp .gp__body > .qf-people,
  .gp .gp__body > .gp__call { width: 91%; max-width: none; margin-inline: auto; }
  .gp .qf-people { gap: var(--space-3); }
  .gp .gp__call { padding-inline: var(--space-2); }
  /* Reassurance line between the cards and CALL NOW (Randy, November 2026):
     plain sentence text at the cards' width, in the module's 12px rhythm. */
  .gp .gp__note { width: 91%; margin: 0; text-align: center; font-size: 0.875rem; font-weight: 600; line-height: 1.35; color: var(--color-primary); }
  .gp .gp__call-text { flex-direction: row; align-items: center; gap: 0.35em; white-space: nowrap; font-size: clamp(0.875rem, 5.4cqi, 1.125rem); }
  .gp .gp__call-label,
  .gp .gp__call-number { font-size: 1em; }
  .gp .qf-person__art { width: min(9.6rem, 100%); }
  /* Size (Randy, November 2026): the approved illustrations about 27% larger
     on desktop (196px; the sticky module still fits a 720px-tall screen),
     and the full card width on phones (2px side padding). Artwork unchanged. */
  .gp .qf-person { padding-inline: 2px; }
  .gp .qf-person__art { width: min(12.25rem, 100%); }
  .gp .qf-person__label { font-size: 1.125rem; font-weight: 900; line-height: 1; text-transform: uppercase; letter-spacing: 0.02em; padding-bottom: 2px; }
  @media (hover: hover) {
    .gp .qf-person:hover { border-color: #c9c1ae; background: #f7f6f2; }
  }
  /* The funnel's orange CTA (homepage GET A QUOTE tokens). */
  .gp__call {
    display: flex; align-items: center; justify-content: center; gap: var(--space-2); width: 100%;
    min-height: 3.25rem; padding: var(--space-2) var(--space-3); border: 0; border-radius: var(--radius);
    background: var(--color-cta); color: var(--color-on-cta); font-weight: 800; text-decoration: none; line-height: 1.15;
  }
  .gp__call:hover, .gp__call:focus-visible { background: var(--color-cta); color: var(--color-on-cta); filter: brightness(0.9); }
  .gp__call:active { filter: brightness(0.82); }
  .gp__call svg { flex: none; }
  .gp__call-text { display: flex; flex-direction: column; align-items: flex-start; }
  .gp__call-label { font-size: 1.125rem; letter-spacing: 0.02em; }
  .gp__call-number { font-size: 1.125rem; white-space: nowrap; }
  /* Inside the article text: the article's paragraph and link styles never
     reach the module, so it looks exactly like the sidebar copy. */
  .gp--inline { margin-block: var(--space-8); }
  body.page-article-v2 .art-body .gp p { margin: 0; font-size: 1rem; line-height: 1.5; }
  body.page-article-v2 .art-body .gp .quote-box__title { font-size: 1.125rem; }
  body.page-article-v2 .quote-box.gp .gp__title { padding: var(--space-3) 8px; letter-spacing: 0; }
  body.page-article-v2 .art-body .gp .gp__q { margin: 0; font-size: 1.125rem; line-height: 1.3; }
  body.page-article-v2 .art-body .gp .gp__note { font-size: 0.875rem; line-height: 1.35; }
  body.page-article-v2 .art-body .gp a,
  body.page-article-v2 .art-body .gp a:hover { text-decoration: none; }
  body.page-article-v2 .art-body .gp a.qf-person,
  body.page-article-v2 .art-body .gp a.qf-person:hover { color: inherit; }
  body.page-article-v2 .art-body .gp a.gp__call,
  body.page-article-v2 .art-body .gp a.gp__call:is(:hover, :focus-visible, :active, :visited) { color: var(--color-on-cta); }

  @media (max-width: 63.999rem) {
    .gp--article-aside { display: none; }
  }
  @media (min-width: 64rem) {
    .gp--inline { display: none; }
    /* Sidebar: Male on top, Female underneath; sticky within the sidebar column. */
    .gp--aside .qf-people,
    .gp--article-aside .qf-people { grid-template-columns: 1fr; }
    .gp--aside,
    .gp--article-aside {
      position: sticky;
      top: var(--space-6);
      max-height: calc(100vh - 2 * var(--space-6));
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
    }
  }
</style>

<script>
  import { rememberSidebarEntry } from '@/scripts/quote-entry';

  // GET PRICING HERE: the largest whole-pixel size that keeps it on one line
  // inside the bar's content width (26px minimum; 40px cap for the wide
  // in-article copy on tablets); re-fit when the bar resizes.
  const fitTitle = (text: HTMLElement) => {
    const bar = text.parentElement;
    if (!bar || !bar.clientWidth) return;
    const cs = getComputedStyle(bar);
    const avail = bar.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    text.style.fontSize = '100px';
    const w = text.scrollWidth;
    text.style.fontSize = `${Math.min(40, Math.max(26, Math.floor((100 * avail) / w)))}px`;
  };
  const titles = [...document.querySelectorAll<HTMLElement>('[data-gp-title]')];
  const refit = () => titles.forEach(fitTitle);
  refit();
  document.fonts?.ready.then(refit);
  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver(refit);
    titles.forEach((t) => t.parentElement && ro.observe(t.parentElement));
  }

  // Call taps (GA4 only, via tracking.ts): the article's path and which copy of
  // the module; never a name or number, and a tap is not a completed call.
  for (const call of document.querySelectorAll<HTMLAnchorElement>('[data-get-prices] [data-gp-call]')) {
    call.addEventListener('click', () => {
      const placement = call.closest<HTMLElement>('[data-get-prices]')?.dataset.getPrices === 'inline' ? 'in-article' : 'sidebar';
      window.dispatchEvent(new CustomEvent('ff:funnel', { detail: { name: 'quote_module_call_click', entryType: 'article-sidebar', entryPath: location.pathname, placement } }));
    });
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-get-prices] [data-gp-gender]')) {
    link.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
        // A new tab or window still gets the choice and the article from the URL.
        link.href = rememberSidebarEntry(link.dataset.gpGender === 'female' ? 'female' : 'male');
        return;
      }
      e.preventDefault();
      location.assign(rememberSidebarEntry(link.dataset.gpGender === 'female' ? 'female' : 'male'));
    });
  }
</script>
