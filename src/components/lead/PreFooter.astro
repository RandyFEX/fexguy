---
// Pre-footer call to action (copy from the live site). Its button opened the
// quote pop-up on WordPress; it now goes to /free-quote/.
import { lead } from '@/config/lead';
---

<section class="pre-footer" aria-labelledby="pre-footer-text">
  <div class="container pre-footer__inner">
    <p class="pre-footer__text" id="pre-footer-text">Compare Quotes From Top Life Insurance Companies</p>
    <div class="pre-footer__actions">
      <a class="btn btn--primary" href="/free-quote/">GET QUOTES NOW</a>
      <a class="btn btn--secondary" href={lead.phone.href}>{lead.phone.display}</a>
    </div>
  </div>
</section>

<style>
  .pre-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-8);
    text-align: center;
  }
  .pre-footer__text {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .pre-footer__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
