---
// Renders one content-collection page: SEO head from its frontmatter and the
// page body (which carries its own H1) inside a readable container, plus the
// quote sidebar on pages that had it on WordPress (`sidebar: true`).
//
// Comments: migrated comments are static content in the page body, and new
// comments are closed (no comment form). A comment service can be added
// later below the page body.
//
// Every page is classified (src/config/content-articles.ts): an editorial
// article opens like a template article (H1, ArticleByline, its Quick Answer
// and Key Points, a bulleted table of contents, the body); any other page
// carries its type and reason (data-page-type) for `npm run verify`. An
// unclassified page fails the build.
import BaseLayout from './BaseLayout.astro';
import QuoteBox from '@/components/lead/QuoteBox.astro';
import type { PageEntry } from '@/lib/pages';
import { isSearchable, pagePath } from '@/lib/pages';
import ArticleByline from '@/components/article/ArticleByline.astro';
import ArticleToc from '@/components/article/ArticleToc.astro';
import { CONTENT_ARTICLES, nonArticlePage } from '@/config/content-articles';
import { splitContentArticle } from '@/lib/article/content-article';
import { migratedDates } from '@/lib/seo/schema';
// Summary-box styles for content pages that carry Key Points markup.
import '@/styles/article-summary.css';

export interface Props {
  entry: PageEntry;
}

const { entry } = Astro.props;
const d = entry.data;
// Landing pages carry the live site's own call button in their content.
const hasOwnCallButton = entry.body?.includes('id="callnowbutton"') ?? false;

const path = pagePath(entry);
const landing = d.layout === 'landing';
const articleConfig = CONTENT_ARTICLES[path];
const other = nonArticlePage(path);
if (!landing && !articleConfig && !other)
  throw new Error(`${path}: unclassified page. Add it to CONTENT_ARTICLES or NON_ARTICLE_PAGES in src/config/content-articles.ts`);
if (articleConfig && other) throw new Error(`${path} is listed as both an article and a non-article page (src/config/content-articles.ts)`);
const pageType = landing ? 'sales' : other?.type;
const pageReason = landing ? 'Sales landing page (layout: landing).' : other?.reason;

// Editorial article: the shared opening around the page's own text.
const parts = articleConfig ? splitContentArticle(entry.rendered?.html ?? '') : undefined;
const updated = articleConfig ? migratedDates(d.jsonLd, d.headMeta).modified?.slice(0, 10) : undefined;
const ex = articleConfig?.exceptions ?? {};
const exceptions =
  [ex.quickAnswer && 'quick-answer', ex.keyPoints && 'key-points', ex.toc && 'toc', ex.tocPosition && 'toc-position'].filter(Boolean).join(' ') || undefined;
---

<BaseLayout
  title={d.title}
  description={d.description}
  robots={d.robots}
  noindex={d.noindex}
  canonical={d.canonical ?? pagePath(entry)}
  headMeta={d.headMeta}
  jsonLd={d.jsonLd}
  layout={d.layout}
  stickyCall={!hasOwnCallButton}
  preFooter={d.preFooter}
  phone={d.phone}
>
  <div
    class:list={['container page', { 'page--sidebar': d.sidebar, 'page--landing': landing, 'page--article': parts }]}
    data-article-layout={parts ? 'content' : undefined}
    data-article-exceptions={exceptions}
    data-page-type={pageType}
    data-page-reason={pageReason}
  >
    {/* Pagefind indexes only this element (H1 + article body), never the
       header, nav, sidebar quote box or footer. */}
    <div class="prose wp-content" data-pagefind-body={isSearchable(entry) ? '' : undefined}>
      {
        parts ? (
          <>
            <Fragment set:html={parts.head} />
            <ArticleByline updated={updated} />
            <Fragment set:html={parts.summary} />
            {!parts.ownToc && !ex.toc && <ArticleToc items={parts.toc} />}
            <Fragment set:html={parts.rest} />
          </>
        ) : (
          <slot />
        )
      }
    </div>
    {
      d.sidebar && (
        <aside class="page__aside">
          <QuoteBox />
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-8) var(--space-12);
  }
  .page__aside {
    margin-top: var(--space-8);
  }
  /* Editorial articles: the shared opening's spacing (as on the template). */
  .page--article :global(.byline) {
    margin-block: var(--space-4) var(--space-6);
  }
  .page--article :global(.byline img) {
    margin: 0;
  }
  .page--article :global(.toc) {
    margin-block: var(--space-6);
  }
  /* Landing pages (no site header or sidebar): center the single column. */
  .page--landing .prose {
    margin-inline: auto;
  }
  @media (min-width: 64rem) {
    .page--sidebar {
      display: grid;
      grid-template-columns: minmax(0, 48rem) 20rem;
      justify-content: space-between;
      align-items: start;
      gap: var(--space-8);
    }
    .page__aside {
      margin-top: 0;
    }
  }
</style>
