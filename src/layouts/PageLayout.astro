---
// Standard content page: breadcrumbs, a single H1, an optional lead, the
// page body, an optional FAQ, and the site-wide call to action. Most
// migrated pages should use this (via src/pages/[...slug].astro).
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CallToAction from '@/components/CallToAction.astro';
import FaqList from '@/components/FaqList.astro';
import { pageTitle } from '@/lib/seo/meta';
import { faqSchema, webPageSchema, type Crumb, type FaqItem, type JsonLd } from '@/lib/seo/schema';

export interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
  publishDate?: Date;
  updatedDate?: Date;
  /** Parent crumbs; Home and the current page are added automatically. */
  breadcrumbs?: Crumb[];
  faq?: FaqItem[];
  showCta?: boolean;
  jsonLd?: (JsonLd | undefined)[];
}

const {
  title,
  metaTitle,
  description,
  canonicalPath,
  ogImage,
  noindex,
  publishDate,
  updatedDate,
  breadcrumbs = [],
  faq = [],
  showCta = true,
  jsonLd = [],
} = Astro.props;

const path = canonicalPath ?? Astro.url.pathname;
const crumbs: Crumb[] = [{ name: 'Home', path: '/' }, ...breadcrumbs, { name: title, path }];
---

<BaseLayout
  title={pageTitle(title, metaTitle)}
  description={description}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
  noindex={noindex}
  jsonLd={[
    webPageSchema({ path, title, description, datePublished: publishDate, dateModified: updatedDate }),
    faqSchema(faq),
    ...jsonLd,
  ]}
>
  <article>
    <div class="container page">
      <Breadcrumbs crumbs={crumbs} />
      <header class="page__header">
        <h1>{title}</h1>
        {
          updatedDate && (
            <p class="page__updated">
              Updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
            </p>
          )
        }
      </header>
      <div class="prose">
        <slot />
      </div>
      {
        faq.length > 0 && (
          <section class="prose page__faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Frequently asked questions</h2>
            <FaqList items={faq} />
          </section>
        )
      }
    </div>
  </article>
  {showCta && <CallToAction />}
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-8) var(--space-12);
  }
  .page__header {
    max-width: var(--prose-max);
  }
  .page__faq {
    margin-top: var(--space-12);
  }
  .page__updated {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
</style>
