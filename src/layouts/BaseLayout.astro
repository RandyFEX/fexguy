---
// Document shell for every page: <head> (SEO, icons), skip link, header,
// call-to-action bar, <main>, pre-footer, footer, mobile call button, and the
// site scripts (lead form, Fillout loader for rollback, tracking). "landing" pages (former
// WordPress landing-page template) render without the site header, CTA bar,
// pre-footer and footer, as they did on the live site.
import '@/styles/global.css';
import Seo, { type HeadMeta } from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CtaBar from '@/components/lead/CtaBar.astro';
import PreFooter from '@/components/lead/PreFooter.astro';
import StickyCall from '@/components/lead/StickyCall.astro';
import { site } from '@/config/site';

export interface Props {
  title: string;
  description?: string;
  robots?: string;
  noindex?: boolean;
  canonical?: string;
  headMeta?: HeadMeta[];
  jsonLd?: string[];
  layout?: 'default' | 'landing';
  /** Render the mobile call button. Off for pages whose content already has
   * the live site's call button (#callnowbutton). */
  stickyCall?: boolean;
  /** Render the call-to-action bar under the header (off on the homepage). */
  ctaBar?: boolean;
  /** Extra class on <body> (the homepage uses it to scope its palette). */
  bodyClass?: string;
  /** Render the shared pre-footer call to action (off on the homepage, which
   * ends with its own). */
  preFooter?: boolean;
}

const { layout = 'default', stickyCall = true, ctaBar = true, preFooter = true, bodyClass, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Lets CSS collapse the mobile menu before first paint (no layout shift). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Search-term privacy: site search terms (?q= / the old WordPress ?s=)
      can contain names or health conditions. Before any tracking code runs,
      remove them from the address bar so GA4 and the Meta Pixel (which read
      the page URL, and on the next page the referrer) never receive them. On
      /search/ the term moves into history.state, where src/scripts/search.ts
      reads it (it survives reload and back/forward). Other parameters (utm_*,
      gclid, fbclid…) are kept. -->
    <script is:inline>
      (function () {
        try {
          var u = new URL(location.href), p = u.searchParams;
          if (!p.has('q') && !p.has('s')) return;
          var term = p.has('q') ? p.get('q') : p.get('s');
          p.delete('q');
          p.delete('s');
          var qs = p.toString();
          var state = u.pathname === '/search/' ? { searchQuery: term } : history.state;
          history.replaceState(state, '', u.pathname + (qs ? '?' + qs : '') + u.hash);
        } catch (e) {}
      })();
    </script>
    {site.icons.map((icon) => <link rel={icon.rel} href={icon.href} sizes={icon.sizes} />)}
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class:list={[{ 'is-landing': layout === 'landing' }, bodyClass]}>
    <a class="skip-link" href="#main">Skip to main content</a>
    {layout !== 'landing' && <Header />}
    {layout !== 'landing' && ctaBar && <CtaBar />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {layout !== 'landing' && preFooter && <PreFooter />}
    {layout !== 'landing' && <Footer />}
    {stickyCall && <StickyCall />}
    <script>
      import '@/scripts/tracking';
      import '@/scripts/quote-form';
      import '@/scripts/lead-form';
    </script>
    <script>
      import '@/scripts/scroll-tables';
      import '@/scripts/sticky-call';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius);
  }
  .skip-link:focus {
    top: var(--space-2);
  }
  main:focus {
    outline: none;
  }
</style>
