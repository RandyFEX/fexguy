const quickAnswer = "There's no government life insurance benefit behind these \u201cstate-regulated\u201d mailers. Every life insurance policy sold in your state is regulated by the state, so the phrase doesn't mean anything special. These cards are insurance advertisements, and what they're really after is your name, address, phone number and age, which can be passed to an insurance agent as a sales lead.";
const keyPoints = [
  '\u201cState-regulated\u201d describes every legitimate life insurance policy. It isn\u2019t a special program, and your state isn\u2019t paying for your funeral.',
