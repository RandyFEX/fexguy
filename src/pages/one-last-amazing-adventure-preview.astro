---
// One Last Amazing Adventure: private five-park preview (Randy, November
// 2026, Version 1.5 editorial redesign). Built from the Version 1.1 research
// in src/data/last-adventure/parks.ts. Review only: noindex, nofollow (also
// an X-Robots-Tag header in vercel.json), out of the sitemap, llms.txt and
// site search, never linked from the site, and not merged to production.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { parks, states, parkOrder, parkStates, stateId, mapsUrl, type Point, type Photo } from '@/data/last-adventure/parks';

const total = parks.reduce((n, p) => n + p.destinations.length, 0);
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const usedLetters = new Set(states.map((s) => s.state[0].toUpperCase()));
const coord = (p: Point) => `${p.lat.toFixed(5)}, ${p.lon.toFixed(5)}`;
const kindLabel = { accessible: 'Accessible', extraordinary: 'Extraordinary' } as const;
// Fixed page hero (Version 4.0): the verified NPS photograph of a family at Lady Bird Johnson Grove.
const heroPhoto = parks.find((p) => p.id === 'redwood')!.destinations.find((d) => d.id === 'lady-bird-johnson-grove')!.photo!;
const hero = { ...heroPhoto, caption: 'Lady Bird Johnson Grove, Redwood National and State Parks' };
const credit = (ph: Photo) => ph.credit;
// The determination is the summary up to its first comma, semicolon or colon
// (bold); the explanation after it stays regular. The text is never changed.
const splitLead = (t: string): [string, string] => {
  const m = t.match(/^[^,;:]+?[,;:](?=\s)/);
  if (!m) return [t, ''];
  // A clause that opens a list ("except ...", "either ...") ends the bold before it.
  if (/\b(except|either)\b/.test(m[0])) {
    const q = m[0].match(/^.+?(?= (in all|either)\b)/);
    if (q) return [q[0], t.slice(q[0].length)];
  }
  return [m[0], t.slice(m[0].length)];
};
// A bullet that opens with a cited source (for example "Superintendent's
// Compendium, 36 CFR 2.62(b):") shows that heading in bold.
const SOURCE_HEAD = /^((?:\d{4} )?(?:Superintendent's Compendium|Laws and [Pp]olicies)[^:]{0,60}:)/;
// The plan grid pairs its half-width cells (Distance, Difficulty, Hiking
// time, Elevation gain) two per row before the full-width rows. With three,
// the third would leave an empty slot showing the grid's line color as a solid
// green box, so that cell spans the row instead.
const oddLast = (d: { plan: { time?: string; elevation?: string } }) =>
  d.plan.time && !d.plan.elevation ? 'time' : !d.plan.time && d.plan.elevation ? 'elevation' : null;
// A plan scattering line with two restrictions (split at "; ") shows each on its own line.
const scatterLines = (t: string) => t.split(/(?<=;) /);
// Creative Commons BY/BY-SA photos: attribution shows title, author, source and license, plus a change notice.
const isCC = (ph: Photo) => /^CC BY/.test(ph.license?.name ?? '');
// One mapping for the written NPS classifications: Easy 1, Moderate 3,
// Difficult 4, Strenuous and very strenuous 5. A destination listing two
// classifications (for example by boat and on foot) shows the range.
const LEVELS: Array<[RegExp, number]> = [
  [/very strenuous|strenuous/i, 5],
  [/difficult/i, 4],
  [/moderate/i, 3],
  [/easy/i, 1],
];
// Parts that say a route is not rated ("not rated", "not an easy walk") are
// ignored; with no rating left, no indicator is shown (never a guessed level).
const difficultyRange = (text: string): [number, number] | null => {
  const found = text.split(/[;,:]| to /i).flatMap((part) => {
    if (/not\s+(rated|an?\s+easy|easy)/i.test(part)) return [];
    const hit = LEVELS.find(([re]) => re.test(part));
    return hit ? [hit[1]] : [];
  });
  return found.length ? [Math.min(...found), Math.max(...found)] : null;
};
---

<BaseLayout
  title="One Last Amazing Adventure (Preview) | Funeral Funds"
  description="Private preview: five national parks and 21 extraordinary places for a final family adventure."
  robots="noindex, nofollow"
  noindex={true}
  canonical="/one-last-amazing-adventure-preview/"
  stickyCall={false}
  preFooter={false}
  bodyClass="page-ola"
>
  <article class="ola" data-page-type="utility" data-page-reason="Private, non-indexed preview of the One Last Amazing Adventure national parks guide.">
    <header class="ola-hero">
      <picture>
        {hero.srcWebp && <source srcset={hero.srcWebp} type="image/webp" />}
        <img class="ola-hero__img" src={hero.src} alt={hero.alt} width="1600" height="900" fetchpriority="high" referrerpolicy="no-referrer" />
      </picture>
      <div class="ola-hero__shade"></div>
      <div class="ola-hero__text">
        <p class="ola-hero__flag">Private preview. Not published.</p>
        <h1>One Last Amazing Adventure</h1>
        <p class="ola-hero__sub">63 National Parks, Extraordinary Places to Say Goodbye</p>
      </div>
      <p class="ola-credit ola-credit--hero">{hero.caption}. Photo: {hero.credit}</p>
    </header>

    <section class="ola-wrap ola-intro" aria-labelledby="ola-intro-title">
      <h2 id="ola-intro-title" class="visually-hidden">About this guide</h2>
      <p class="ola-lead">
        Some of the best memories a family shares were made outdoors. This guide is for taking your loved one along on one
        more trip like that: to a canyon rim, a mountain lake or a granite summit, with the people who knew them best.
      </p>
      <p>
        Bring their ashes, walk the trail together, tell the stories, take the photographs and celebrate the life you are
        there to honor. Then decide where the ashes will rest.
      </p>
      <p>
        <strong>The place where you say goodbye and the place where you scatter can be different.</strong> Many of the most
        spectacular viewpoints are not open to scattering. For every destination we show where scattering is legally allowed:
        sometimes at the same spot, sometimes a short drive away, and sometimes outside the park entirely.
      </p>
      <p class="ola-intro__count">This first edition covers {parks.length} parks and {total} destinations, with directions, trail details and GPS navigation for each.</p>
    </section>

    <section class="ola-browse" id="ola-browse" aria-labelledby="ola-browse-title" data-ola-browse>
      <div class="ola-wrap">
        <h2 id="ola-browse-title">Find a Park by State</h2>
        <div class="ola-az" role="group" aria-label="States by first letter">
          <button type="button" class="ola-az__btn ola-az__btn--all" data-letter="all" aria-pressed="true">All</button>
          {
            letters.map((l) => (
              <button type="button" class="ola-az__btn" data-letter={l} disabled={!usedLetters.has(l)} aria-pressed="false">
                {l}
              </button>
            ))
          }
        </div>
        <div class="ola-states" role="group" aria-label="States" data-ola-states>
          {
            states.map((s) => (
              <button type="button" class="ola-state-btn" data-state={s.id} data-letter={s.state[0].toUpperCase()} aria-pressed="false">
                {s.state} <span class="ola-state-btn__n">{s.parks.length}</span>
              </button>
            ))
          }
        </div>
        <p class="ola-browse__status" aria-live="polite" data-ola-status>Showing all {parks.length} parks in this guide.</p>
        <ul class="ola-cards">
          {
            parkOrder.map((p) => (
                <li class="ola-card" data-states={parkStates(p).map(stateId).join(' ')}>
                  <a href={`#${p.id}`} class="ola-card__link">
                    <span class="ola-card__img">
                      {p.photo ? (
                        <img src={p.photo.src} alt={p.photo.alt} width="800" height="500" loading="lazy" referrerpolicy="no-referrer" />
                      ) : (
                        <span class="ola-dest__placeholder" role="img" aria-label={`Photograph of ${p.name} to come`}><span>{p.short}</span></span>
                      )}
                    </span>
                    <span class="ola-card__body">
                      <span class="ola-card__state">{p.state}</span>
                      <span class="ola-card__name">{p.name}</span>
                      <span class="ola-card__tag">{p.tagline}</span>
                      <span class="ola-card__meta">
                        {p.destinations.length} destinations
                        <span class={`ola-pill ${p.scatterAllowed === 'Prohibited' ? 'ola-pill--no' : p.scatterAllowed === 'Unconfirmed' ? 'ola-pill--check' : 'ola-pill--yes'}`}>
                          Scattering: {p.scatterAllowed === 'Prohibited' ? 'Prohibited' : p.scatterAllowed === 'Unconfirmed' ? 'Check with the park' : 'Permitted with conditions'}
                        </span>
                      </span>
                      <span class="ola-card__cta">Explore Destinations</span>
                    </span>
                  </a>
                </li>
              ))
          }
        </ul>
        <p class="ola-credit">Photos: {parkOrder.filter((p) => p.photo).map((p) => `${p.short}, ${credit(p.photo!)}${p.photo!.license ? ` (${p.photo!.license.name})` : ''}`).join('; ')}. No claim to original U.S. Government works.</p>
      </div>
    </section>

    {
      parkOrder.map((p) => {
        const s = states.find((x) => x.state === parkStates(p)[0])!;
        return (
          <section class="ola-park" id={p.id} aria-labelledby={`${p.id}-title`}>
            <div class="ola-wrap">
              <nav class="ola-statenav" aria-label={`National parks in ${s.state}`}>
                <p class="ola-statenav__title">National Parks in {s.state}</p>
                <ul>
                  {s.parks.map((q) => (
                    <li>
                      <a href={`#${q.id}`} class:list={['ola-statenav__btn', { 'is-current': q.id === p.id }]} aria-current={q.id === p.id ? 'true' : undefined}>
                        {q.short}
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="ola-statenav__all" href="#ola-browse">All states A to Z</a>
              </nav>

              {p.photo && (
                <figure class="ola-park__hero">
                  <img src={p.photo.src} alt={p.photo.alt} width="1600" height="800" loading="lazy" referrerpolicy="no-referrer" />
                  <figcaption class="ola-credit">
                    {p.photo.caption}. Photo: {p.photo.title && p.photo.sourceUrl
                      ? <>“<a href={p.photo.sourceUrl} rel="noopener" target="_blank">{p.photo.title}</a>” by {p.photo.credit}</>
                      : p.photo.sourceUrl ? <a href={p.photo.sourceUrl} rel="noopener" target="_blank">{p.photo.credit}</a> : p.photo.credit}
                    {p.photo.license && <>, <a href={p.photo.license.url} rel="noopener license" target="_blank">{p.photo.license.name}</a></>}
                    {isCC(p.photo) && '. Resized and cropped'}
                  </figcaption>
                </figure>
              )}

              <div class="ola-park__head">
                <div>
                  <p class="ola-kicker">{p.state}</p>
                  <h2 id={`${p.id}-title`}>{p.name}</h2>
                  <p class="ola-park__intro">{p.intro}</p>
                  <ul class="ola-links">
                    <li><a href={p.homepage} rel="noopener" target="_blank">Official NPS website</a></li>
                    {p.map.map((m) => <li><a href={m.url} rel="noopener" target="_blank">{m.label}</a></li>)}
                  </ul>
                  <p class="ola-park__note"><strong>Before you go:</strong> {p.beforeYouGo}</p>
                </div>
                <aside class:list={['ola-scatter', { 'ola-scatter--no': p.scatterAllowed === 'Prohibited' }]} aria-labelledby={`${p.id}-scatter`}>
                  <h3 id={`${p.id}-scatter`}>Ash Scattering in {p.short}</h3>
                  {p.scatterAllowed === 'Prohibited' ? (
                    <p class="ola-warn"><svg class="ola-warn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2 1 21h22L12 2zm1 15h-2v2h2v-2zm0-7h-2v5h2v-5z" /></svg><span>{p.scatterSummary}</span></p>
                  ) : (
                    <p class="ola-scatter__summary">{(() => {
                      const [lead, rest] = splitLead(p.scatterSummary);
                      return rest ? <><strong>{lead}</strong>{rest}</> : <strong>{lead}</strong>;
                    })()}</p>
                  )}
                  {p.scatterNotes?.map((n) => <p class="ola-scatter__note">{n}</p>)}
                  <ul>{p.scatterFacts.map((f) => {
                    const m = f.match(SOURCE_HEAD);
                    return m ? <li><strong>{m[1]}</strong>{f.slice(m[1].length)}</li> : <li>{f}</li>;
                  })}</ul>
                  <p class="ola-scatter__links">{p.scatterLink.map((l) => <a href={l.url} rel="noopener" target="_blank">{l.label}</a>)}</p>
                </aside>
              </div>

              <nav class="ola-jump" aria-label={`Destinations in ${p.name}`}>
                <span class="ola-jump__count">{p.destinations.length} destinations</span>
                {[...p.destinations].sort((a, b) => a.name.localeCompare(b.name)).map((d) => <a href={`#${p.id}-${d.id}`}>{d.name}</a>)}
              </nav>

              {p.destinations.map((d) => (
                <article class="ola-dest" id={`${p.id}-${d.id}`} aria-labelledby={`${p.id}-${d.id}-title`}>
                  <p class="ola-back"><a href="#ola-browse" data-ola-back><span class="ola-back__arrow" aria-hidden="true">↑</span>Back to State Navigation<span class="ola-back__arrow" aria-hidden="true">↑</span></a></p>
                  <header class="ola-dest__band">
                    <p class="ola-dest__park">{p.name}</p>
                    <h3 id={`${p.id}-${d.id}-title`} class="ola-dest__name">{d.name}</h3>
                    <p class="ola-dest__tags">{d.kinds.map((k) => <span class={`ola-tag ola-tag--${k}`}>{kindLabel[k]}</span>)}</p>
                  </header>
                  {d.photo ? (
                    <figure class="ola-dest__photo">
                      <picture>
                        {d.photo.srcWebp && <source srcset={d.photo.srcWebp} type="image/webp" />}
                        <img src={d.photo.src} alt={d.photo.alt} width="1600" height="900" loading="lazy" referrerpolicy="no-referrer" style={d.photo.position ? `object-position: ${d.photo.position}` : undefined} />
                      </picture>
                      <figcaption class="ola-credit">
                        {d.photo.caption ? `${d.photo.caption}. ` : ''}Photo: {d.photo.title && d.photo.sourceUrl
                          ? <>“<a href={d.photo.sourceUrl} rel="noopener" target="_blank">{d.photo.title}</a>” by {d.photo.credit}</>
                          : d.photo.sourceUrl ? <a href={d.photo.sourceUrl} rel="noopener" target="_blank">{d.photo.credit}</a> : d.photo.credit}
                        {d.photo.license && <>, <a href={d.photo.license.url} rel="noopener license" target="_blank">{d.photo.license.name}</a></>}
                        {isCC(d.photo) && '. Resized and cropped'}
                      </figcaption>
                    </figure>
                  ) : (
                    <div class="ola-dest__placeholder" role="img" aria-label={`Photograph of ${d.name} to come`}><span>{d.name}</span></div>
                  )}

                  <p class="ola-dest__desc">{d.description}</p>

                  <section class="ola-plan" aria-label={`Plan your adventure: ${d.name}`}>
                    <h4>Plan Your Adventure</h4>
                    <dl class="ola-plan__grid">
                      <div><dt>Distance</dt><dd>{d.plan.distance}</dd></div>
                      <div>
                        <dt>Difficulty</dt>
                        <dd>
                          {!/^(easy|strenuous)$/i.test(d.plan.difficulty.trim()) && <span class="ola-diff__text">{d.plan.difficulty}</span>}
                          {(() => {
                            const range = difficultyRange(d.plan.difficulty);
                            if (!range) return null;
                            const [lo, hi] = range;
                            return (
                              <span class="ola-diff" role="img" aria-label={lo === hi ? `Difficulty ${lo} of 5, where 1 is Easy and 5 is Strenuous` : `Difficulty ${lo} to ${hi} of 5, where 1 is Easy and 5 is Strenuous`}>
                                <span class="ola-diff__end" aria-hidden="true">Easy</span>
                                <span class="ola-diff__bar" aria-hidden="true">
                                  {[1, 2, 3, 4, 5].map((n) => (
                                    <span class:list={['ola-diff__seg', { 'is-on': n <= lo, 'is-range': n > lo && n <= hi }]} />
                                  ))}
                                </span>
                                <span class="ola-diff__end" aria-hidden="true">Strenuous</span>
                              </span>
                            );
                          })()}
                        </dd>
                      </div>
                      {d.plan.time && <div class:list={[{ 'ola-plan__wide': oddLast(d) === 'time' }]}><dt>Hiking time</dt><dd>{d.plan.time}</dd></div>}
                      {d.plan.elevation && <div class:list={[{ 'ola-plan__wide': oddLast(d) === 'elevation' }]}><dt>Elevation gain</dt><dd>{d.plan.elevation}</dd></div>}
                      <div class="ola-plan__wide"><dt>Accessibility</dt><dd>{d.plan.accessibility}</dd></div>
                      {d.plan.bestTime && <div class="ola-plan__wide"><dt>Best time or season</dt><dd>{d.plan.bestTime}</dd></div>}
                      <div class={`ola-plan__scatter ola-plan__scatter--${d.scatterStatus}`}><dt>Ash Scattering</dt><dd><span class="ola-status">{d.scatterStatus === 'prohibited' && <span class="ola-warn ola-warn--inline"><svg class="ola-warn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2 1 21h22L12 2zm1 15h-2v2h2v-2zm0-7h-2v5h2v-5z" /></svg></span>}<span class="ola-status__text">{scatterLines(d.plan.scattering).map((line) => <span class="ola-status__line">{line}</span>)}</span></span></dd></div>
                      <div>
                        <dt>Official Information</dt>
                        <dd>
                          {d.links.length
                            ? d.links.map((l) => <a href={l.url} rel="noopener" target="_blank">NPS: {l.label}</a>)
                            : <a href={p.map[0].url} rel="noopener" target="_blank">NPS: official park map</a>}
                        </dd>
                      </div>
                      {p.planNote && (
                        <div class="ola-plan__wide ola-plan__note">
                          <dt><span class="ola-badge-head">{p.planNote.heading}</span></dt>
                          <dd>{p.planNote.text}</dd>
                        </div>
                      )}
                      {d.scatterNote && (
                        <div class="ola-plan__wide ola-plan__note">
                          <dt><span class="ola-badge-head">Where Is Ash Scattering Permitted?</span></dt>
                          <dd>
                            <p>{d.scatterNote.text}</p>
                            {d.scatterNote.points && (
                              <ul class="ola-gps">
                                {d.scatterNote.points.map((pt) => (
                                <li>
                                  <a class="ola-gps__btn" href={mapsUrl(pt.lat, pt.lon)} rel="noopener" target="_blank" data-lat={pt.lat} data-lon={pt.lon} aria-label={`Open ${pt.label}, ${coord(pt)}, in Google Maps`}>
                                    <svg class="ola-gps__pin" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
                                    <span class="ola-gps__label">{pt.label}</span>
                                    <span class="ola-gps__coord">{coord(pt)}</span>
                                  </a>
                                </li>
                                ))}
                              </ul>
                            )}
                          </dd>
                        </div>
                      )}
                    </dl>
                  </section>

                  <div class="ola-route">
                    <section>
                      <h4>Getting There</h4>
                      <ul class="ola-gps">
                        {d.drive.points.map((pt) => (
                          <li>
                            <a class="ola-gps__btn" href={mapsUrl(pt.lat, pt.lon)} rel="noopener" target="_blank" data-lat={pt.lat} data-lon={pt.lon} aria-label={`Open ${pt.label}, ${coord(pt)}, in Google Maps`}>
                              <svg class="ola-gps__pin" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
                              <span class="ola-gps__label">{pt.label}</span>
                              <span class="ola-gps__coord">{coord(pt)}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                      <p>{d.drive.route}</p>
                    </section>
                    <section>
                      <h4>{d.trail ? 'On the Trail' : 'Your Destination'}</h4>
                      <ul class="ola-gps">
                        {d.final.map((pt) => (
                          <li>
                            <a class="ola-gps__btn" href={mapsUrl(pt.lat, pt.lon)} rel="noopener" target="_blank" data-lat={pt.lat} data-lon={pt.lon} aria-label={`Open ${pt.label}, ${coord(pt)}, in Google Maps`}>
                              <svg class="ola-gps__pin" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
                              <span class="ola-gps__label">{pt.label}</span>
                              <span class="ola-gps__coord">{coord(pt)}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                      {d.trail && (
                        <>
                          <p class="ola-route__trail">{d.trail.name}</p>
                          <ol class="ola-steps">{d.trail.steps.map((st) => <li>{st}</li>)}</ol>
                          {d.trail.notes?.map((n) => <p class="ola-note">{n}</p>)}
                        </>
                      )}
                    </section>
                  </div>

                </article>
              ))}
            </div>
          </section>
        );
      })
    }

    <footer class="ola-wrap ola-foot">
      <p>
        GPS coordinates are map-verified from OpenStreetMap features matching the National Park Service descriptions, or taken
        from official NPS map data for the designated Mount Rainier locations. Conditions, closures and permit rules change:
        check each park’s official page before you go. Photographs from the National Park Service and Wikimedia Commons,
        credited as shown.
      </p>
    </footer>
  </article>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-ola-browse]');
  if (root) {
    const letterBtns = [...root.querySelectorAll<HTMLButtonElement>('.ola-az__btn')];
    const stateBtns = [...root.querySelectorAll<HTMLButtonElement>('.ola-state-btn')];
    const cards = [...root.querySelectorAll<HTMLElement>('.ola-card')];
    const status = root.querySelector<HTMLElement>('[data-ola-status]');
    let letter = '';
    let state = '';

    const render = () => {
      letterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.letter === (letter || 'all'))));
      stateBtns.forEach((b) => {
        b.hidden = !!letter && b.dataset.letter !== letter;
        b.setAttribute('aria-pressed', String(b.dataset.state === state));
      });
      const visibleStates = new Set(stateBtns.filter((b) => !b.hidden).map((b) => b.dataset.state));
      let shown = 0;
      cards.forEach((c) => {
        const cs = (c.dataset.states || '').split(' ');
        const show = state ? cs.includes(state) : cs.some((x) => visibleStates.has(x));
        c.hidden = !show;
        if (show) shown++;
      });
      if (status) {
        const stateName = stateBtns.find((b) => b.dataset.state === state)?.firstChild?.textContent?.trim();
        status.textContent = state
          ? `National parks in ${stateName}: ${shown}.`
          : letter
            ? `States beginning with ${letter}. Choose a state to see its parks.`
            : `Showing all ${shown} parks in this guide.`;
      }
    };
    const pickLetter = (l: string) => {
      letter = l;
      const inLetter = stateBtns.filter((b) => b.dataset.letter === l);
      state = inLetter.length === 1 ? inLetter[0].dataset.state! : '';
      render();
    };
    letterBtns.forEach((b) => {
      b.addEventListener('click', () => (b.dataset.letter === 'all' ? pickLetter('') : pickLetter(b.dataset.letter!)));
    });
    stateBtns.forEach((b) => {
      // Click (or tap) only: choosing a state shows its parks and goes to them;
      // a state with one park goes straight to that park's section.
      b.addEventListener('click', () => {
        state = b.dataset.state!;
        letter = b.dataset.letter!;
        render();
        const shown = cards.filter((c) => !c.hidden);
        const target = shown.length === 1 ? document.querySelector<HTMLElement>(shown[0].querySelector('a')!.getAttribute('href')!) : shown[0];
        target?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      });
    });
    render();
  }
  // Back to State Navigation: the plain #ola-browse link works without
  // JavaScript; with it, scroll smoothly unless reduced motion is preferred.
  document.querySelectorAll<HTMLAnchorElement>('[data-ola-back]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const nav = document.getElementById('ola-browse');
      if (!nav) return;
      e.preventDefault();
      nav.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', '#ola-browse');
    }),
  );
