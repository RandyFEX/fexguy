---
// Scattering Ashes Along the Appalachian Trail: One Last Amazing Adventure
// (Randy, November 2026). PREVIEW ONLY: noindex, nofollow, out of the sitemap,
// with an X-Robots-Tag header in vercel.json, not linked from the menu or any
// page. Built as a sibling of the national parks guide
// (scattering-ashes-in-us-national-parks.astro), whose layout and styles it
// reuses. Data: src/data/appalachian-trail/ (see guide.ts).
import BaseLayout from '@/layouts/BaseLayout.astro';
import GpsList from '@/components/appalachian-trail/GpsList.astro';
import AtMapDefs from '@/components/appalachian-trail/AtMapDefs.astro';
import AtLocatorMap from '@/components/appalachian-trail/AtLocatorMap.astro';
import { pageTitle } from '@/lib/seo/meta';
import { intro, destinations, states, hero, CLASS_LABEL, mapsUrl, linkLabel, type AtPoint, type AtDestination, type Classification } from '@/data/appalachian-trail/guide';

const total = destinations.length;
const kindLabel = { accessible: 'Accessible', extraordinary: 'Extraordinary' } as const;
const coord = (p: AtPoint) => `${p.lat.toFixed(5)}, ${p.lon.toFixed(5)}`;
// The map marks the destination point, or the trailhead where no destination point exists.
const mapPoint = (d: AtDestination) => d.points.find((pt) => pt.role === 'destination') ?? d.points.find((pt) => pt.role === 'trailhead') ?? null;
const pointSource = (pt: AtPoint) =>
  pt.kind === 'official' ? pt.source : pt.kind === 'osm' ? 'Mapped by Funeral Funds from OpenStreetMap; not an official coordinate.' : 'Appalachian Trail Conservancy map point; role not established.';
const miles = (n: number) => `${n} ${n === 1 ? 'mile' : 'miles'} round trip`;
const ft = (n: number) => (n === 0 ? 'Flat' : `${n.toLocaleString('en-US')} ft`);
const pill = (c: Classification) => (c === 'permitted' ? 'yes' : c === 'prohibited' ? 'no' : 'check');
// "Label (detail)" source strings show the source name only.
const srcShort = (s: string | null) => (s ? s.replace(/\s*\(OFFICIAL[^)]*\)/g, '').replace(/^v6 inventory/, 'Earlier research inventory') : '');
const classes: Classification[] = ['permitted', 'permit-required', 'prohibited', 'unconfirmed'];
const evidence = (e: string) =>
  /^OFFICIAL \(fetched\)/.test(e)
    ? 'Checked directly on the official website.'
    : /^OFFICIAL/.test(e)
      ? 'Official source, seen through a search summary; not yet opened directly.'
      : /^SECONDARY/.test(e)
        ? 'Secondary source (the official text could not be checked).'
        : 'No published rule found on the land manager’s website.';
const verification = { verified: 'Verified', partial: 'Partly verified', unverified: 'Unverified details marked' } as const;
---

<BaseLayout
  title={pageTitle('Scattering Ashes Along the Appalachian Trail: One Last Amazing Adventure')}
  description="Preview: where families can remember a loved one along the Appalachian Trail, and what each land manager allows for scattering ashes."
  canonical="/scattering-ashes-on-the-appalachian-trail/"
  robots="noindex, nofollow"
  noindex
  stickyCall={false}
  preFooter={false}
  bodyClass="page-ola"
>
  <article class="ola" data-page-type="guide" data-page-reason="Preview of a standalone guide to scattering ashes along the Appalachian Trail, built from the research dataset with the national parks guide's layout; not an editorial article.">
    <AtMapDefs />
    <header class="ola-hero">
      <picture>
        <source srcset={hero.srcWebp} type="image/webp" />
        <img class="ola-hero__img" src={hero.src} alt={hero.alt} width="1600" height="900" fetchpriority="high" referrerpolicy="no-referrer" />
      </picture>
      <div class="ola-hero__shade"></div>
      <div class="ola-hero__text">
        <h1>Scattering Ashes Along the Appalachian Trail</h1>
        <p class="ola-hero__sub ola-hero__sub--name">One Last Amazing Adventure</p>
        <p class="ola-hero__sub">{total} Places to Say Goodbye, From Georgia to Maine</p>
      </div>
      <p class="ola-credit ola-credit--hero">{hero.caption}. Photo: <a href={hero.sourceUrl} rel="noopener" target="_blank">{hero.credit}</a> ({hero.license.name})</p>
    </header>

    <section class="ola-wrap ola-intro" aria-labelledby="at-intro-title">
      <h2 id="at-intro-title" class="visually-hidden">About this guide</h2>
      {intro.lead.map((p, i) => <p class:list={[{ 'ola-lead': i === 0 }]}>{p}</p>)}
      <p class="ola-intro__count">This guide covers {total} destinations in {states.filter((s) => s.destinations.length).length} of the Trail's 14 states, listed from Georgia to Maine in trail order.</p>
    </section>

    <section class="at-rules" aria-labelledby="at-rules-title">
      <div class="ola-wrap">
        <h2 id="at-rules-title">How Scattering Rules Work on the Trail</h2>
        <div class="at-rules__text">
          {intro.rules.map((p) => <p>{p}</p>)}
          <h3>Remembrance places and scattering places</h3>
          {intro.remembrance.map((p) => <p>{p}</p>)}
          <h3>Leave no trace</h3>
          {intro.leaveNoTrace.map((p) => <p>{p}</p>)}
        </div>
        <aside class="ola-scatter at-classes" aria-labelledby="at-classes-title">
          <h3 id="at-classes-title">The Four Classifications</h3>
          <ul class="at-classes__list">
            {intro.classifications.map((c) => {
              const i = c.indexOf('.');
              return <li><strong>{c.slice(0, i + 1)}</strong>{c.slice(i + 1)}</li>;
            })}
          </ul>
        </aside>
        <div class="at-rules__text at-rules__nps-block">
          <h3>What the National Park Service Rules Ask</h3>
          {intro.npsLead[0] && <p>{intro.npsLead[0]}</p>}
          <ul class="at-rules__list">{intro.npsRules.map((r) => <li>{r}</li>)}</ul>
          {intro.npsLead.slice(1).map((t) => <p>{t}</p>)}
        </div>
      </div>
    </section>

    <section class="ola-browse" id="at-browse" aria-labelledby="at-browse-title" data-at-browse>
      <div class="ola-wrap">
        <h2 id="at-browse-title">Find a Destination Along the Trail</h2>
        <p class="at-browse__hint">States are listed from south to north, in the order the Trail reaches them.</p>
        <div class="ola-states at-states" role="group" aria-label="States along the Trail, Georgia to Maine">
          <button type="button" class="ola-state-btn" data-state="all" aria-pressed="true">All States <span class="ola-state-btn__n">{total}</span></button>
          {
            states.map((s) => (
              <button type="button" class="ola-state-btn" data-state={s.id} aria-pressed="false">
                <span class="at-state-btn__order" aria-hidden="true">{s.order}</span>{s.state} <span class="ola-state-btn__n">{s.destinations.length}</span>
              </button>
            ))
          }
        </div>
        <div class="at-filters">
          <div class="at-filter" role="group" aria-label="Type of destination">
            <span class="at-filter__label" aria-hidden="true">Type</span>
            <button type="button" class="at-filter__btn" data-filter="kind" data-value="all" aria-pressed="true">All</button>
            <button type="button" class="at-filter__btn" data-filter="kind" data-value="accessible" aria-pressed="false">Accessible</button>
            <button type="button" class="at-filter__btn" data-filter="kind" data-value="extraordinary" aria-pressed="false">Extraordinary</button>
          </div>
          <div class="at-filter" role="group" aria-label="Ash scattering">
            <span class="at-filter__label" aria-hidden="true">Scattering</span>
            <button type="button" class="at-filter__btn" data-filter="class" data-value="all" aria-pressed="true">All</button>
            {classes.map((c) => <button type="button" class="at-filter__btn" data-filter="class" data-value={c} aria-pressed="false">{CLASS_LABEL[c]}</button>)}
          </div>
        </div>
        <p class="ola-browse__status" aria-live="polite" data-at-status>Showing all {total} destinations.</p>
        <ul class="ola-cards">
          {
            destinations.map((d) => {
              return (
                <li class="ola-card" data-state={states.find((s) => s.state === d.state)!.id} data-kind={d.category} data-class={d.scatter.classification}>
                  <a href={`#${d.id}`} class="ola-card__link">
                    <span class="ola-card__img">
                      <AtLocatorMap name={d.name} state={d.state} point={mapPoint(d)} compact />
                    </span>
                    <span class="ola-card__body">
                      <span class="ola-card__state">{d.state}</span>
                      <span class="ola-card__name">{d.name}</span>
                      <span class="ola-card__meta">
                        <span class={`ola-tag ola-tag--${d.category}`}>{kindLabel[d.category]}</span>
                        <span class={`ola-pill ola-pill--${pill(d.scatter.classification)}`}>Scattering: {CLASS_LABEL[d.scatter.classification]}</span>
                      </span>
                      <span class="ola-card__cta">View Destination</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <p class="ola-browse__empty" data-at-empty hidden>No destinations match these filters. Choose All to see every destination.</p>
      </div>
    </section>

    {
      states.map((s, si) => {
        const prev = states[si - 1];
        const next = states[si + 1];
        return (
          <section class="ola-park" id={s.id} aria-labelledby={`${s.id}-title`}>
            <div class="ola-wrap">
              <nav class="ola-statenav" aria-label={`Along the Trail from ${s.state}`}>
                <p class="ola-statenav__title">Along the Trail</p>
                <ul>
                  {prev && <li><a class="ola-statenav__btn" href={`#${prev.id}`}><span aria-hidden="true">←</span> {prev.state}</a></li>}
                  <li><span class="ola-statenav__btn is-current" aria-current="true">{s.state}</span></li>
                  {next && <li><a class="ola-statenav__btn" href={`#${next.id}`}>{next.state} <span aria-hidden="true">→</span></a></li>}
                </ul>
                <a class="ola-statenav__all" href="#at-browse">All states, Georgia to Maine</a>
              </nav>

              <p class="ola-kicker">State {s.order} of 14</p>
              <h2 id={`${s.id}-title`}>{s.heading}</h2>
              {s.intro.map((p) => <p class="ola-park__intro">{p}</p>)}
              {s.held.map((p) => <p class="ola-park__note">{p}</p>)}

              {s.destinations.length > 0 && (
                <nav class="ola-jump" aria-label={`Destinations in ${s.state}`}>
                  <span class="ola-jump__count">{s.destinations.length} {s.destinations.length === 1 ? 'destination' : 'destinations'}</span>
                  {s.destinations.map((d) => <a href={`#${d.id}`}>{d.name}</a>)}
                </nav>
              )}

              {s.destinations.map((d) => {
                  const c = d.scatter.classification;
                return (
                  <article class="ola-dest" id={d.id} aria-labelledby={`${d.id}-title`}>
                    <p class="ola-back"><a href="#at-browse" data-at-back><span class="ola-back__arrow" aria-hidden="true">↑</span>Back to State Navigation<span class="ola-back__arrow" aria-hidden="true">↑</span></a></p>
                    <header class="ola-dest__band">
                      <p class="ola-dest__park">{d.state}</p>
                      <h3 id={`${d.id}-title`} class="ola-dest__name">{d.name}</h3>
                      <p class="ola-dest__tags">
                        <span class={`ola-tag ola-tag--${d.category}`}>{kindLabel[d.category]}</span>
                        <span class={`ola-tag at-tag--${pill(c)}`}>{CLASS_LABEL[c]}</span>
                      </p>
                    </header>
                    <figure class="at-locator">
                      <div class="at-locator__map"><AtLocatorMap name={d.name} state={d.state} point={mapPoint(d)} /></div>
                      <figcaption class="at-locator__info">
                        <p class="at-locator__title">Where It Is</p>
                        {(() => {
                          const dest = d.points.find((pt) => pt.role === 'destination');
                          const th = d.points.find((pt) => pt.role === 'trailhead');
                          return (
                            <dl class="at-locator__coords">
                              <div>
                                <dt>Destination GPS</dt>
                                <dd>{dest ? <a href={mapsUrl(dest.lat, dest.lon)} rel="noopener" target="_blank">{dest.lat.toFixed(5)}, {dest.lon.toFixed(5)}<span class="visually-hidden"> ({d.name}, opens Google Maps)</span></a> : 'Not established'}</dd>
                                {dest && <dd class="at-src">{pointSource(dest)}</dd>}
                              </div>
                              <div>
                                <dt>Trailhead or Parking GPS</dt>
                                <dd>{th ? <a href={mapsUrl(th.lat, th.lon)} rel="noopener" target="_blank">{th.lat.toFixed(5)}, {th.lon.toFixed(5)}<span class="visually-hidden"> ({th.label}, opens Google Maps)</span></a> : 'Not established'}</dd>
                                {th && <dd class="at-src">{th.label}. {pointSource(th)}</dd>}
                              </div>
                            </dl>
                          );
                        })()}
                        {!d.points.some((pt) => pt.role === 'destination') && d.points.some((pt) => pt.role === 'trailhead') && (
                          <p class="at-src">The map marks the trailhead because no destination point is established.</p>
                        )}
                        <p class="at-src">Map: official Appalachian Trail centerline (National Park Service and Appalachian Trail Conservancy, 2023) on U.S. Census Bureau state boundaries.</p>
                      </figcaption>
                    </figure>

                    {d.description.map((p) => <p class="ola-dest__desc">{p}</p>)}

                    <section class="at-plan" aria-label={`Your ceremony plan: ${d.name}`}>
                      <h4 class="at-plan__title">Your Ceremony Plan</h4>
                      <div class="at-plan__grid">
                        <div class="at-plan__part">
                          <p class="at-plan__label">Remember Here</p>
                          <p>{d.ceremony}</p>
                        </div>
                        <div class="at-plan__part">
                          <p class="at-plan__label">Where to Scatter</p>
                          <p>{d.scatterPlan}</p>
                          <p class="at-plan__more">Requirements, contacts and official sources: see Scattering Rules below.</p>
                        </div>
                      </div>
                    </section>

                    <section class="ola-plan" aria-label={`Plan your adventure: ${d.name}`}>
                      <h4>Plan Your Adventure</h4>
                      <dl class="ola-plan__grid">
                        <div>
                          <dt>Round Trip</dt>
                          <dd>{d.distance !== null ? miles(d.distance) : 'Not established'}</dd>
                          {d.distance !== null && <dd class="at-src">Source: {srcShort(d.distanceSource)}</dd>}
                          {d.distance === null && !/^not established$/i.test(d.distanceSource) && <dd class="at-src">{srcShort(d.distanceSource).replace(/^Not established \((.*)\)$/, '$1')}</dd>}
                        </div>
                        <div>
                          <dt>Difficulty</dt>
                          <dd>
                            {d.difficulty ? (
                              <>
                                <span class="ola-diff__text">{d.difficulty} of 5, {d.difficultyWord}</span>
                                <span class="ola-diff" role="img" aria-label={`Difficulty ${d.difficulty} of 5, where 1 is Very Easy and 5 is Strenuous`}>
                                  <span class="ola-diff__end" aria-hidden="true">Easy</span>
                                  <span class="ola-diff__bar" aria-hidden="true">
                                    {[1, 2, 3, 4, 5].map((n) => <span class:list={['ola-diff__seg', { 'is-on': n <= d.difficulty! }]} />)}
                                  </span>
                                  <span class="ola-diff__end" aria-hidden="true">Strenuous</span>
                                </span>
                              </>
                            ) : 'Not established'}
                          </dd>
                          {d.difficultySource && <dd class="at-src">Source: {srcShort(d.difficultySource)}</dd>}
                        </div>
                        <div>
                          <dt>Elevation Gain</dt>
                          <dd>{d.elevation !== null ? ft(d.elevation) : 'Not established'}</dd>
                          {d.elevation !== null && <dd class="at-src">Source: {srcShort(d.elevationSource)}</dd>}
                        </div>
                        <div>
                          <dt>Estimated Time</dt>
                          <dd>{d.time ?? 'Not established'}</dd>
                          {d.timeSource && <dd class="at-src">Source: {srcShort(d.timeSource)}</dd>}
                        </div>
                        <div class="ola-plan__wide"><dt>Land Manager</dt><dd>{d.landManager}</dd></div>
                        {d.parking && <div class="ola-plan__wide"><dt>Parking</dt><dd>{d.parking.text}</dd><dd class="at-src">Source: {srcShort(d.parking.source)}</dd></div>}
                        {d.accessibility && <div class="ola-plan__wide"><dt>Accessibility</dt><dd>{d.accessibility}</dd></div>}
                        {d.seasonal && <div class="ola-plan__wide"><dt>Seasonal Notes</dt><dd>{d.seasonal}</dd></div>}
                        <div class={`ola-plan__wide ola-plan__scatter ola-plan__scatter--${c}`}>
                          <dt>Ash Scattering</dt>
                          <dd><span class="ola-status">{c === 'prohibited' && <span class="ola-warn ola-warn--inline"><svg class="ola-warn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2 1 21h22L12 2zm1 15h-2v2h2v-2zm0-7h-2v5h2v-5z" /></svg></span>}<span class="ola-status__text">{CLASS_LABEL[c]}</span></span></dd>
                        </div>
                        <div class="ola-plan__wide ola-plan__note">
                          <dt><span class="ola-badge-head">Scattering Rules</span></dt>
                          <dd>
                            <p>{d.scatter.conditions}</p>
                            {d.scatter.contact && <p><strong>Contact:</strong> {d.scatter.contact}</p>}
                            {d.scatter.sourceUrls.length > 0 && (
                              <p class="at-rule-links"><strong>Official rule:</strong> {d.scatter.sourceUrls.map((l) => <a href={l.url} rel="noopener" target="_blank">{l.label ?? linkLabel(l.url)}</a>)}</p>
                            )}
                            <p class="at-src">{evidence(d.scatter.evidence)}</p>
                          </dd>
                        </div>
                        <div class="ola-plan__wide">
                          <dt>Official Information</dt>
                          <dd class="at-links">
                            {d.links.length ? d.links.map((l) => <a href={l.url} rel="noopener" target="_blank">{l.label ?? linkLabel(l.url)}</a>) : 'Not established'}
                          </dd>
                        </div>
                      </dl>
                    </section>

                    <div class="ola-route">
                      <section>
                        <h4>Getting There</h4>
                        {(() => {
                          const pts = d.points.filter((pt) => pt.role !== 'destination');
                          return pts.length ? <GpsList points={pts} name={d.name} /> : <p class="at-none">Trailhead GPS coordinates: not established.</p>;
                        })()}
                        {d.parking && <p><strong>Parking:</strong> {d.parking.text}</p>}
                        <p><strong>Nearest town:</strong> {d.nearestTown ?? 'Not established'}</p>
                      </section>
                      <section>
                        <h4>On the Trail</h4>
                        {(() => {
                          const pts = d.points.filter((pt) => pt.role === 'destination');
                          return pts.length ? <GpsList points={pts} name={d.name} /> : <p class="at-none">Destination GPS coordinates: not established.</p>;
                        })()}
                        <p><strong>Route:</strong> {d.onAT ?? 'Not established'}</p>
                        {d.terrain && <p><strong>Terrain:</strong> {d.terrain}</p>}
                      </section>
                    </div>
                    <p class="at-verify">{verification[d.verification]}</p>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })
    }

    <section class="ola-park at-planning" aria-labelledby="at-planning-title">
      <div class="ola-wrap">
        <h2 id="at-planning-title">Planning the Day</h2>
        <ul class="at-planning__list">
          {intro.planning.map((t) => {
            const i = t.indexOf('.');
            return <li><strong>{t.slice(0, i + 1)}</strong>{t.slice(i + 1)}</li>;
          })}
        </ul>
        <h2>A Final Word</h2>
        {intro.finalWord.map((p) => <p class="ola-park__intro">{p}</p>)}
        <p class="ola-park__intro">
          If you are still deciding where a loved one's ashes should go, our guides to <a href="/scattering-ashes-in-us-national-parks/">scattering ashes in U.S. national parks</a> and <a href="/scattering-ashes-from-a-cruise-ship/">scattering ashes from a cruise ship</a> cover two other paths families often choose.
        </p>
      </div>
    </section>

    <footer class="ola-wrap ola-foot">
      <p>
        Distances, elevations and rules come from the land managers' published pages, labeled by source on each destination.
        Where a fact could not be confirmed it is shown as not established. GPS buttons show coordinates published by the National
        Park Service, points Funeral Funds mapped from named OpenStreetMap features (labeled as such, not official), or, where
        neither exists, the Appalachian Trail Conservancy map point. Conditions, closures and rules change: check with the
        land manager before you go.
      </p>
      <p>
        Maps: the official Appalachian National Scenic Trail centerline (National Park Service Appalachian National Scenic Trail and
        Appalachian Trail Conservancy, March 15, 2023) and U.S. Census Bureau state boundaries (us-atlas), drawn by Funeral Funds.
        Hero photo: {hero.caption}, {hero.credit} ({hero.license.name}). No claim to original U.S. Government works.
      </p>
      <p>
        This guide is not affiliated with, endorsed by or sponsored by the National Park Service, the USDA Forest Service, the Appalachian Trail Conservancy or any state agency.
      </p>
    </footer>
  </article>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-at-browse]');
  if (root) {
    const stateBtns = [...root.querySelectorAll<HTMLButtonElement>('.ola-state-btn')];
    const filterBtns = [...root.querySelectorAll<HTMLButtonElement>('.at-filter__btn')];
    const cards = [...root.querySelectorAll<HTMLElement>('.ola-card')];
    const status = root.querySelector<HTMLElement>('[data-at-status]');
    const empty = root.querySelector<HTMLElement>('[data-at-empty]');
    const sel = { state: 'all', kind: 'all', class: 'all' };
    const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const render = () => {
      stateBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.state === sel.state)));
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(sel[b.dataset.filter as 'kind' | 'class'] === b.dataset.value)));
      let shown = 0;
      cards.forEach((c) => {
        const show =
          (sel.state === 'all' || c.dataset.state === sel.state) &&
          (sel.kind === 'all' || c.dataset.kind === sel.kind) &&
          (sel.class === 'all' || c.dataset.class === sel.class);
        c.hidden = !show;
        if (show) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      if (status) {
        const all = sel.state === 'all' && sel.kind === 'all' && sel.class === 'all';
        const stateName = stateBtns.find((b) => b.dataset.state === sel.state)?.childNodes[1]?.textContent?.trim();
        status.textContent = all
          ? `Showing all ${cards.length} destinations.`
          : `Showing ${shown} of ${cards.length} destinations${sel.state !== 'all' && stateName ? ` in ${stateName}` : ''}.`;
      }
    };
    stateBtns.forEach((b) =>
      b.addEventListener('click', () => {
        sel.state = b.dataset.state!;
        render();
      }),
    );
    filterBtns.forEach((b) =>
      b.addEventListener('click', () => {
        sel[b.dataset.filter as 'kind' | 'class'] = b.dataset.value!;
        render();
      }),
    );
    render();
    document.querySelectorAll<HTMLAnchorElement>('[data-at-back]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        root.scrollIntoView({ behavior: reduce() ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', '#at-browse');
      }),
    );
  }
</script>

<style>
  .ola {
    --ola-ink: #1f2926;
    --ola-sage: #e7ece4;
    --ola-sand: #f6f2ea;
    --ola-gold: #d4a64a;
    --ola-wrap: 76rem;
    color: var(--ola-ink);
  }
  .ola img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .ola-wrap {
    max-width: var(--ola-wrap);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .ola-credit {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: var(--space-1) 0 0;
  }
  .ola-credit a {
    color: inherit;
  }

  /* Hero */
  .ola-hero {
    position: relative;
    color: #fff;
    background: #1f2926;
  }
  .ola-hero__img {
    aspect-ratio: 4 / 5;
    max-height: 80vh;
    object-position: 50% 40%;
  }
  .ola-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.05) 30%, rgb(0 0 0 / 0.7) 100%);
  }
  .ola-hero__text {
    position: absolute;
    /* Phones: room for the two-line photo credit under the subtitles. */
    inset: auto 0 var(--space-16);
    padding-inline: var(--space-4);
    max-width: var(--ola-wrap);
    margin-inline: auto;
  }
  .ola-hero__flag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: rgb(255 255 255 / 0.9);
    color: var(--color-primary);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin: 0 0 var(--space-3);
  }
  .ola-hero h1 {
    font-size: clamp(2.25rem, 1.6rem + 3.4vw, 4.25rem);
    line-height: 1.05;
    margin: 0;
    color: #fff;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.4);
  }
  .ola-hero__sub {
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.625rem);
    margin: var(--space-2) 0 0;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }
  .ola-credit--hero {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    color: rgb(255 255 255 / 0.85);
    margin: 0;
  }

  /* Intro */
  .ola-intro {
    padding-block: var(--space-12) var(--space-8);
    font-size: 1.125rem;
    line-height: 1.7;
    color: #000;
  }
  .ola-intro p {
    max-width: none;
  }
  .ola-lead {
    font-size: inherit;
    font-weight: 400;
    line-height: inherit;
  }
  .ola-intro__count {
    font-size: inherit;
  }

  /* Browse: A to Z */
  .ola-browse {
    background: var(--ola-sand);
    padding-block: var(--space-12);
    scroll-margin-top: 1rem;
  }
  .ola-browse h2,
  .ola-park h2 {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1.15;
    margin: 0 0 var(--space-4);
  }
  .ola-az {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr));
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }
  .ola-az__btn {
    min-height: var(--tap-target);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  .ola-az__btn--all {
    grid-column: span 2;
  }
  .ola-az__btn:disabled {
    color: #b3b6b4;
    background: transparent;
    border-color: transparent;
    cursor: default;
  }
  .ola-az__btn:not(:disabled):not([aria-pressed='true']):hover,
  .ola-state-btn:not([aria-pressed='true']):hover {
    background: var(--ola-sage);
  }
  .ola-az__btn[aria-pressed='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  .ola-states {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .ola-state-btn {
    min-height: var(--tap-target);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    background: #fff;
    color: var(--color-primary);
    font-weight: 600;
    cursor: pointer;
  }
  .ola-state-btn[aria-pressed='true'] {
    background: var(--color-primary);
    color: #fff;
  }
  .ola-state-btn__n {
    display: inline-block;
    min-width: 1.4em;
    margin-left: 0.25rem;
    border-radius: 999px;
    background: var(--ola-sage);
    color: var(--color-primary);
    font-size: 0.8125rem;
  }
  .ola-browse__status {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: var(--space-2) 0 var(--space-4);
  }
  .ola-cards {
    display: grid;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ola-card[hidden] {
    display: none;
  }
  .ola-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
    transition: box-shadow 0.15s;
  }
  .ola-card__link:hover {
    box-shadow: 0 8px 22px rgb(0 0 0 / 0.16);
  }
  .ola-card__img img {
    aspect-ratio: 16 / 10;
  }
  .ola-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    flex: 1;
  }
  .ola-card__state {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .ola-card__name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .ola-card__tag {
    line-height: 1.5;
  }
  .ola-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
  .ola-card__cta {
    margin-top: auto;
    padding-top: var(--space-3);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
  }
  .ola-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }
  .ola-pill--yes {
    background: #dcebdc;
    color: #1d4d2b;
  }
  .ola-pill--check {
    background: #ececec;
    color: #3d4442;
  }
  .ola-pill--no {
    background: #f7e1dc;
    color: #8a2412;
  }

  /* Park sections */
  .ola-park {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 0.5rem;
  }
  .ola-statenav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-4);
  }
  .ola-statenav__title {
    margin: 0;
    font-weight: 700;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ola-statenav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ola-statenav__btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-4);
    border-radius: 999px;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .ola-statenav__btn:hover,
  .ola-statenav__btn.is-current {
    background: var(--color-primary);
    color: #fff;
  }
  .ola-statenav__all {
    margin-left: auto;
    font-weight: 600;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
  }
  .ola-park__hero {
    margin: 0 0 var(--space-6);
  }
  .ola-park__hero img {
    aspect-ratio: 16 / 9;
    max-height: 34rem;
    border-radius: 0.75rem;
  }
  .ola-park__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .ola-kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-1);
  }
  /* One body size (1.125rem, black) for park introductions, Before You Go,
     destination descriptions and route text (Version 4.0). */
  .ola-park__intro,
  .ola-park__note,
  .ola-dest__desc,
  .ola-route p,
  .ola-steps,
  .ola-note {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #000;
  }
  .ola-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0;
  }
  .ola-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: 600;
  }
  /* Ash scattering panels: brand green, white text, gold accent (a lighter
     tint of the site gold #b68a35, for 4.5:1 contrast on the green). */
  .ola-scatter {
    background: #173f35;
    color: #fff;
    border-top: 4px solid var(--ola-gold);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-6);
  }
  .ola-scatter h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.25rem;
    color: var(--ola-gold);
  }
  /* Scattering text at the body size: the determination bold, the
     explanation, notes and bullets regular, source headings bold. */
  .ola-scatter__summary,
  .ola-scatter__note,
  .ola-scatter ul,
  .ola-warn {
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .ola-scatter__summary {
    font-weight: 400;
  }
  .ola-scatter__summary strong,
  .ola-scatter li strong {
    font-weight: 700;
  }
  .ola-scatter--no h3 {
    color: #fff;
  }
  .ola-scatter--no .ola-scatter__note {
    color: #ffeb3b;
  }
  .ola-scatter a {
    color: #fff;
  }
  .ola-scatter a:hover {
    color: var(--ola-gold);
  }
  .ola-warn {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: #b91c1c;
    color: #fff;
    font-weight: 700;
    line-height: 1.4;
  }
  .ola-warn__icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.05rem;
  }
  .ola-warn--inline {
    display: inline-flex;
    vertical-align: -0.3rem;
    margin: 0 var(--space-2) 0 0;
    padding: 0.2rem;
  }
  .ola-warn--inline .ola-warn__icon {
    width: 1rem;
    height: 1rem;
    margin: 0;
  }
  .ola-scatter ul {
    overflow-wrap: break-word;
    padding-left: 1.25rem;
    margin: var(--space-2) 0;
  }
  .ola-scatter li + li {
    margin-top: var(--space-1);
  }
  .ola-scatter__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 0;
    font-weight: 700;
  }
  .ola-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin: var(--space-8) 0 var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .ola-jump__count,
  .ola-jump a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding: 0.25rem 0.9rem;
    border-radius: 999px;
    background: #173f35;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .ola-jump__count {
    font-weight: 700;
  }
  .ola-jump a:hover {
    background: #0e2d26;
    color: #fff;
    text-decoration: underline;
  }

  /* Destinations */
  .ola-dest {
    margin-bottom: var(--space-8);
    scroll-margin-top: 0.5rem;
  }
  /* Separator between consecutive destinations. */
  .ola-dest + .ola-dest {
    border-top: 2px solid #c9d3cd;
    padding-top: var(--space-8);
  }
  .ola-dest > :last-child {
    margin-bottom: 0;
  }
  .ola-dest__band {
    background: #173f35;
    color: #fff;
    text-align: center;
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-radius: 0.75rem 0.75rem 0 0;
  }
  .ola-dest__band + .ola-dest__photo img {
    border-radius: 0 0 0.75rem 0.75rem;
  }
  .ola-dest__photo {
    margin: 0;
  }
  .ola-dest__photo img {
    aspect-ratio: 16 / 9;
    max-height: 36rem;
    border-radius: 0.75rem;
  }
  .ola-card__img .ola-dest__placeholder {
    aspect-ratio: 16 / 10;
    border-radius: 0;
  }
  .ola-dest__placeholder {
    aspect-ratio: 16 / 7;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, #dfe6dc, #eee8dc);
    color: var(--color-primary);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .ola-dest__park {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ola-gold);
  }
  .ola-dest__name {
    font-size: clamp(1.875rem, 1.4rem + 1.8vw, 2.75rem);
    line-height: 1.15;
    margin: var(--space-1) 0 0;
    color: #fff;
  }
  .ola-dest__tags {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
  }
  .ola-dest__desc {
    margin-top: var(--space-4);
  }
  .ola-dest__desc {
    text-align: left;
  }
  .ola-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--ola-sage);
    color: var(--color-primary);
  }
  .ola-tag--extraordinary {
    background: #f3e6cc;
    color: #6b4a0e;
  }
  .ola-dest h4 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin: 0 0 var(--space-3);
  }

  /* Plan Your Adventure panel */
  .ola-plan {
    margin-top: var(--space-6);
    background: #fcfcfa;
    border: 2px solid #173f35;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .ola-plan__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: #8fa197;
    margin: 0;
  }
  .ola-plan__grid > div {
    background: #fcfcfa;
    padding: var(--space-2) var(--space-3);
  }
  .ola-dest .ola-plan h4 {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: #173f35;
    color: #fff;
    text-align: center;
    font-size: 1.5rem;
    letter-spacing: 0.06em;
  }
  .ola-plan__grid > div {
    text-align: center;
  }
  .ola-plan dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #000;
    font-weight: 700;
  }
  .ola-plan dd {
    color: #000;
    margin: 0.15rem 0 0;
    font-weight: 600;
    line-height: 1.45;
  }
  .ola-plan dd > .ola-diff:first-child {
    margin-top: 0.35rem;
  }
  .ola-plan__note dd {
    font-weight: 400;
    text-align: left;
    max-width: 60rem;
    margin-inline: auto;
  }
  .ola-plan__note dd p {
    margin: var(--space-1) 0 var(--space-2);
  }
  .ola-plan__note .ola-gps {
    margin-bottom: var(--space-1);
  }
  .ola-plan dd a.ola-gps__btn {
    display: flex;
    min-height: var(--tap-target);
    margin-right: 0;
  }
  .ola-badge-head {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius);
    background: #173f35;
    color: #ffeb3b;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
  }
  .ola-route h4 {
    text-align: center;
  }
  .ola-plan dd a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    margin-right: var(--space-4);
  }
  /* Scattering status: a compact green badge (not a link). */
  .ola-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius);
    background: #173f35;
    color: #ffeb3b;
    font-weight: 400;
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .ola-status .ola-warn--inline {
    margin: 0;
  }
  .ola-status {
    max-width: 100%;
    text-wrap: pretty;
  }
  .ola-status__text {
    min-width: 0;
  }
  .ola-status__line {
    display: block;
  }

  /* Back to State Navigation (between destinations) */
  /* Site gold (--home-gold, #b68a35) with black text; at the top of each
     destination, after the separator and above its green header. */
  .ola-back {
    margin: 0 0 var(--space-4);
    text-align: center;
  }
  .ola-back a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    min-height: var(--tap-target);
    padding: 0.4rem 1.25rem;
    border-radius: 999px;
    background: #b68a35;
    color: #000;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .ola-back__arrow {
    font-weight: 700;
    color: #000;
  }
  .ola-back a:hover {
    filter: brightness(0.92);
    color: #000;
  }
  .ola-back a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Directions */
  .ola-route {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .ola-diff {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .ola-diff__bar {
    display: inline-flex;
    gap: 3px;
  }
  .ola-diff__seg {
    width: 1.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: #fff;
    border: 1px solid #b8b3a7;
  }
  .ola-diff__seg.is-on {
    background: #173f35;
    border-color: #173f35;
  }
  .ola-diff__seg.is-range {
    border-color: #173f35;
    background: repeating-linear-gradient(135deg, #173f35 0 2px, #fff 2px 5px);
  }
  .ola-route__trail {
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }
  .ola-steps {
    padding-left: 1.4rem;
    margin: 0 0 var(--space-3);
  }
  .ola-steps li + li {
    margin-top: var(--space-1);
  }


  /* GPS buttons: one solid black link holding the pin, label and coordinates */
  .ola-route :global(.ola-gps) {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    display: grid;
    gap: var(--space-2);
  }
  .ola-route :global(.ola-gps__btn) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem var(--space-3);
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    background: #173f35;
    color: #fff;
    text-decoration: none;
    line-height: 1.3;
  }
  .ola-route :global(.ola-gps__btn:hover) {
    background: #0e2d26;
    color: #fff;
  }
  .ola-route :global(.ola-gps__btn:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px #fff inset;
  }
  .ola-route :global(.ola-gps__pin) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: #fff;
  }
  .ola-route :global(.ola-gps__label) {
    font-weight: 700;
    color: #fff;
  }
  .ola-route :global(.ola-gps__coord) {
    color: #fff;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  .ola-foot {
    padding-block: var(--space-8) var(--space-12);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .ola-foot p {
    max-width: 50rem;
  }

