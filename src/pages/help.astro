---
// /help/: the confirmation page after a lead form submission (Randy, /help/
// redesign V1.0, November 2026). Every form (website and /facebook/) lands
// here; it confirms the request, asks the visitor to call Randy now on the
// website number, and shows the 4-IN-1 Funeral Funds Commitment followed by
// a second call CTA (V2.0, replacing "Prefer to Wait?"). Standalone
// like /free-quote/ (landing layout: a slim branded header, no site
// navigation, pre-footer or site footer; the sticky mobile call bar stays).
//
// Tracking is unchanged: src/scripts/tracking.ts fires GA4 generate_lead and
// Meta Lead here only when the one-time flag set after Formspark's
// confirmation is present (keyed on lead.formspark.successPath, not on this
// markup), and GA4 click_to_call on taps of tel:8888629456.
//
// The SEO head (title, robots, social tags, JSON-LD) is the migrated
// WordPress page's, unchanged; noindex keeps it out of the sitemap
// (astro.config.mjs), llms.txt and site search.
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeaderPhone from '@/components/HeaderPhone.astro';
import { PAGE_PHONES } from '@/config/phones';
import { site } from '@/config/site';
import { footerDisclaimer } from '@/lib/footer-notes';

const phone = PAGE_PHONES.default;
const notes = site.footer.notes;

// Randy's exact wording and order (V1.0).
const commitment = [
  'Lifetime Policy Service & Updates',
  'Family Death Claim Assistance',
  'One Personal Agent for Life',
  'Direct Agent Cell Phone Access',
];

const title = "Thank You | Funeral Funds";
const robots = "follow, noindex";
const headMeta = [{"property":"og:locale","content":"en_US"},{"property":"og:type","content":"article"},{"property":"og:title","content":"Thank You | Funeral Funds"},{"property":"og:description","content":"Thank you! Your request was received. Randy will get back with you, or you can call him now at 888-862-9456."},{"property":"og:url","content":"https://funeralfunds.com/help/"},{"property":"og:site_name","content":"Funeral Funds"},{"property":"og:updated_time","content":"2026-09-11T08:57:18-05:00"},{"property":"article:published_time","content":"2025-10-13T06:13:17-05:00"},{"property":"article:modified_time","content":"2026-09-11T08:57:18-05:00"},{"name":"twitter:card","content":"summary_large_image"},{"name":"twitter:title","content":"Thank You | Funeral Funds"},{"name":"twitter:description","content":"Thank you! Your request was received. Randy will get back with you, or you can call him now at 888-862-9456."},{"name":"twitter:label1","content":"Time to read"},{"name":"twitter:data1","content":"Less than a minute"}];
const jsonLd = ["{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://funeralfunds.com/#organization\",\"name\":\"Funeral Funds\",\"url\":\"https://funeralfunds.com\",\"logo\":{\"@type\":\"ImageObject\",\"@id\":\"https://funeralfunds.com/#logo\",\"url\":\"https://funeralfunds.com/images/logo/funeral-funds-logo.png\",\"contentUrl\":\"https://funeralfunds.com/images/logo/funeral-funds-logo.png\",\"caption\":\"Funeral Funds\",\"inLanguage\":\"en-US\",\"width\":\"1986\",\"height\":\"433\"}},{\"@type\":\"WebSite\",\"@id\":\"https://funeralfunds.com/#website\",\"url\":\"https://funeralfunds.com\",\"name\":\"Funeral Funds\",\"publisher\":{\"@id\":\"https://funeralfunds.com/#organization\"},\"inLanguage\":\"en-US\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://funeralfunds.com/help/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":\"1\",\"item\":{\"@id\":\"https://funeralfunds.com\",\"name\":\"Home\"}},{\"@type\":\"ListItem\",\"position\":\"2\",\"item\":{\"@id\":\"https://funeralfunds.com/help/\",\"name\":\"Thank You\"}}]},{\"@type\":\"WebPage\",\"@id\":\"https://funeralfunds.com/help/#webpage\",\"url\":\"https://funeralfunds.com/help/\",\"name\":\"Thank You | Funeral Funds\",\"datePublished\":\"2025-10-13T06:13:17-05:00\",\"dateModified\":\"2026-09-11T08:57:18-05:00\",\"isPartOf\":{\"@id\":\"https://funeralfunds.com/#website\"},\"inLanguage\":\"en-US\",\"breadcrumb\":{\"@id\":\"https://funeralfunds.com/help/#breadcrumb\"}},{\"@type\":\"Person\",\"@id\":\"https://funeralfunds.com/author/rvanderv8/\",\"name\":\"Funeral Funds\",\"url\":\"https://funeralfunds.com/author/rvanderv8/\",\"image\":{\"@type\":\"ImageObject\",\"@id\":\"https://secure.gravatar.com/avatar/6c2b5808968ca3dac4835c35ea01d5bf7da74269c97eef788fabb1d048328e42?s=96&amp;d=mm&amp;r=g\",\"url\":\"https://secure.gravatar.com/avatar/6c2b5808968ca3dac4835c35ea01d5bf7da74269c97eef788fabb1d048328e42?s=96&amp;d=mm&amp;r=g\",\"caption\":\"Funeral Funds\",\"inLanguage\":\"en-US\"},\"worksFor\":{\"@id\":\"https://funeralfunds.com/#organization\"}},{\"headline\":\"Thank You | Funeral Funds\",\"datePublished\":\"2025-10-13T06:13:17-05:00\",\"dateModified\":\"2026-09-11T08:57:18-05:00\",\"author\":{\"@id\":\"https://funeralfunds.com/author/rvanderv8/\",\"name\":\"Funeral Funds\"},\"@type\":\"Article\",\"name\":\"Thank You | Funeral Funds\",\"@id\":\"https://funeralfunds.com/help/#schema-715793\",\"isPartOf\":{\"@id\":\"https://funeralfunds.com/help/#webpage\"},\"publisher\":{\"@id\":\"https://funeralfunds.com/#organization\"},\"inLanguage\":\"en-US\",\"mainEntityOfPage\":{\"@id\":\"https://funeralfunds.com/help/#webpage\"}}]}"];
---

<BaseLayout
  title={title}
  robots={robots}
  noindex={true}
  canonical="/help/"
  headMeta={headMeta}
  jsonLd={jsonLd}
  layout="landing"
  preFooter={false}
  bodyClass="page-help"
>
  <div class="hp" data-page-type="utility" data-page-reason="Thank-you page after a quote request.">
    <div class="hp-top">
      <div class="container hp-top__inner">
        <a class="hp-top__home" href="/" aria-label="Funeral Funds Home">
          <img
            class="hp-top__logo"
            src="/images/logo/funeral-funds-wordmark-800.webp"
            srcset="/images/logo/funeral-funds-wordmark-400.webp 400w, /images/logo/funeral-funds-wordmark-800.webp 800w"
            sizes="14rem"
            width="1987"
            height="285"
            alt="Funeral Funds"
            fetchpriority="high"
          />
        </a>
        <HeaderPhone phone={phone} />
      </div>
    </div>

    <section class="hp-hero" aria-labelledby="hp-title">
      <div class="container hp-hero__inner">
        <p class="hp-hero__received">
          <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 10.5l3.5 3.5 7.5-8" />
          </svg>
          <span>Your Request Was Received!</span>
        </p>
        <h1 class="hp-hero__title" id="hp-title">Get Your Life Insurance Answers Now.</h1>
        <p class="hp-hero__lede">
          You don’t have to wait for a callback to review your options.
        </p>
        <div class="hp-call">
          <a class="btn hp-call__btn" href={phone.href}>CALL FUNERAL FUNDS NOW</a>
          <a class="hp-call__number" href={phone.href} aria-label={`Call ${phone.display}`}>{phone.display}</a>
          <p class="hp-call__note">Speak directly with Randy, your licensed independent agent.</p>
        </div>
      </div>
    </section>

    <section class="hp-commit" aria-labelledby="hp-commit-title">
      <div class="container">
        <div class="hp-commit__card">
          <h2 class="hp-commit__title" id="hp-commit-title">4-IN-1 FUNERAL FUNDS COMMITMENT</h2>
          <ul class="hp-commit__list" role="list">
            {
              commitment.map((item) => (
                <li>
                  <svg class="hp-commit__check" aria-hidden="true" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.5 10.5l3.5 3.5 7.5-8" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="hp-call hp-call--bottom">
          <a class="hp-call__number hp-call__number--green" href={phone.href} aria-label={`Call ${phone.display}`}>{phone.display}</a>
          <a class="btn hp-call__btn" href={phone.href}>CALL FUNERAL FUNDS NOW</a>
        </div>
      </div>
    </section>

    <footer class="hp-foot">
      <div class="container">
        <ul class="hp-foot__links" role="list">
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-of-use/">Terms of Use</a></li>
          <li><a href="/licenses/">Licenses</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
        <div class="hp-foot__notes"><p class="hp-foot__disclaimer" set:html={footerDisclaimer(notes)} /></div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  body.page-help {
    --home-cream: #f7f3e8;
    --home-radius: 0.375rem;
  }
  body.page-help .btn {
    text-align: center;
  }
  /* The site's orange conversion button, as on /facebook/ and /free-quote/. */
  .hp-call__btn {
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-6);
    background: var(--color-cta);
    color: var(--color-on-cta);
    font-size: 1.1875rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    white-space: normal;
  }
  .hp-call__btn:hover {
    background: var(--color-cta);
    color: var(--color-on-cta);
    filter: brightness(0.9);
  }
</style>

<style>

  /* Slim branded header (same as /free-quote/): logo home, website number. */
  .hp-top {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .hp-top__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .hp-top__home {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }
  .hp-top__logo {
    width: 8rem;
    height: auto;
  }

  /* Green hero: confirmation, headline, number, orange call button. */
  .hp-hero {
    --color-focus: #ffffff;
    --color-focus-inner: var(--color-text);
    background: var(--color-primary);
    color: #ffffff;
    padding-block: var(--space-8);
  }
  .hp-hero__inner {
    max-width: 40rem;
    text-align: center;
  }
  .hp-hero__received {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: #ffffff;
  }
  .hp-hero__received svg {
    flex: none;
  }
  .hp-hero__title {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.875rem, 1.35rem + 2.2vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #ffffff;
  }
  .hp-hero__lede {
    margin: 0 auto var(--space-6);
    max-width: 34rem;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--home-cream);
  }
  .hp-call {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    max-width: 28rem;
    margin-inline: auto;
  }
  .hp-call__number {
    display: block;
    min-height: var(--tap-target);
    font-size: clamp(2.25rem, 1.7rem + 2.4vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-decoration: none;
    white-space: nowrap;
  }
  .hp-call__note {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--home-cream);
  }

  /* Cream band: the white 4-IN-1 Commitment card, then the second call CTA. */
  .hp-commit {
    padding-block: var(--space-8);
    background: var(--home-cream);
  }
  .hp-commit__card {
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--home-radius);
  }
  .hp-commit__title {
    margin: 0 0 var(--space-4);
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-align: center;
    color: var(--color-primary);
  }
  .hp-commit__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .hp-commit__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .hp-commit__check {
    flex: none;
    margin-top: 0.1em;
    color: var(--color-primary);
  }
  /* Second call CTA under the Commitment card (V2.0): the hero's number
     (in green on cream) and orange button, centered, same sizes. */
  .hp-call--bottom {
    margin-top: var(--space-6);
    text-align: center;
  }
  .hp-call__number--green {
    color: var(--color-primary);
  }

  /* Compact footer (as on /free-quote/): legal links and the disclaimer. */
  .hp-foot {
    padding-block: var(--space-6) calc(var(--space-6) + var(--call-sticky-h, 0px));
    background: var(--color-bg);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .hp-foot__links {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
  }
  .hp-foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--color-primary);
    font-weight: 700;
  }
  .hp-foot__disclaimer {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @media (min-width: 24rem) {
    .hp-top__logo {
      width: 10.5rem;
    }
  }
  @media (min-width: 48rem) {
    .hp-top__logo {
      width: 14rem;
    }
    .hp-commit__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
    .hp-commit__card {
      padding: var(--space-6) var(--space-8);
    }
  }
  @media (min-width: 64rem) {
    .hp-hero {
      padding-block: var(--space-12);
    }
    .hp-commit {
      padding-block: var(--space-12);
    }
  }
</style>
