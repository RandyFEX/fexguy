---
// Facebook ad landing page (Randy, October 2026). Phone-first: every call link
// uses the campaign number (src/config/phones.ts, "ctv"), which is allowed only
// here and on /roku/ (CLAUDE.md, "Phone"). Landing layout: no site header,
// navigation, pre-footer or site footer; the sticky mobile call bar stays.
// Reuses the homepage's review highlights and Meet Randy sections.
// Apply Now handoff (Randy, November 2026): /free-quote/ Apply Now opens this
// page for a phone-assisted application; with a valid handoff
// (src/scripts/quote-handoff.ts) the hero shows "Your Selected Coverage".
// The old short callback form and its "Prefer a Callback?" block were removed.
// noindex, follow; kept out of the sitemap, llms.txt and site search.
//
// V1.2 (Randy): burial insurance headline, callback band linking to the form,
// two-line starting-rate note, tighter spacing. V1.3: checkmark wording and
// order, solid callback button, smaller gap before Meet Randy, title and
// description. V1.5: headline "That Can Start Today!", one-sentence rate
// disclosure, no $2/day offer. V1.6: the disclosure moves under the callback
// button (gray fine print); less green under the phone number. V1.4: disclosure back under the phone number (call bar waits
// until it scrolls away), centered hero, full-size callback button, three-row
// short form.
//
// GA4: page views as everywhere; the body class `track-page-calls` makes
// src/scripts/tracking.ts count taps on this page's call links as
// click_to_call (never a Meta Lead). Arriving here (Apply Now or directly)
// is never a GA4 generate_lead or Meta Lead. Phone number by source: the
// campaign number for Facebook/Instagram ad visits, the main website number
// otherwise. The HTML carries the main number (the fallback without
// JavaScript or if the page script fails); the page script switches known
// ad visitors to the campaign number held in data-campaign-phone.
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeaderPhone from '@/components/HeaderPhone.astro';
import HeaderLogo from '@/components/HeaderLogo.astro';
import ReviewHighlights from '@/components/home/ReviewHighlights.astro';
import MeetRandy from '@/components/home/MeetRandy.astro';
import { PAGE_PHONES, SMS_NUMBER, withPagePhone } from '@/config/phones';
import { site } from '@/config/site';
import { footerDisclaimer } from '@/lib/footer-notes';

// Main number by default; the campaign number is applied by the page script
// for Facebook/Instagram ad visits only (Randy, November 2026).
const phone = PAGE_PHONES.default;
const campaignPhone = PAGE_PHONES.ctv;
const notes = site.footer.notes.map((html) => withPagePhone(html, 'default'));

const title = 'Burial Insurance Quotes | Funeral Funds';
const description = 'Compare affordable burial insurance options for ages 50-85. No medical exam required. Call Funeral Funds for your free quote.';
const url = 'https://funeralfunds.com/facebook/';
const headMeta = [
  { property: 'og:locale', content: 'en_US' },
  { property: 'og:type', content: 'website' },
  { property: 'og:title', content: title },
  { property: 'og:description', content: description },
  { property: 'og:url', content: url },
  { property: 'og:site_name', content: 'Funeral Funds' },
  { name: 'twitter:card', content: 'summary' },
  { name: 'twitter:title', content: title },
  { name: 'twitter:description', content: description },
];

// "Why Families Choose Funeral Funds Coverage" (Randy, V11.0, November
// 2026; shorter headings and two statements trimmed by Randy after V12.0):
// four cards, his exact headings, wording and order (2-by-2 from 48rem;
// stacked in this order on phones).
const advantage = [
  {
    id: 'fb-adv-advantage',
    title: '4-IN-1 ADVANTAGE',
    items: [
      'Compare Rates From Many Companies',
      'Get Coverage That Fits Your Budget',
      'Get Matched With the Right Company',
      'You get 30 Days to Review Your Coverage',
    ],
  },
  {
    id: 'fb-adv-protection',
    title: '4-IN-1 PROTECTION',
    items: [
      '1st-Day Coverage for Eligible Applicants',
      'Accident, Illness & Disease Death Covered',
      'No Requalification Ever Required',
      'Unaffected by Rising Costs',
    ],
  },
  {
    id: 'fb-adv-benefits',
    title: '4-IN-1 BENEFITS',
    items: [
      'Pays for Burial, Cremation, Funeral, or Bills',
      'Coverage Never Expires',
      'Rates Never Increase',
      'Options to Add More Coverage Later',
    ],
  },
  {
    id: 'fb-adv-commitment',
    title: '4-IN-1 COMMITMENT',
    items: [
      'One Personal Agent for Life',
      'Direct Agent Cell Phone Access',
      'Lifetime Policy Service & Updates',
      'Family Death Claim Assistance',
    ],
  },
];---

<BaseLayout
  title={title}
  description={description}
  robots="noindex, follow"
  canonical="/facebook/"
  headMeta={headMeta}
  layout="landing"
  bodyClass="page-fb track-page-calls"
>
  <div class="fb" data-campaign-phone={campaignPhone.href} data-page-type="sales" data-page-reason="Facebook ad landing page (noindex, campaign phone number).">
    <!-- Phone numbers stay hidden until the page script sets the right one for
         this visitor (no wrong number shows or can be tapped while loading).
         If that script never runs, the main number shows after 3 seconds;
         without JavaScript it shows at once. -->
    <script is:inline>document.documentElement.classList.add('fb-phone-pending');setTimeout(function(){document.documentElement.classList.remove('fb-phone-pending')},3000);</script>
    <div class="fb-top">
      <div class="container fb-top__inner">
        <HeaderLogo>
          <img
            class="fb-top__logo"
            src="/images/logo/funeral-funds-wordmark-800.webp"
            srcset="/images/logo/funeral-funds-wordmark-400.webp 400w, /images/logo/funeral-funds-wordmark-800.webp 800w"
            sizes="14rem"
            width="1987"
            height="285"
            alt="Funeral Funds"
            fetchpriority="high"
          />
        </HeaderLogo>
        <HeaderPhone phone={phone} />
      </div>
    </div>

    <section class="fb-hero" aria-labelledby="fb-title">
      <div class="container fb-hero__inner">
        <h1 class="fb-hero__title" id="fb-title">Here's What You Selected</h1>
        <!-- Texting page V1.1: shown with the selected quote (below) only. -->
        <p class="fb-hero__reassure" data-fb-reassure hidden>Don't worry, you can always adjust these amounts later.</p>
        <!-- Offer countdown (V2.0): only with a valid quote handoff; 2:00 from the
             first time this visit reaches this screen (src/scripts/quote-offer.ts). -->
        <p class="fb-offer" data-fb-offer hidden>Please respond within: <span class="fb-offer__time" role="timer" data-fb-offer-time>2:00</span></p>
        <button class="btn fb-offer__restart" type="button" data-fb-offer-restart hidden>Start New Quote</button>
        <!-- The quote selected on /free-quote/ (Apply Now), shown only with a valid,
             recent handoff (src/scripts/quote-handoff.ts); hidden otherwise. -->
        <div class="fb-quote" data-fb-quote hidden>
          <dl class="fb-quote__grid">
            <div><dt>Your Selected Coverage</dt><dd data-fb-quote-coverage></dd></div>
            <div><dt>Estimated Monthly Rate</dt><dd data-fb-quote-premium></dd></div>
          </dl>
          <p class="fb-quote__note">Your final premium and coverage are subject to insurance company approval.</p>
        </div>
        <!-- Two-option SMS handoff V1.9 (Randy, November 2026): the cell phone
             button opens the visitor's own messaging app with the prewritten
             text (src/scripts/sms-link.js) to SMS_NUMBER (src/config/phones.ts);
             the computer button reveals a QR code with the same number and text.
             Nothing is sent until the visitor presses Send. -->
        <div class="fb-call fb-text-options">
          <div class="fb-text-opt">
            <a class="btn fb-text__btn" data-fb-text aria-disabled={SMS_NUMBER ? undefined : 'true'}>
              <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
              <span>CLICK HERE IF YOU'RE<br />ON A CELL PHONE</span>
            </a>
            <p class="fb-text__note">Click the button above to generate an SMS text and hit Send.</p>
          </div>
          <div class="fb-text-opt">
            <button class="btn fb-text__btn" type="button" data-fb-qr-btn aria-controls="fb-qr" aria-expanded="false" disabled={SMS_NUMBER ? undefined : true}>
              <svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="3.5" width="19" height="13" rx="1.5" /><path d="M8 20.5h8M12 16.5v4" /></svg>
              <span>CLICK HERE IF YOU'RE<br />ON A COMPUTER</span>
            </button>
            <p class="fb-text__note">Scan our code with your cell phone camera to send a text.</p>
            <div class="fb-qr" id="fb-qr" data-fb-qr hidden>
              <div class="fb-qr__code" data-fb-qr-code role="img" aria-label="QR code that opens your prepared text"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="fb-advantage" aria-labelledby="fb-advantage-title">
      <div class="container">
        <h2 class="fb-section-title fb-advantage__title" id="fb-advantage-title">Why Families Choose Funeral Funds Coverage</h2>
        <p class="fb-advantage__subtitle">Affordable Options. Generous Coverage. Lifetime Protection. Personal Service.</p>
        <div class="fb-advantage__grid">
          {
            advantage.map((card) => (
              <div class="fb-adv-card">
                <h3 class="fb-adv-card__title" id={card.id}>{card.title}</h3>
                <ul class="fb-adv-card__list" role="list" aria-labelledby={card.id}>
                  {card.items.map((item) => (
                    <li>
                      <svg class="fb-adv-card__check" aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4.5 10.5l3.5 3.5 7.5-8" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="fb-exam">
          <h3 class="fb-exam__title">No Medical Exam Required</h3>
          <p>There’s no medical exam. First-day coverage is available if you meet the plan’s health requirements.</p>
        </div>
        <p class="fb-rates-note">Rates vary by age, health, and coverage.</p>
      </div>
    </section>

    <section class="fb-callback" aria-label="Call Randy">
      <div class="container fb-callback__inner">
        <div class="fb-callback__grid">
          <div class="fb-call fb-call--center fb-callback__call">
            <a class="fb-call__number fb-call__number--dark" href={phone.href} aria-label={`Call ${phone.display}`}>{phone.display}</a>
            <a class="btn fb-call__btn" href={phone.href}>CALL NOW TO COMPLETE YOUR APPLICATION</a>
          </div>
        </div>
      </div>
    </section>

    <ReviewHighlights />

    <section class="fb-band" aria-label="Call Randy">
      <div class="container fb-band__inner">
        <p class="fb-band__text">Have questions? Talk with Randy directly.</p>
        <div class="fb-call fb-call--center">
          <a class="btn fb-call__btn" href={phone.href}>CALL NOW TO COMPLETE YOUR APPLICATION</a>
          <a class="fb-call__number fb-call__number--dark" href={phone.href} aria-label={`Call ${phone.display}`}>{phone.display}</a>
        </div>
      </div>
    </section>

    <MeetRandy>
      <p slot="extra">
        With over a decade of experience, Randy helps you before and after you buy your policy. You can verify his
        licensing with his National Producer Number (NPN), 17792459, on{' '}
        <a href="/licenses/">his licenses page</a>.
      </p>
      <Fragment slot="action" />
    </MeetRandy>

    <section class="fb-final" aria-labelledby="fb-final-title">
      <div class="container fb-final__inner">
        <h2 class="fb-final__title" id="fb-final-title">Get Your Free Quote Today</h2>
        <p class="fb-final__text">Free, friendly, no-pressure conversation with an independent agent.</p>
        <div class="fb-call fb-call--center">
          <a class="btn fb-call__btn" href={phone.href}>CALL NOW TO COMPLETE YOUR APPLICATION</a>
          <a class="fb-call__number" href={phone.href} aria-label={`Call ${phone.display}`}>{phone.display}</a>
        </div>
      </div>
    </section>

    <footer class="fb-foot">
      <div class="container">
        <ul class="fb-foot__links" role="list">
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-of-use/">Terms of Use</a></li>
          <li><a href="/licenses/">Licenses</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
        <div class="fb-foot__notes"><p class="fb-foot__disclaimer" set:html={footerDisclaimer(notes)} /></div>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import { readHandoff } from '@/scripts/quote-handoff';
  import { offerExpiresAt, restartQuote, runCountdown } from '@/scripts/quote-offer';
  import { preparePreviewApply, previewRequest } from '@/scripts/quote-preview';
  import { isFacebookAdVisit, recordVisit } from '@/scripts/lead-source';
  import { lead } from '@/config/lead';
  import { SMS_NUMBER as SMS } from '@/config/phones';
  import { isIOS, prewrittenText, qrPayload, smsHref } from '@/scripts/sms-link.js';

  // Phone number by traffic source (Randy, November 2026): the page is built
  // with the main website number (also the fallback without JavaScript);
  // Facebook/Instagram ad visitors are switched to the campaign number in
  // every visible number, tel: link and label.
  recordVisit();
  // The campaign number is read from this page's HTML (data-campaign-phone;
  // it lives only in this page's HTML, never in a script).
  const fmt = (href: string) => {
    const d = href.replace(/\D/g, '').slice(-10);
    return { href: `tel:${d}`, display: `${d.slice(0, 3)}-${d.slice(3, 6)}-${d.slice(6)}`, paren: `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}` };
  };
  const campaignHref = document.querySelector('[data-campaign-phone]')?.getAttribute('data-campaign-phone') ?? '';
  if (isFacebookAdVisit() && /^tel:\d{10}$/.test(campaignHref) && campaignHref !== lead.phone.href) {
    const from = fmt(lead.phone.href), to = fmt(campaignHref);
    const swap = (t: string) => t.replaceAll(from.paren, to.paren).replaceAll(from.display, to.display);
    for (const a of document.querySelectorAll<HTMLAnchorElement>(`a[href="${from.href}"]`)) {
      a.href = to.href;
      const label = a.getAttribute('aria-label');
      if (label) a.setAttribute('aria-label', swap(label));
    }
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
      if (n.nodeValue && (n.nodeValue.includes(from.display) || n.nodeValue.includes(from.paren))) n.nodeValue = swap(n.nodeValue);
    }
    document.body.dataset.phoneSource = 'facebook-ad';
  } else {
    document.body.dataset.phoneSource = 'website';
  }
  document.documentElement.classList.remove('fb-phone-pending');

  // Apply Now from /free-quote/: show the selected coverage and server-priced
  // estimate. Missing, stale or invalid data keeps the summary hidden.
  // Direct preview access (preview and local builds only): ?preview=apply
  // first saves the fixed sample's selection (src/scripts/quote-preview.ts).
  const showSelectedQuote = () => {
  const handoff = readHandoff();
  const quoteBox = document.querySelector<HTMLElement>('[data-fb-quote]');
  const coverageOut = quoteBox?.querySelector<HTMLElement>('[data-fb-quote-coverage]');
  const premiumOut = quoteBox?.querySelector<HTMLElement>('[data-fb-quote-premium]');
  if (handoff && quoteBox && coverageOut && premiumOut) {
    coverageOut.textContent = '$' + handoff.selection.coverage.toLocaleString('en-US');
    premiumOut.textContent = '$' + handoff.selection.monthlyPremium;
    quoteBox.hidden = false;
    const reassure = document.querySelector<HTMLElement>('[data-fb-reassure]');
    if (reassure) reassure.hidden = false;
    // At 0:00 the selected-quote offer expires (its summary is hidden); the
    // call buttons stay, and Start New Quote begins a fresh quote.
    const offer = document.querySelector<HTMLElement>('[data-fb-offer]');
    const time = offer?.querySelector<HTMLElement>('[data-fb-offer-time]');
    const restart = document.querySelector<HTMLButtonElement>('[data-fb-offer-restart]');
    if (offer && time && restart) {
      offer.hidden = false;
      runCountdown(time, offerExpiresAt('apply'), () => {
        quoteBox.hidden = true;
        restart.hidden = false;
      });
      restart.addEventListener('click', () => {
        restart.disabled = true;
        void restartQuote();
      });
    }
  }
  };
  // Texting handoff V4.0: "Prepare My Text" opens the visitor's own messaging
  // app addressed to the approved SMS number with Randy's prewritten text
  // (first name, selected coverage and monthly premium). It never sends
  // anything; the visitor presses Send. The first name comes from the
  // visitor's own verified session (never stored in the browser). Without the
  // number (src/config/phones.ts SMS_NUMBER) or a selected quote: no link.
  const prepareText = async () => {
    const btn = document.querySelector<HTMLAnchorElement>('[data-fb-text]');
    const qrBtn = document.querySelector<HTMLButtonElement>('[data-fb-qr-btn]');
    const panel = document.querySelector<HTMLElement>('[data-fb-qr]');
    const code = panel?.querySelector<HTMLElement>('[data-fb-qr-code]');
    const h = readHandoff();
    if (!btn || !h) return;
    let firstName = '';
    try {
      const res = await fetch('/api/quote/', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Quote-Visit': localStorage.getItem('ff:quote-visit') ?? '' }, body: JSON.stringify({ action: 'session' }), credentials: 'same-origin' });
      const s = await res.json().catch(() => ({}));
      if (s.status === 'verified' && typeof s.firstName === 'string') firstName = s.firstName;
    } catch {}
    const body = prewrittenText({ firstName, coverage: h.selection.coverage, monthlyPremium: h.selection.monthlyPremium });
    btn.dataset.smsBody = body;
    const href = smsHref(SMS, body, isIOS(navigator));
    if (!href) return;
    // Two-option handoff V1.9: the cell phone button opens the messaging app.
    btn.href = href;
    btn.setAttribute('aria-disabled', 'false');
    // The computer button reveals a QR code with the same number and text
    // (generated in the browser; the QR library loads only on this click).
    const payload = qrPayload(SMS, body);
    if (!qrBtn || !panel || !code || !payload) return;
    qrBtn.addEventListener('click', async () => {
      if (!code.dataset.qrText) {
        const { renderSVG } = await import('uqr');
        code.innerHTML = renderSVG(payload, { ecc: 'M', border: 2 });
        code.dataset.qrText = payload;
      }
      panel.hidden = false;
      qrBtn.setAttribute('aria-expanded', 'true');
    });
  };
  const ready = () => {
    showSelectedQuote();
    void prepareText();
  };
  if (previewRequest() === 'apply') void preparePreviewApply().finally(ready);
  else ready();

  // Browsers only scroll a focused field into view when it is outside the
  // window, so a field partly behind the fixed mobile call bar stays there.
  // On this page, scroll such a field just clear of the bar (WCAG 2.2 SC 2.4.11).
  const bar = document.querySelector<HTMLElement>('.call-sticky');
  document.addEventListener('focusin', (e) => {
    const el = e.target as HTMLElement | null;
    if (!bar || !el?.getBoundingClientRect) return;
    const style = getComputedStyle(bar);
    if (style.display === 'none' || style.visibility === 'hidden') return;
    const overlap = el.getBoundingClientRect().bottom - bar.getBoundingClientRect().top;
    if (overlap > 0 && el !== bar) window.scrollBy(0, overlap + 16);
  });

  // The mobile call bar waits until the hero's own call button and phone
  // number have left the screen, so it doesn't repeat the button right
  // above it. Without JavaScript the bar simply shows.
  const heroCall = [...document.querySelectorAll<HTMLElement>('.fb-hero .fb-call')];
  if (bar && heroCall.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      document.body.classList.toggle('fb-hero-call-visible', visible.size > 0);
    });
    heroCall.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  /* Tokens the reused homepage sections (reviews, Meet Randy) rely on; the same
     values as the homepage palette (src/pages/index.astro). Contrast (WCAG 2.2
     AA): white on #173F35 11.7:1; cream #F7F3E8 on #173F35 10.5:1; white on the
     CTA orange #C2410C 5.2:1; charcoal on stone 13.1:1. */
  body.page-fb {
    --home-cream: #f7f3e8;
    --home-stone: #efebe2;
    --home-gold: #b68a35;
    --home-green-tint: #e4ece7;
    --home-radius: 0.375rem;
  }
  body.page-fb .btn {
    text-align: center;
  }
  /* While the page script picks this visitor's number (inline script above). */
  html.fb-phone-pending a[href^='tel:'],
  html.fb-phone-pending .fb-foot__disclaimer {
    visibility: hidden;
  }
  /* The mobile call bar waits while the hero's call button and disclosure are
     on screen (script on this page; visibility keeps its space reserved). */
  body.page-fb.fb-hero-call-visible .call-sticky {
    visibility: hidden;
  }
  /* Tighter spacing for the reused homepage sections on this page only. */
  body.page-fb .rev,
  body.page-fb .randy {
    padding-block: var(--space-8);
  }
  body.page-fb .rev__title {
    margin-bottom: var(--space-6);
  }
  body.page-fb .rev__title::before {
    display: none;
  }
  /* Meet Randy has no button row on this page (V4.0). */
  body.page-fb .randy__action {
    display: none;
  }
  body.page-fb .rev__count {
    padding-block: var(--space-6);
  }
  /* The call band and Meet Randy: one modest gap between the band's phone
     number and the gold rule above "Meet Randy" (the two sections' paddings
     used to add up, and on phones the heading sat centered beside the photo). */
  body.page-fb .fb-band {
    padding-bottom: var(--space-4);
  }
  body.page-fb .randy {
    padding-top: var(--space-4);
  }
  @media (max-width: 63.99rem) {
    body.page-fb .randy__title {
      align-self: start;
    }
  }
  @media (min-width: 64rem) {
    body.page-fb .rev,
    body.page-fb .randy {
      padding-block: var(--space-12);
    }
    body.page-fb .fb-band {
      padding-bottom: var(--space-6);
    }
    body.page-fb .randy {
      padding-top: var(--space-6);
    }
    body.page-fb .rev__title {
      margin-bottom: var(--space-8);
    }
  }
  body.page-fb .btn--secondary:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  /* The call buttons share the site's orange conversion color. */
  .fb-call__btn {
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-6);
    background: var(--color-cta);
    color: var(--color-on-cta);
    font-size: 1.1875rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    white-space: normal;
  }
  .fb-call__btn:hover {
    background: var(--color-cta);
    color: var(--color-on-cta);
    filter: brightness(0.9);
  }
  /* Two-option handoff V1.9: two equal columns under the quote card,
     divided by a thin line, from 48rem; stacked (cell phone first) on phones. */
  .fb-hero .fb-call.fb-text-options {
    max-width: 46rem;
    gap: var(--space-6);
  }
  .fb-text-opt {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
  }
  @media (min-width: 48rem) {
    .fb-hero .fb-call.fb-text-options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .fb-text-opt {
      padding-inline: var(--space-6);
    }
    .fb-text-opt + .fb-text-opt {
