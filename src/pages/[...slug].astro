---
// Renders every Markdown page in src/content/pages/ at a URL matching its
// file path. Adding a page never requires touching this file.
import { render } from 'astro:content';
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getPublishedPages, pagePath, type PageEntry } from '@/lib/pages';
import { isArticlePage } from '@/lib/article/config';

export async function getStaticPaths() {
  const pages = await getPublishedPages();
  return pages
    .filter((entry) => pagePath(entry) !== '/') // homepage is src/pages/index.astro
    // Pages opted in to the article template render through [...article].astro
    // (src/config/article-pages.ts), so its styles reach only those pages.
    .filter((entry) => !isArticlePage(pagePath(entry)))
    .map((entry) => ({
      params: { slug: pagePath(entry).replace(/^\/|\/$/g, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props as { entry: PageEntry };
const { Content } = await render(entry);
---

<ContentLayout entry={entry}>
  <Content />
</ContentLayout>
