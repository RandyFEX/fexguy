---
// Final Expense Insurance Prices by Age (Quote System v2.2, Randy, November
// 2026): a one-question-per-screen quote funnel with Twilio phone
// verification. Prices come only from the server after the server has
// verified the phone (api/quote.js, api/price-explorer.js); this page and its
// script hold no rate tables, rates, keys or Twilio credentials.
// Representative (Texas) rates are shown for every state; state is lead
// information only.
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeaderLogo from '@/components/HeaderLogo.astro';
import HeaderPhone from '@/components/HeaderPhone.astro';
import { HEADER_PHONE_ICON_PATH, PAGE_PHONES } from '@/config/phones';
import { pageTitle } from '@/lib/seo/meta';
import { lead } from '@/config/lead';
import { US_STATES } from '@/lib/lead/lead-form';
import { AGES, COVERAGE } from '../../server/rates/pricing-categories.js';
import { CONSENT_TEXT, CONSENT_VERSION, VERIFY_NOTICE_TEXT, VERIFY_NOTICE_VERSION } from '../../server/quote/consent.js';

const ages = Array.from({ length: AGES.max - AGES.min + 1 }, (_, i) => AGES.min + i);
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
const cards = [
  { id: 'lowest-preferred', label: 'Lowest Preferred Rate' },
  { id: 'average-standard', label: 'Standard Rate' },
  { id: 'guaranteed-acceptance', label: 'Guaranteed Acceptance Rate' },
];
// Safe stand-ins for the blurred, locked cards (never real carriers or plans).
const LOGO_STAND_INS = ['Insurance Co.', 'Life Company', 'Insurance Co.'];
const PLAN_STAND_INS = ['Whole Life Plan', 'Final Expense Plan', 'Life Insurance Plan'];
const phone = PAGE_PHONES.default;
const TOTAL = 8;
---

<BaseLayout
  title={pageTitle('Final Expense Insurance Prices by Age')}
  description="Compare estimated monthly final expense insurance rates based on your age, coverage amount, and tobacco use."
  layout="landing"
  preFooter={false}
  stickyCall={false}
  bodyClass="page-quote"
>
  <div class="qh-top">
    <div class="container qh-top__inner">
      <HeaderLogo>
        <img
          class="qh-top__logo"
          src="/images/logo/funeral-funds-wordmark-800.webp"
          srcset="/images/logo/funeral-funds-wordmark-400.webp 400w, /images/logo/funeral-funds-wordmark-800.webp 800w"
          sizes="12rem"
          width="1987"
          height="285"
          alt="Funeral Funds"
          fetchpriority="high"
        />
      </HeaderLogo>
      <div class="qh-top__right">
        <p class="qh-secure">
          <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="currentColor"><path d="M8 1a3.5 3.5 0 0 0-3.5 3.5V7H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-.5V4.5A3.5 3.5 0 0 0 8 1Zm2 6H6V4.5a2 2 0 1 1 4 0V7Z" /></svg>
          Secure Form
        </p>
        <HeaderPhone phone={phone} showLabel={false} />
      </div>
    </div>
  </div>

  <div
    class="qf"
    data-page-type="utility"
    data-page-reason="Interactive final expense quote tool."
    data-quote-funnel
    data-consent-version={CONSENT_VERSION}
    data-verify-version={VERIFY_NOTICE_VERSION}
  >
    <h1 class="visually-hidden">Final Expense Insurance Quote</h1>

    <div class="container qf-body">
      <div class="qf-panel" data-qf-panel>
        <div class="qf-top" data-qf-top>
          <button class="qf-back" type="button" data-qf-back hidden><span aria-hidden="true">‹</span> Back</button>
          <p class="qf-progress-label" data-qf-progress-label>Step 1 of {TOTAL}</p>
        </div>
        <div class="qf-progress" aria-hidden="true" data-qf-progress-wrap><span class="qf-progress__bar" data-qf-progress></span></div>

        <p class="qf-test" data-qf-test hidden><strong>TEST MODE (preview only):</strong> no text message is sent. Use code 123456.</p>

        <!-- Step 1 -->
        <section class="qf-step" data-step="1" aria-labelledby="qf-s1">
          <h2 class="qf-q" id="qf-s1" tabindex="-1">Who Needs Coverage?</h2>
          <div class="qf-people">
            <button class="qf-person" type="button" data-pick="gender" data-value="male">
              <svg viewBox="0 0 120 120" aria-hidden="true" class="qf-person__art">
                <circle cx="60" cy="60" r="58" fill="#e6ece9" />
                <path d="M22 112c4-24 20-36 38-36s34 12 38 36" fill="#173f35" />
                <path d="M50 74h20l-10 14z" fill="#fff" />
                <circle cx="60" cy="48" r="20" fill="#e9c4a4" />
                <path d="M40 46c0-14 9-22 20-22s20 7 20 20c-5-6-12-8-20-8s-15 3-20 10z" fill="#6b4a33" />
              </svg>
              <span class="qf-person__label">Male</span>
            </button>
            <button class="qf-person" type="button" data-pick="gender" data-value="female">
              <svg viewBox="0 0 120 120" aria-hidden="true" class="qf-person__art">
                <circle cx="60" cy="60" r="58" fill="#e6ece9" />
                <path d="M36 70c-6-10-6-26 0-36 6-10 16-14 24-14s18 4 24 14c6 10 6 26 0 36z" fill="#8a5a3c" />
                <path d="M22 112c4-24 20-36 38-36s34 12 38 36" fill="#2f6b5a" />
                <circle cx="60" cy="50" r="19" fill="#efcdb0" />
                <path d="M41 48c1-13 9-20 19-20s18 6 19 18c-6-5-11-9-19-9-7 0-13 4-19 11z" fill="#8a5a3c" />
              </svg>
              <span class="qf-person__label">Female</span>
            </button>
          </div>
        </section>

        <!-- Step 2 -->
        <section class="qf-step" data-step="2" aria-labelledby="qf-s2" hidden>
          <h2 class="qf-q" id="qf-s2" tabindex="-1">How Old Are You?</h2>
          <div class="qf-ages" role="group" aria-labelledby="qf-s2">
            {ages.map((a) => <button class="qf-opt qf-opt--age" type="button" data-pick="age" data-value={a}>{a}</button>)}
          </div>
        </section>

        <!-- Step 3 -->
        <section class="qf-step" data-step="3" aria-labelledby="qf-s3" hidden>
          <h2 class="qf-q" id="qf-s3" tabindex="-1">Do You Use Tobacco?</h2>
          <div class="qf-opts qf-opts--two">
            <button class="qf-opt qf-opt--big" type="button" data-pick="tobacco" data-value="no">Non-Smoker</button>
            <button class="qf-opt qf-opt--big" type="button" data-pick="tobacco" data-value="yes">Smoker</button>
          </div>
        </section>

        <!-- Step 4: intended use (lead information only; never changes prices) -->
        <section class="qf-step" data-step="4" aria-labelledby="qf-s4" hidden>
          <h2 class="qf-q" id="qf-s4" tabindex="-1">How Would You Use These Funds?</h2>
          <div class="qf-opts qf-opts--use">
            <button class="qf-opt qf-opt--big" type="button" data-pick="use" data-value="burial">Burial Expenses</button>
            <button class="qf-opt qf-opt--big" type="button" data-pick="use" data-value="cremation">Cremation Expenses</button>
            <button class="qf-opt qf-opt--big" type="button" data-pick="use" data-value="other">Other Expenses</button>
          </div>
        </section>

        <!-- Step 5 -->
        <section class="qf-step" data-step="5" aria-labelledby="qf-s5" hidden>
          <h2 class="qf-q" id="qf-s5" tabindex="-1">How Much Coverage Would You Like?</h2>
          <div class="qf-opts qf-opts--coverage">
            {COVERAGE.presets.map((c) => <button class="qf-opt qf-opt--big" type="button" data-pick="coverage" data-value={c}>{money(c)}</button>)}
            <button class="qf-opt qf-opt--big" type="button" data-qf-other-open>Other</button>
          </div>
          <div class="qf-other" data-qf-other hidden>
            <label class="qf-label" for="qf-other-input">Coverage amount ({money(COVERAGE.min)} to {money(COVERAGE.max)})</label>
            <div class="qf-other__row">
              <span class="qf-other__dollar" aria-hidden="true">$</span>
              <input class="qf-input" id="qf-other-input" type="text" inputmode="numeric" autocomplete="off" placeholder="12,000" aria-describedby="qf-other-error" />
            </div>
            <p class="qf-error" id="qf-other-error" data-qf-other-error hidden></p>
            <button class="btn btn--primary qf-continue" type="button" data-qf-other-next>Continue</button>
          </div>
        </section>

        <!-- Step 6 -->
        <section class="qf-step" data-step="6" aria-labelledby="qf-s6" hidden>
          <h2 class="qf-q" id="qf-s6" tabindex="-1">What State Do You Live In?</h2>
          <label class="visually-hidden" for="qf-state">State</label>
          <select class="qf-input qf-select" id="qf-state" data-qf-state>
            <option value="">Select your state</option>
            {US_STATES.map((s) => <option>{s}</option>)}
          </select>
        </section>

        <!-- Step 7 -->
        <section class="qf-step" data-step="7" aria-labelledby="qf-s7" hidden>
          <h2 class="qf-q" id="qf-s7" tabindex="-1">Your Contact Information</h2>
          <dl class="qf-summary" aria-label="Your selections" data-qf-summary>
            <div><dt>Gender</dt><dd data-qf-sum="gender"></dd></div>
            <div><dt>Age</dt><dd data-qf-sum="age"></dd></div>
            <div><dt>State</dt><dd data-qf-sum="state"></dd></div>
            <div><dt>Tobacco</dt><dd data-qf-sum="tobacco"></dd></div>
            <div><dt>Coverage</dt><dd data-qf-sum="coverage"></dd></div>
          </dl>
          <form class="qf-form" data-qf-contact novalidate>
            <div class="qf-field">
              <label class="qf-label" for="qf-first">First Name</label>
              <input class="qf-input" id="qf-first" name="firstName" type="text" autocomplete="given-name" required aria-describedby="qf-first-error" />
              <p class="qf-error" id="qf-first-error" hidden></p>
            </div>
            <div class="qf-field">
              <label class="qf-label" for="qf-phone">Mobile Phone Number</label>
              <input class="qf-input" id="qf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" required aria-describedby="qf-phone-error" />
              <p class="qf-error" id="qf-phone-error" hidden></p>
            </div>
            <label class="qf-consent">
              <input type="checkbox" name="consent" data-qf-consent />
              <span>{CONSENT_TEXT}</span>
            </label>
            <p class="qf-reassure"><strong>Our Promise:</strong> No Spam Calls. No Junk Mail.</p>
            <button class="btn qf-continue qf-btn-cta" type="submit">See My Instant Quotes</button>
          </form>
        </section>

        <!-- Step 8: the pricing screen (blurred until the phone is verified, then live) -->
        <section class="qf-step qf-results" data-step="8" data-locked="true" aria-labelledby="qf-s8" hidden>
          <h2 class="qf-q visually-hidden" id="qf-s8" tabindex="-1" data-qf-results-title>Your quote results</h2>
          <p class="visually-hidden" role="status" aria-live="polite" data-qf-live></p>
          <div class="qf-cards">
            {cards.map((c, i) => (
              <article class="qf-card" data-qf-card={c.id} data-state="locked">
                <div class="qf-card__logo" data-qf-logo><span class="qf-blur qf-logo-stand" aria-hidden="true">{LOGO_STAND_INS[i]}</span></div>
                <div class="qf-card__cat"><h3 class="qf-card__label">{c.label}</h3></div>
                <p class="qf-card__plan" data-qf-plan><span class="qf-blur" aria-hidden="true">{PLAN_STAND_INS[i]}</span></p>
                <p class="qf-card__price">
                  <span class="qf-card__amount" data-qf-amount><span class="qf-blur" aria-hidden="true">{['$38.47', '$52.19', '$71.36'][i]}</span><span class="visually-hidden">Price shown after you verify your phone number</span></span>
                  <span class="qf-card__per">per month</span>
                </p>
                <p class="qf-card__timing" data-qf-timing hidden></p>
                <p class="qf-card__note" data-qf-note></p>
                <a class="btn qf-card__call" href={phone.href} data-qf-call hidden>
                  <svg aria-hidden="true" width="18" height="18" viewBox="1.5 1.5 21 21" fill="currentColor"><path fill-rule="evenodd" d={HEADER_PHONE_ICON_PATH} clip-rule="evenodd" /></svg>
                  <span>Call to Get Approved</span>
                </a>
                <button class="btn qf-card__apply" type="button" data-qf-apply disabled>Unlock to See Rates</button>
              </article>
            ))}
          </div>

          <section class="qf-unlock" data-qf-unlock aria-labelledby="qf-unlock-title">
            <h3 class="qf-unlock__title" id="qf-unlock-title" tabindex="-1">Unlock Your Rates</h3>
            <form class="qf-form qf-form--compact" data-qf-send-form novalidate>
              <p class="qf-note" id="qf-verify-note">{VERIFY_NOTICE_TEXT}</p>
              <p class="qf-unlock__number" data-qf-phone-summary><strong data-qf-phone-show></strong> <button class="qf-link" type="button" data-qf-edit-phone>Change Number</button></p>
              <div class="qf-field" data-qf-phone-field hidden>
                <label class="qf-label" for="qf-unlock-phone">Mobile Phone Number</label>
                <input class="qf-input" id="qf-unlock-phone" type="tel" inputmode="tel" autocomplete="tel-national" required aria-describedby="qf-unlock-phone-error qf-verify-note" />
                <p class="qf-error" id="qf-unlock-phone-error" hidden></p>
              </div>
              <button class="btn qf-continue qf-btn-cta" type="submit" data-qf-send>Text Me My Access Code</button>
              <p class="qf-status" role="status" aria-live="polite" tabindex="-1" data-qf-send-status></p>
            </form>
            <form class="qf-form qf-form--compact" data-qf-verify novalidate hidden>
              <p class="qf-note">Enter the 6-digit code sent to <strong data-qf-masked></strong>.</p>
              <label class="visually-hidden" for="qf-code">6-digit code</label>
              <div class="qf-code-row">
                <input class="qf-input qf-code" id="qf-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="\d{6}" placeholder="000000" required />
                <button class="btn qf-continue qf-btn-cta" type="submit" data-qf-verify-btn>Verify Code</button>
              </div>
              <p class="qf-status" role="status" aria-live="polite" tabindex="-1" data-qf-verify-status></p>
              <div class="qf-links">
                <button class="qf-link" type="button" data-qf-resend>Resend Code</button>
                <button class="qf-link" type="button" data-qf-change>Change Number</button>
              </div>
            </form>
          </section>
          <p class="qf-status" role="status" aria-live="polite" tabindex="-1" data-qf-apply-status></p>

          <p class="qf-adjust-intro" data-qf-adjust-intro hidden>Adjust your coverage and compare rates below.</p>
          <form class="qf-adjust" data-qf-adjust aria-label="Change your quote" novalidate hidden>
            <div class="qf-group qf-group--age">
              <label class="qf-group__title" for="qf-adj-age">Age</label>
              <select class="qf-input qf-select qf-control" id="qf-adj-age" name="age">
                {ages.map((a) => <option value={a}>{a}</option>)}
              </select>
            </div>
            <fieldset class="qf-group qf-seg">
              <legend class="qf-group__title">Gender</legend>
              <div class="qf-seg__opts">
                <label class="qf-seg__opt"><input type="radio" name="gender" value="male" /><span class="qf-control">Male</span></label>
                <label class="qf-seg__opt"><input type="radio" name="gender" value="female" /><span class="qf-control">Female</span></label>
              </div>
            </fieldset>
            <fieldset class="qf-group qf-seg">
              <legend class="qf-group__title">Tobacco</legend>
              <div class="qf-seg__opts">
                <label class="qf-seg__opt"><input type="radio" name="tobacco" value="no" /><span class="qf-control">Non-Smoker</span></label>
                <label class="qf-seg__opt"><input type="radio" name="tobacco" value="yes" /><span class="qf-control">Smoker</span></label>
              </div>
            </fieldset>
            <fieldset class="qf-group qf-group--coverage qf-seg">
              <legend class="qf-group__title">Coverage</legend>
              <div class="qf-seg__opts qf-seg__opts--coverage">
                {COVERAGE.presets.map((c) => <label class="qf-seg__opt"><input type="radio" name="coverage" value={c} /><span class="qf-control">{money(c)}</span></label>)}
                <label class="qf-seg__opt"><input type="radio" name="coverage" value="other" /><span class="qf-control">Other</span></label>
              </div>
              <div class="qf-other qf-other--inline" data-qf-adj-other hidden>
                <label class="qf-label qf-label--small" for="qf-adj-other">Coverage amount ({money(COVERAGE.min)} to {money(COVERAGE.max)})</label>
                <div class="qf-other__row">
                  <span class="qf-other__dollar" aria-hidden="true">$</span>
                  <input class="qf-input qf-control" id="qf-adj-other" type="text" inputmode="numeric" autocomplete="off" placeholder="12,000" aria-describedby="qf-adj-other-error" />
                </div>
                <p class="qf-error" id="qf-adj-other-error" data-qf-adj-other-error hidden></p>
              </div>
            </fieldset>
          </form>
          <p class="qf-ref" data-qf-ref hidden>Representative monthly rates. Actual premiums and availability may vary by state and insurance company.</p>
          <p class="qf-restart-row"><button class="qf-link" type="button" data-qf-restart>Start New Quote</button></p>
        </section>

        <!-- Step 9: carrier-specific health questions after Apply Now -->
        <section class="qf-step" data-step="9" aria-labelledby="qf-s9" hidden>
          <h2 class="qf-q" id="qf-s9" tabindex="-1" data-qf-intake-title>Application questions</h2>
          <p class="qf-note" data-qf-intake-sub></p>
          <div class="qf-intake" data-qf-intake-q hidden>
            <p class="qf-intake__count" data-qf-intake-count></p>
            <p class="qf-intake__text" data-qf-intake-text></p>
            <div class="qf-opts qf-opts--two">
              <button class="qf-opt qf-opt--big" type="button" data-qf-answer="yes">Yes</button>
              <button class="qf-opt qf-opt--big" type="button" data-qf-answer="no">No</button>
            </div>
          </div>
          <div class="qf-intake-done" data-qf-intake-done hidden>
            <p class="qf-intake__text" data-qf-intake-done-text></p>
            <a class="btn btn--primary qf-continue qf-call-btn" href={lead.phone.href}>Call {lead.phone.display}</a>
            <button class="btn qf-continue qf-secondary" type="button" data-qf-intake-finish>Continue</button>
          </div>
          <p class="qf-status" role="status" aria-live="polite" tabindex="-1" data-qf-intake-status></p>
        </section>

        <div class="lead-form__turnstile" data-turnstile data-sitekey={lead.formspark.turnstile.siteKey}></div>
      </div>

    </div>

    <footer class="qh-foot">
      <div class="container">
        <ul class="qh-foot__links" role="list">
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-of-use/">Terms of Use</a></li>
          <li><a href="/licenses/">Licenses</a></li>
        </ul>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import '@/scripts/quote-funnel';
</script>

<style>
  /* Minimal quote header: logo left; Secure Form and the phone right. */
  .qh-top { background: #fff; border-bottom: 1px solid var(--color-border); }
  .qh-top__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-2); }
  .qh-top__logo { display: block; width: clamp(8.5rem, 30vw, 12rem); height: auto; }
  .qh-top__right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.125rem; }
  .qh-secure { display: inline-flex; align-items: center; gap: 0.3rem; margin: 0; font-size: 0.8125rem; font-weight: 700; color: #173f35; line-height: 1.2; }
  .qh-top__right :global(.header-phone) { min-height: 0; font-size: 1rem; }
  .qh-foot { padding-block: var(--space-6); background: var(--color-bg); color: var(--color-text-muted); }
  .qh-foot__links { list-style: none; margin: 0 0 var(--space-3); padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0 var(--space-4); }
  .qh-foot__links a { display: inline-flex; align-items: center; min-height: var(--tap-target); color: var(--color-primary); font-weight: 700; font-size: 0.9375rem; }
  .qh-foot__disclaimer { margin: 0 auto; max-width: 60rem; font-size: 0.75rem; line-height: 1.4; }

  .qf-body { padding-block: var(--space-4) var(--space-8); max-width: 62rem; }
  .qf-panel {
    background: #fff;
    border-radius: 0.75rem;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.12);
    padding: var(--space-4) var(--space-4) var(--space-6);
    min-height: 22rem;
  }
  @media (max-width: 29.99rem) { .qf-body { padding-inline: var(--space-2); } }
  @media (min-width: 48rem) { .qf-panel { padding: var(--space-6) var(--space-8) var(--space-8); } }
  .qf-top { display: flex; align-items: center; justify-content: space-between; min-height: var(--tap-target); gap: var(--space-3); }
  .qf-back {
    min-height: var(--tap-target); min-width: var(--tap-target); padding: 0 var(--space-3);
    border: 2px solid var(--color-border); border-radius: 999px; background: #fff;
    color: var(--color-primary); font-weight: 700; font-size: 1.0625rem; cursor: pointer;
  }
  .qf-progress-label { margin: 0 0 0 auto; font-weight: 700; color: var(--color-text-muted); }
  .qf-progress { height: 0.5rem; background: #e3e8e5; border-radius: 999px; overflow: hidden; margin: var(--space-2) 0 var(--space-4); }
  .qf-progress__bar { display: block; height: 100%; width: 14%; background: var(--color-primary); border-radius: inherit; transition: width 0.3s ease; }
  .qf-test { background: #fff4d6; border: 2px solid #b7791f; border-radius: var(--radius); padding: var(--space-3); margin: 0 0 var(--space-4); }
  .qf-step { animation: qf-in 0.25s ease; }
  @keyframes qf-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .qf-step { animation: none; } .qf-progress__bar { transition: none; } }
  .qf-q { font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem); line-height: 1.2; color: var(--color-primary); margin: 0 0 var(--space-4); text-align: center; }
  .qf-q:focus { outline: none; }

