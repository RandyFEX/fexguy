  title="Life Insurance Documents | Funeral Funds"
  robots="noindex, nofollow"
  noindex={true}
  canonical="/trin-fbl/"
  layout="landing"
  stickyCall={false}
  preFooter={false}
  bodyClass="page-docs"
>
  <article class="docs" data-page-type="utility" data-page-reason="Client insurance documents sent by direct link (noindex, nofollow).">
    <section class="docs__sec">
      <h1>Life Insurance Documents</h1>
      <p>Here are the documents I mentioned that I would send you:</p>
    </section>

