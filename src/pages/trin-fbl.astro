---
// /trin-fbl/: client insurance documents (Randy, November 2026). Sent by
// direct link during the application and approval process; never linked
// from the site. No site header, navigation, footer, call bar, forms or
// promotions. noindex, nofollow (also sent as an X-Robots-Tag header in
// vercel.json); out of the sitemap, llms.txt and site search; not blocked in
// robots.txt. The document text is Randy's, as supplied, in his order; only
// visual formatting was added (headings, paragraphs, lists, the example
// table, signature lines and dividers). Two deliberate exceptions, reported
// to Randy: the em dash in "You’re older—are" is shown as "You’re older, are"
// (the site allows no em dashes; the page published that way before), and
// the "??" before YES and NO are shown as empty check boxes. Its en dashes are
// verbatim (src/config/dash-exceptions.json).
import BaseLayout from '@/layouts/BaseLayout.astro';
import { lead } from '@/config/lead';
---

