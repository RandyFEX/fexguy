---
// Homepage. src/content/pages/index.md supplies the page's title, meta tags
// and JSON-LD (unchanged); the hero (with the page's H1) and the sections are
// homepage components (src/components/home/) fed by src/lib/home/content.ts.
// The site's one native quote form sits in the Final CTA (id="quote", the
// hero's GET A QUOTE target).
//
// The homepage palette (heritage green, cream, stone, charcoal, a little
// gold) is scoped to <body class="page-home"> below, so articles and every
// other page keep the site-wide tokens in global.css.
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import WhyFexguy from '@/components/home/WhyFexguy.astro';
import ServiceNav from '@/components/home/ServiceNav.astro';
import ReviewHighlights from '@/components/home/ReviewHighlights.astro';
import MeetRandy from '@/components/home/MeetRandy.astro';
import HealthConditions from '@/components/home/HealthConditions.astro';
import CompanyReviews from '@/components/home/CompanyReviews.astro';
import ResourceLibrary from '@/components/home/ResourceLibrary.astro';
import HomeFaq from '@/components/home/HomeFaq.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import { isSearchable } from '@/lib/pages';

const entry = await getEntry('pages', 'index');
if (!entry) throw new Error('Missing src/content/pages/index.md');
const d = entry.data;
const searchable = isSearchable(entry) ? '' : undefined;
---

<BaseLayout
  title={d.title}
  description={d.description}
  robots={d.robots}
  noindex={d.noindex}
  canonical={d.canonical ?? '/'}
  headMeta={d.headMeta}
  jsonLd={d.jsonLd}
  ctaBar={false}
  preFooter={false}
  bodyClass="page-home"
>
  {/* Pagefind indexes the page content (H1, hero text and sections), never the
     calls to action, rate examples, header or footer (data-pagefind-ignore). */}
  <div class="home" data-pagefind-body={searchable}>
    <HomeHero />

    <WhyFexguy />

    <ServiceNav />

    <ReviewHighlights />
    <MeetRandy />
    <HealthConditions />
    <CompanyReviews />

    <ResourceLibrary />

    <HomeFaq />
    <FinalCta />
  </div>
</BaseLayout>

<style is:global>
  /* Homepage palette. Contrast (WCAG 2.2 AA): charcoal #202522 on white
     15.6:1, on cream 14.0:1, on stone 13.1:1; muted #555B57 on white 7.0:1,
     on cream 6.3:1, on stone 5.8:1; heritage green #173F35 on white 11.7:1,
     on cream 10.5:1, on stone 9.8:1 (white on it 11.7:1); gold #B68A35
     only for the short decorative rules and the hero product-line dots
     (never text or controls). */
  body.page-home {
    --color-text: #202522;
    --color-text-muted: #555b57;
    --color-surface: #efebe2;
    --color-border: #ddd7ca;
    --color-primary: #173f35;
    --color-primary-hover: #0e2d26;
    --color-accent: #173f35;
    --color-call: #173f35;
    --home-cream: #f7f3e8;
    --home-stone: #efebe2;
    --home-gold: #b68a35;
    --home-green-tint: #e4ece7;
    --home-radius: 0.375rem;
  }
  /* The secondary button hover would otherwise vanish into the stone band. */
  body.page-home .btn--secondary:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  /* Long button labels can wrap on phones; keep both lines centered. */
  body.page-home .btn {
    text-align: center;
  }
</style>

