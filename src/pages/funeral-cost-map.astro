---
// /funeral-cost-map/ (Randy, November 2026, Map V3.0): an interactive U.S.
// map of funeral price inflation and leading causes of death, with a funeral
// cost projection and a funding shortfall calculator. Everything is on this
// one page; no lead gate. Data (src/data/funeral-map/, rebuilt by
// scripts/funeral-map/build-data.mjs):
//   - BLS CPI series CUUR0000SEGD (funeral expenses, national, monthly);
//   - CDC/NCHS quarterly provisional death rates (489q-934x), by state, latest
//     12 months (map, leading causes, recent trend; national by age and sex);
//   - CDC/NCHS provisional deaths by sex and age (9bhg-hcku), by state, 2022;
//   - CDC/NCHS "Leading Causes of Death" (bi63-dtpu), by state, 1999-2017 (final
//     counts and long-term trend);
//   - state outlines: us-atlas 3.0.1 (U.S. Census Bureau boundaries).
// No funeral prices in dollars are shown as data: no reusable source was
// available (see the methodology section). Visitors can enter a price from a
// funeral home's General Price List; every dollar figure is calculated from it.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pageTitle } from '@/lib/seo/meta';
import { lead } from '@/config/lead';
import paths from '@/data/funeral-map/state-paths.json';
import mortality from '@/data/funeral-map/leading-causes.json';
import cpi from '@/data/funeral-map/cpi-funeral.json';
import recent from '@/data/funeral-map/mortality-recent.json';
import nfda from '@/data/funeral-map/nfda-prices.json';
import directCremation from '@/data/funeral-map/direct-cremation.json';

type Row = [number, number];
const LATEST = String(mortality.years[1]);
const states = mortality.states as unknown as Record<string, Record<string, Record<string, Row>>>;
const stateNames = paths.states.map((s) => s.name).sort();
const fmt = (n: number) => n.toLocaleString('en-US');

// Latest provisional period (12 months ending with the latest quarter).
const rates = recent.rates as Record<string, Record<string, (number | null)[]>>;
const QI = recent.quarters.length - 1;
const QEND: Record<string, string> = { Q1: 'March', Q2: 'June', Q3: 'September', Q4: 'December' };
const [qYear, qQ] = recent.latest.split(' ');
const periodLabel = `12 months ending ${QEND[qQ]} ${qYear}`;
const deaths22 = recent.deaths2022.data as Record<string, Record<string, Record<string, number | null>>>;

// Crawlable summary: every state's latest all-cause rate, its highest-rate leading
// cause, and its 2022 deaths (all causes).
const latestIdx = (cause: string) => {
  const us = rates['United States']?.[cause] ?? [];
  for (let i = us.length - 1; i >= 0; i--) if (us[i] != null) return i;
  return QI;
};
const tableRows = [...stateNames, 'United States'].map((name) => {
  const r = rates[name] ?? {};
  const top = recent.leading.map((c) => [c, r[c]?.[latestIdx(c)] ?? null] as const).filter((x) => x[1] != null).sort((a, b) => (b[1] as number) - (a[1] as number))[0];
  return { name, rate: r['All causes']?.[QI] ?? null, top: top?.[0] ?? null, topRate: top?.[1] ?? null, deaths: deaths22[name]?.['All Sexes']?.['All Ages'] ?? null };
});

// Latest published CPI month (for the "updated" line).
const cpiYears = Object.keys(cpi.monthly).sort();
const lastYear = cpiYears[cpiYears.length - 1];
const lastMonth = Object.keys((cpi.monthly as Record<string, Record<string, number>>)[lastYear]).sort().pop()!;
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const cpiLabel = `${MONTHS[Number(lastMonth.slice(1)) - 1]} ${lastYear}`;

// Funeral cost estimates (Map V3.3): NFDA 2023 regional medians x BLS funeral
// index (latest month / July 2023, the survey month). Crawlable regional table.
const monthlyCpi = cpi.monthly as Record<string, Record<string, number>>;
const refMonth = nfda.cpiReferenceMonth;
const cpiFactor = monthlyCpi[lastYear][lastMonth] / monthlyCpi[refMonth.slice(0, 4)][`M${refMonth.slice(5)}`];
const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const dcMoney = (v: number) => (Number.isInteger(v) ? money(v) : `$${v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
const vsNat = (v: number, n: number) => { const d = v / n - 1; return `${Math.abs(d * 100).toFixed(0)}% ${d >= 0 ? 'above' : 'below'}`; };
const s2023 = nfda.sources.find((x) => x.year === 2023)!;
const s2021 = nfda.sources.find((x) => x.year === 2021)!;
const cpi2123 = monthlyCpi['2023']['M07'] / monthlyCpi['2021']['M07'];

const title = 'Funeral Cost and Mortality Map by State';
const description = 'Interactive U.S. map: how much funeral prices have risen (BLS), projected future funeral costs, a funding shortfall calculator, and the leading causes of death in every state (CDC).';
const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: 'https://funeralfunds.com/funeral-cost-map/',
    isPartOf: { '@id': 'https://funeralfunds.com/#website' },
    publisher: { '@id': 'https://funeralfunds.com/#organization' },
  }),
];
---

<BaseLayout title={pageTitle(title)} description={description} canonical="/funeral-cost-map/" jsonLd={jsonLd}>
  <div class="container fcm" data-page-type="utility" data-page-reason="Interactive funeral cost and mortality map.">
    <h1>{title}</h1>
    <p class="fcm-lead">
      Pick a state to see its leading causes of death, then see how much funeral prices have risen over the last 20
      years, what a funeral could cost in the future, and how much of that cost your coverage and savings would pay.
    </p>

    <div class="fcm-grid">
      <section class="fcm-map" aria-labelledby="fcm-map-h">
        <h2 id="fcm-map-h" class="fcm-h2">Choose a state</h2>
        <div class="fcm-controls">
          <label class="fcm-field">
            <span>State</span>
            <select id="fcm-state" data-fcm-state>
              <option value="United States">United States (national)</option>
              {stateNames.map((n) => <option value={n}>{n}</option>)}
            </select>
          </label>
          <label class="fcm-field">
            <span>Color the map by</span>
            <select id="fcm-metric" data-fcm-metric>
              <option value="cost:burial" selected>Estimated cost: funeral with burial</option>
              <option value="cost:cremation">Estimated cost: funeral with cremation</option>
              <option value="cost:direct">Direct cremation (states with survey data)</option>
              <option value="All causes">Death rate, all causes</option>
              {[...recent.leading, ...recent.other].map((c) => <option value={c}>Death rate: {c}</option>)}
            </select>
          </label>
        </div>
        <div class="fcm-svg-wrap">
          <svg viewBox={paths.viewBox} role="group" aria-label="Map of the United States. Select a state." data-fcm-svg>
            {paths.states.map((s) => (
              <path d={s.d} data-state={s.name} tabindex="0" role="button" aria-label={s.name}><title>{s.name}</title></path>
            ))}
          </svg>
          <p class="fcm-tip" data-fcm-tip hidden></p>
        </div>
        <div class="fcm-legend" data-fcm-legend aria-hidden="true"></div>
        <p class="fcm-note" data-fcm-mapnote>
          Map shading: estimated funeral cost based on historical data. Darker means higher.
        </p>
      </section>

      <section class="fcm-panel" aria-labelledby="fcm-mort-h" aria-live="polite">
        <h2 id="fcm-mort-h" class="fcm-h2">Leading causes of death: <span data-fcm-name>United States</span></h2>
        <p class="fcm-note">Age-adjusted death rates, {periodLabel} (provisional), ordered from highest to lowest rate.</p>
        <div class="fcm-scroll" tabindex="0">
          <table class="fcm-table">
            <thead><tr><th scope="col">#</th><th scope="col">Cause</th><th scope="col">Death rate*</th><th scope="col">U.S. rate</th><th scope="col">vs. U.S.</th></tr></thead>
            <tbody data-fcm-causes></tbody>
          </table>
        </div>
        <p class="fcm-note" data-fcm-lag></p>
        <p class="fcm-note" data-fcm-total></p>
        <p class="fcm-note">
          *Deaths per 100,000 people, age-adjusted to the 2000 U.S. standard population, all ages and both sexes.
          These are population statistics; they do not predict any one person's lifespan.
        </p>
        <h3 class="fcm-h3">Recent trend: <span data-fcm-trend-cause>All causes</span></h3>
        <div class="fcm-trend" data-fcm-trend></div>

        <h3 class="fcm-h3">Deaths by age and sex, {recent.deaths2022.year}: <span data-fcm-name>United States</span></h3>
        <div class="fcm-scroll" tabindex="0">
          <table class="fcm-table">
            <thead><tr><th scope="col">Age</th><th scope="col">Men</th><th scope="col">Women</th><th scope="col">Total</th></tr></thead>
            <tbody data-fcm-agesex></tbody>
          </table>
        </div>
        <p class="fcm-note">Deaths from all causes (provisional). CDC does not publish causes by age and sex for each state in a downloadable table.</p>

        <h3 class="fcm-h3">U.S. death rate by age and sex: <span data-fcm-trend-cause>All causes</span></h3>
        <div class="fcm-scroll" tabindex="0">
          <table class="fcm-table">
            <thead><tr><th scope="col">Group</th><th scope="col">Deaths per 100,000</th></tr></thead>
            <tbody data-fcm-usdemo></tbody>
          </table>
        </div>
        <p class="fcm-note">National only, {periodLabel} (provisional). Men and women: age-adjusted rates. Age groups: rates for that age.</p>

        <details class="fcm-details">
          <summary>Deaths by cause and long-term trend, 1999 to {LATEST} (final data)</summary>
          <div class="fcm-scroll" tabindex="0">
            <table class="fcm-table">
              <thead><tr><th scope="col">#</th><th scope="col">Cause</th><th scope="col">Deaths, {LATEST}</th><th scope="col">Share of deaths</th><th scope="col">Death rate*</th></tr></thead>
              <tbody data-fcm-causes-final></tbody>
            </table>
          </div>
          <div class="fcm-trend" data-fcm-trend-final></div>
          <p class="fcm-note">{LATEST} is the latest year in CDC's downloadable state table of final death counts by cause.</p>
        </details>
      </section>
    </div>

    <section class="fcm-card" aria-labelledby="fcm-cost-h">
      <h2 id="fcm-cost-h" class="fcm-h2">What a funeral costs and how much prices have risen</h2>
      <div class="fcm-est" data-fcm-est aria-live="polite"></div>
      <p class="fcm-note">
        The estimates are based on historical NFDA funeral pricing adjusted using actual BLS funeral inflation data.
        Cemetery costs, vault, marker and cash-advance items such as flowers and obituaries are not included.
      </p>
      <p>
        The U.S. Bureau of Labor Statistics tracks funeral prices in the Consumer Price Index. These increases are
        national; BLS does not publish a funeral price index for individual states.
      </p>
      <div class="fcm-hist" data-fcm-hist></div>
      <p class="fcm-note">
        Change in the BLS funeral expenses index (series CUUR0000SEGD) from the same month 5, 10, 15 and 20 years
        earlier to {cpiLabel}, the latest published month.
      </p>

      <h3 class="fcm-h3">Funeral cost calculator</h3>
      <p>
        The calculator starts from the estimate for the selected state. Funeral prices vary widely from one funeral home to the next, so for a closer figure ask a
        funeral home near you for its General Price List (the FTC Funeral Rule requires funeral homes to give you one),
        then enter its total for the type of funeral you want.
      </p>
      <div class="fcm-form">
        <label class="fcm-field">
          <span>Type of funeral</span>
          <select data-fcm-type>
            <option value="burial">Traditional burial with funeral service</option>
            <option value="cremation-service">Cremation with funeral service</option>
            <option value="direct-cremation">Direct cremation</option>
          </select>
        </label>
        <label class="fcm-field">
          <span>Today's price (estimate, or a funeral home's price)</span>
          <span class="fcm-money"><span aria-hidden="true">$</span><input type="text" inputmode="decimal" data-fcm-price placeholder="enter a price" aria-describedby="fcm-price-note" /></span>
        </label>
      </div>
      <p class="fcm-note" id="fcm-price-note" data-fcm-price-src></p>

      <div class="fcm-timeline" data-fcm-timeline hidden></div>

      <div class="fcm-form">
        <label class="fcm-field">
          <span>Look ahead</span>
          <select data-fcm-years>
            <option value="5">5 years</option>
            <option value="10" selected>10 years</option>
            <option value="15">15 years</option>
            <option value="20">20 years</option>
          </select>
        </label>
        <label class="fcm-field">
          <span>Yearly funeral price increase (%)</span>
          <input type="text" inputmode="decimal" data-fcm-rate aria-describedby="fcm-rate-note" />
        </label>
      </div>
      <p class="fcm-note" id="fcm-rate-note" data-fcm-rate-note></p>
      <div class="fcm-result" data-fcm-future aria-live="polite"></div>

      <h3 class="fcm-h3">Funding shortfall</h3>
      <div class="fcm-form">
        <label class="fcm-field">
          <span>Life insurance you already have</span>
          <span class="fcm-money"><span aria-hidden="true">$</span><input type="text" inputmode="decimal" data-fcm-ins placeholder="0" /></span>
        </label>
        <label class="fcm-field">
          <span>Money saved for the funeral</span>
          <span class="fcm-money"><span aria-hidden="true">$</span><input type="text" inputmode="decimal" data-fcm-sav placeholder="0" /></span>
        </label>
      </div>
      <div class="fcm-result" data-fcm-short aria-live="polite"></div>
      <p class="fcm-note">Projections are estimates, not guaranteed future prices.</p>
    </section>

    <section class="fcm-cta" aria-labelledby="fcm-cta-h">
      <h2 id="fcm-cta-h" class="fcm-h2">Cover the cost so your family doesn't have to</h2>
      <p>See burial insurance rates from several insurance companies in under a minute.</p>
      <a class="fcm-btn" href="/free-quote/">GET MY PERSONALIZED COVERAGE QUOTE</a>
      <p>Or call Funeral Funds at <a href={lead.phone.href}>{lead.phone.display}</a>.</p>
    </section>

    <section class="fcm-card" aria-labelledby="fcm-rights-h">
      <h2 id="fcm-rights-h" class="fcm-h2">Your rights when you buy a funeral</h2>
      <p>The Federal Trade Commission's Funeral Rule (16 CFR Part 453) applies to funeral homes nationwide. Under it, a funeral home must:</p>
      <ul>
        <li>give you accurate price information over the telephone when you ask (§ 453.2(b)(1));</li>
        <li>give you a written General Price List when you discuss arrangements in person (§ 453.2(b)(4));</li>
        <li>show you a casket price list before showing you caskets (§ 453.2(b)(2));</li>
        <li>not tell you embalming is required by law when it is not, and disclose that, except in certain special cases, embalming is not required by law (§ 453.3(a));</li>
        <li>not require a casket for a direct cremation, and offer an alternative container if it arranges direct cremations (§ 453.4(a));</li>
        <li>not make you buy one item as a condition of getting another, except where the law requires it (§ 453.4(b)).</li>
      </ul>
      <p>
        Read the rule at <a href="https://www.ecfr.gov/current/title-16/chapter-I/subchapter-D/part-453" rel="noopener">eCFR, 16 CFR Part 453</a>.
        States add their own rules for funeral homes, cemeteries and preneed contracts; your state's funeral or
        cemetery licensing board can tell you what applies where you live.
      </p>
    </section>

    <section class="fcm-card" aria-labelledby="fcm-region-h">
      <h2 id="fcm-region-h" class="fcm-h2">Estimated funeral cost by region</h2>
      <p class="fcm-note">
        NFDA 2023 median prices by census region (funeral with viewing; burial excludes vault and cemetery costs;
        cremation uses an alternative container and urn), and the same prices adjusted to {cpiLabel} with the BLS
        funeral index. Compared with the national median for the same package and year.
      </p>
      <div class="fcm-scroll" tabindex="0">
        <table class="fcm-table">
          <thead><tr><th scope="col">Region and states</th><th scope="col">Burial, 2023 median</th><th scope="col">Burial, estimated today</th><th scope="col">vs. national</th><th scope="col">Cremation, 2023 median</th><th scope="col">Cremation, estimated today</th><th scope="col">vs. national</th></tr></thead>
          <tbody>
            {nfda.regions.map((r) => (
              <tr><th scope="row">{r.name}<br /><span class="fcm-note">{r.states.join(', ')}</span></th><td>{money(r.burial2023)}</td><td>{money(r.burial2023 * cpiFactor)}</td><td>{vsNat(r.burial2023, nfda.national.burial2023)}</td><td>{money(r.cremation2023)}</td><td>{money(r.cremation2023 * cpiFactor)}</td><td>{vsNat(r.cremation2023, nfda.national.cremation2023)}</td></tr>
            ))}
            <tr><th scope="row">United States</th><td>{money(nfda.national.burial2023)}</td><td>{money(nfda.national.burial2023 * cpiFactor)}</td><td>national</td><td>{money(nfda.national.cremation2023)}</td><td>{money(nfda.national.cremation2023 * cpiFactor)}</td><td>national</td></tr>
          </tbody>
        </table>
      </div>
      <p class="fcm-note">District of Columbia is not listed in NFDA's regional table, so no estimate is shown for it.</p>
      <p class="fcm-note">
        Direct cremation (no viewing or ceremony):{" "}
        {Object.entries(directCremation.states).map(([st, d]) => 'n' in d
          ? `${st}, ${d.whenLabel}: ${d.kind} ${dcMoney(d.value)} of ${d.n} funeral homes (range ${money(d.low)} to ${money(d.high)}; ${d.source}).`
          : `${st}, ${d.year} ${d.kind}: ${money(d.value)} (range ${money(d.low)} to ${money(d.high)}; ${d.source}).`).join(' ')}
        No published figure is available for other states.
      </p>
    </section>

    <section class="fcm-card" aria-labelledby="fcm-states-h">
      <h2 id="fcm-states-h" class="fcm-h2">Death rates and leading cause by state</h2>
      <p class="fcm-note">Age-adjusted death rates per 100,000, {periodLabel} (provisional; for causes whose latest quarter is not yet published, the latest published 12 months). Deaths: {recent.deaths2022.year}, all causes (provisional).</p>
      <div class="fcm-scroll" tabindex="0">
        <table class="fcm-table">
          <thead><tr><th scope="col">State</th><th scope="col">Death rate, all causes</th><th scope="col">Highest-rate cause</th><th scope="col">Its death rate</th><th scope="col">Deaths, {recent.deaths2022.year}</th></tr></thead>
          <tbody>
            {tableRows.map((r) => (
              <tr><th scope="row">{r.name}</th><td>{r.rate ?? 'n/a'}</td><td>{r.top ?? 'n/a'}</td><td>{r.topRate ?? 'n/a'}</td><td>{r.deaths != null ? fmt(r.deaths) : 'n/a'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="fcm-card" aria-labelledby="fcm-method-h">
      <h2 id="fcm-method-h" class="fcm-h2">Sources and methodology</h2>
      <ul>
        <li>
          <strong>Funeral price increases:</strong> {cpi.source}, series {cpi.series} ({cpi.title}; {cpi.base}),
          monthly values retrieved {cpi.retrieved} from the BLS public API. Historical changes use the published index for
          the same month in each year, not an assumed inflation rate. {cpi.notes.join(' ')}
          <a href={cpi.sourceUrl} rel="noopener">BLS series {cpi.series}</a>.
        </li>
        <li>
          <strong>Future costs:</strong> today's price (the estimate for the selected state, or the price you enter) × (1 + yearly increase)<sup>years</sup>. The default yearly
          increase is the funeral index's average annual change over the last 20 years. You can change it.
        </li>
        <li>
          <strong>Funeral cost estimates:</strong> {nfda.source}: "{s2023.title}" ({s2023.date}; survey mailed
          {s2023.surveyMailed}, {s2023.respondents} member funeral homes), median prices for nine census regions and the
          nation. Each state uses its region's median, multiplied by the BLS funeral index for {cpiLabel} divided by
          July 2023 (factor {cpiFactor.toFixed(3)}). These are modeled planning estimates: NFDA did not measure
          individual states, and NFDA members may not represent every funeral home.
          Packages: {nfda.packages.burial} {nfda.packages.cremation}
          Direct cremation is not reported in NFDA's releases, so no direct cremation estimate is shown.
          <a href={s2023.url} rel="noopener">NFDA 2023 release</a>.
        </li>
        <li>
          <strong>Direct cremation:</strong> shown only for states with a funeral consumer organization price survey:
          Washington's published statewide average, and medians calculated here from the individual funeral-home prices
          that Funeral Consumers Alliance affiliates publish, using only prices that share one definition. Figures are
          not inflation-adjusted and are never combined across states; definitions and years differ by state.
          {Object.entries(directCremation.states).map(([st, d]) => 'n' in d
            ? `${st}: ${d.source}, ${d.whenLabel}, ${d.kind} ${dcMoney(d.value)} (${d.coverage}), range ${money(d.low)} to ${money(d.high)}. ${d.sample} ${d.definition}`
            : `${st}: ${d.source}, ${d.year} ${d.kind} ${money(d.value)}, range ${money(d.low)} to ${money(d.high)}. ${d.sample} ${d.definition}`).join(' ')}
          Not used: {directCremation.checked.map((c) => `${c.state} (${c.reason})`).join('; ')}. NFDA's releases do not report direct cremation.
        </li>
        <li>
          <strong>Check against 2021:</strong> NFDA's {s2021.date.slice(0, 4)} regional burial medians ("{s2021.title}"),
          adjusted to July 2023 with the same index (+{((cpi2123 - 1) * 100).toFixed(1)}%), came out 0% to 11% higher than
          the 2023 medians NFDA measured: from 2021 to 2023 the BLS funeral index rose faster than NFDA's national burial
          median (+5.8%). Adjusted estimates may therefore run high. NFDA's 2021 cremation figures used a cremation casket
          and are not comparable with 2023's. <a href={s2021.url} rel="noopener">NFDA 2021 release</a>.
        </li>

        <li>
          <strong>Recent death rates:</strong> {recent.source}, "{recent.dataset}", {periodLabel} and each earlier
          quarter back to {recent.quarters[0]}, retrieved {recent.retrieved}. Provisional figures can change.
          <a href={recent.sourceUrl} rel="noopener">CDC data</a>.
        </li>
        <li>
          <strong>Deaths by age and sex:</strong> CDC/NCHS, "{recent.deaths2022.dataset}", {recent.deaths2022.year},
          {recent.deaths2022.status}. {recent.deaths2022.note} <a href={recent.deaths2022.sourceUrl} rel="noopener">CDC data</a>.
        </li>
        <li>
          <strong>Final deaths by cause:</strong> {mortality.source}, "{mortality.dataset}" ({mortality.years[0]} to
          {mortality.years[1]}), retrieved {mortality.retrieved}. {mortality.scope}. {LATEST} is the latest year in this
          dataset. <a href={mortality.sourceUrl} rel="noopener">CDC data</a>.
        </li>
        <li><strong>Map:</strong> {paths.source}.</li>
      </ul>
      <p class="fcm-note">Last updated November 11, 2026.</p>
    </section>
  </div>
</BaseLayout>

<script>
  import '@/scripts/funeral-cost-map';
</script>

<!-- Global (fcm- prefixed): the script renders some of this markup. -->
<style is:global>
  .fcm { padding-block: var(--space-6); }
  .fcm h1 { margin-bottom: var(--space-2); }
  .fcm-lead { font-size: 1.125rem; max-width: 46rem; }
  .fcm-h2 { font-size: 1.375rem; margin: 0 0 var(--space-3); color: var(--color-primary); }
  .fcm-h3 { font-size: 1.125rem; margin: var(--space-6) 0 var(--space-2); }
