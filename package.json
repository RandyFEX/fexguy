{
  "name": "fexguy",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force && pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node scripts/check-dist.mjs",
    "health-search:data": "node scripts/health-search-data.mjs",
    "health-search:publish": "node scripts/health-search-publish.mjs",
    "health-search:import": "node scripts/health-search-import.mjs",
    "test:health-search": "node --test 'tests/health-search/*.test.js'",
    "test:health-search:live": "node tests/health-search/live-preview.mjs",
    "test:nav": "node tests/navigation/nav.browser.mjs",
    "test": "npm run test:health-search && npm run test:rates && npm run test:quote && npm run test:nav",
    "rates:extract": "node scripts/rates-extract.mjs",
    "rates:workbook": "node scripts/rates-workbook.mjs",
    "rates:publish": "node scripts/rates-publish.mjs",
    "test:rates": "node --test 'tests/rates/*.test.js'",
    "test:rates:live": "node tests/rates/live-preview.mjs",
    "test:quote": "node --test 'tests/quote/*.test.js'",
    "quote:evidence": "node scripts/quote-evidence.mjs",
    "test:quote:browser": "node tests/quote/funnel.browser.mjs && node tests/quote/funnel-temp-code.browser.mjs && node tests/quote/sidebar-entry.browser.mjs && node tests/quote/countdown.browser.mjs && node tests/quote/cta-fit.browser.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
