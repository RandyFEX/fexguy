# Search-engine indexing gate. Leave unset (or anything other than "true")
# everywhere except the real production deployment of FEXGUY.com. While it
# is off, every page carries <meta name="robots" content="noindex, nofollow">
# and /robots.txt disallows all crawlers — so a preview or staging copy of
# this site can never compete with (or replace) the live WordPress site in
# search results.
PUBLIC_ALLOW_INDEXING=false
